// ============================================================================
//  fcs.h —— FCS: Fractal Cluster Store（XDB v3 内核）
// ----------------------------------------------------------------------------
//  命题：**「树」只是「平衡」的一种派生形态**。v2 的 B+ 树把大量复杂度花在
//  「维持平衡」的副作用上：分隔键下推、父指针、级联分裂、根换位、回退时
//  整树重建、每页 COW。
//
//  FCS 直接维护平衡本身，于是树消失了。三个同构（分形）层次：
//
//     store ── 有序「单元表 directory」 ── 单元 cell = 键区间 + 段视图
//       run ── 有序「页表 fences」      ── 页 = 有序记录序列
//      page ── 有序记录（页内二分/线性）
//
//  关键点：**单元不拥有数据**。数据只存在于不可变的段（run）里；单元只是
//  「(段, 页区间)」的集合视图。因此
//      · 分裂单元 = 把页区间一分为二  → 零数据重写，O(#段)
//      · 合并单元 = 页区间取并        → 零数据重写，O(#段)
//  平衡变成目录上的局部操作，不再自底向上传播。
//
//  三条不变量（平衡的定义，与树无关）：
//    B1  单元物理字节 ≤ BMAX          —— 超了就在页边界切成两半
//    B2  单元段数 ≤ SMAX              —— 超了就压实成一个段
//    B3  每次提交的重写预算随垃圾产生速率自适应，0/1 背包按“净收益”分配
//
//  动态规划：把候选压实单元当作物品（成本 = 重写页数，收益 = 回收字节 +
//  减少段数），在预算内求最优子集 —— 压实时机不是启发式。
//
//  写：mem → **每提交 1 个有序段**（顺序写，与单元数无关）→ 清单增量页
//      → 4B 提交字。写放大 ≈ 1 + 记录头 + 压实摊销；无整页 COW。
//  读：目录二分 O(log C) → 段按版本**从新到旧**探测，命中即停 → 通常 1 页。
//  回退：快照 = {vers, tail, man_last, nman}；回退 = 指针回退 + 清单截断，
//        **O(1)**，零数据页重写（快照存活期间页不回收）。
// ============================================================================
#pragma once
#include "common.h"
#include "layout.h"
#include "blockdev.h"
#include <vector>
#include <memory>
#include <array>
#include <thread>
#include <mutex>
#include <shared_mutex>
#include <atomic>
#include <condition_variable>
#include <chrono>
#include <deque>
#include <set>
#include <map>
#include <algorithm>
#include <cstdio>
#include <cstring>

namespace fcs {

using namespace xdb;

// ---------------------------------------------------------------- 参数
enum : u32 {
    BMAX        = 32 * 1024,   // B1：单元物理字节上限
#ifndef FCS_SMAX
#define FCS_SMAX 512          // 段数软上限：布隆让读不再受段数影响，这里只防内存/CPU
#endif
#ifndef FCS_LVL_DIRTY_PCT
#define FCS_LVL_DIRTY_PCT 30  // 分层合并的垃圾门槛（百分比）：够了才值得重写
#endif
#ifndef FCS_GC_RATIO
#define FCS_GC_RATIO 2       // 压实“性价比”门槛：dead ≥ ratio × live 才重写
#endif
#ifndef FCS_RMETA_MIN_PAGES
#define FCS_RMETA_MIN_PAGES 16  // 小于这么多页的 run 不写元数据页（挂载时直接扫这几页）
#endif
    SMAX        = FCS_SMAX,    // B2：单元段数上限（读放大上界）
    MAX_SNAP    = 8,
    MAN_SNAP_AT = 64,          // 清单链页数上限 → 写全量清单
    SB_HDR     = 40,           // 超级块头（其后紧跟本次提交的内联增量）
    INLINE_MAX = 32,           // 单页可内联的增量条数上限
};

enum : u32 { PK_SB = 0x42534346u, PK_DATA = 0x44415441u, PK_MAN = 0x4D414E43u,
              PK_RMETA = 0x4154454Du };            // 'META'：run 元数据页（紧跟在该 run 数据页之后）
enum : u32 { COMMIT_WORD = 0xA55A5AA5u };
// 页号哨兵。以前是 0xFFFF —— 和设备上限 65535 页只差一页余量，纯属巧合才没撞上。
// 现在页号是 u32，哨兵用全 1，与任何合法页号都不重叠。
enum : u32 { NIL = 0xFFFFFFFFu, NIL32 = 0xFFFFFFFFu };
// sp 的打包格式：页号 << SP_SHIFT | 页内偏移。
// 以前偏移占 16 位（页号只有 16 位）；现在页号要 32 位了，偏移只要 12 位（PAGE=4096），
// 于是打包值能表示 2^20 页 = 4 GB 的 run。**这一步必须在放宽 PageId 之前做**，
// 否则 packed>>16 会把页号截断成 65536 的余数，扫描会静默跳错页。
static_assert(PAGE <= (1u << 12), "SP_SHIFT 要能装下页内偏移");
inline constexpr u32 SP_SHIFT = 12, SP_OFF_MASK = (1u << SP_SHIFT) - 1;
// sp 里存的是**run 内页号**，20 位 ⇒ 单条 run 最多 2^20 页 = 4 GB。
// 超过之后 sp 只是"不再新增条目"（它本来就是个提示），probe 会从最后一个条目线性往后扫，
// 还是对的，只是慢。见 DESIGN3 §9。
inline constexpr u32 SP_MAX_PAGES = 1u << (32 - SP_SHIFT);
inline u32 sp_pack(u32 page, u32 off) { return (page << SP_SHIFT) | (off & SP_OFF_MASK); }
inline u32 sp_page(u32 packed) { return packed >> SP_SHIFT; }
inline u32 sp_off(u32 packed) { return packed & SP_OFF_MASK; }
enum : u32 { DHDR = 40, MHDR = 16, MENT = 40, MAN_PER_PG = 102 };

// 键空间：最高位为 0 = 用户主键；为 1 = 二级索引条目。
// 索引键 = 1 | idx(7bit) | skey(56bit)，索引值 = 主键(8B)。
// 这样索引与主键活在同一个 store、同一次提交里 ⇒ 索引维护天然原子。
inline constexpr u64 IDX_BASE = 0x8000000000000000ull;
// 范围墓碑保留键空间（2^62 起）。用户 select 的上界会被夹到这里，
// 所以墓碑记录永远不会出现在用户扫描里。
inline constexpr u64 RT_BASE = 0x4000000000000000ull;
// 超过这个长度的值走溢出页。留足空间给页头/前缀/单页最大记录，
// 免得一条大记录把整页撑爆（单条必须能放进一页）。
inline constexpr u16 INLINE_VAL_MAX = 3000;
inline constexpr u64 SKEY_MAX = 0x00FFFFFFFFFFFFFFull;
inline constexpr u32 IDX_MAX  = 128;
inline u64 idx_enc(u32 idx, u64 skey) {
    return IDX_BASE | ((u64)(idx & 0x7Fu) << 56) | (skey & SKEY_MAX);
}

enum : u8 { M_RUN_ADD = 1, M_RUN_DEL = 2, M_SPLIT_ADD = 3, M_SPLIT_DEL = 4, M_SEG_DEL = 5,
             M_RANGE = 6 };   // 范围墓碑：key=lo last=hi ver=版本（只活在清单里，不占键空间）

// ---------------------------------------------------------------- 编解码
// 记录头 = 键 8B + 长度 2B（共 10B，2 字节对齐）。
//   · 版本不再逐条存：一条 run 只由一次提交（或一次压实）产生 ⇒ 版本是 run 的属性
//   · 逐条 CRC 取消：页 CRC 已覆盖 [12, used) 的全部记录字节，逐条校验是重复劳动
// 于是 16B 的头部瘦到 10B —— 小值场景的写放大直接降 ~20%。
// 溢出值：len 字段写 OVFL_MARK，值区变成 16 B 描述符 {pg0, npages, total, crc}。
// 这样**页内遍历/前缀压缩/合并全都不用改**（rec_size 仍然给出正确的页上字节数），
// 只有"真正取到值"的那几个入口需要多一步：把链读进缓冲。
enum : u16 { OVFL_MARK = 0xFFFFu };
inline constexpr u32 OV_HDR = 16;                  // 溢出页头：'OVFL'|next|off|len
inline constexpr u32 OV_CAP = PAGE - OV_HDR;       // 每页有效载荷
inline u32 rec_size(u16 len) {
    return 10u + (len == OVFL_MARK ? 16u : ((len + 1u) & ~1u));
}
inline u64 prog_us() {
    return (u64)std::chrono::duration_cast<std::chrono::microseconds>(
        std::chrono::steady_clock::now().time_since_epoch()).count();
}

// ---- 页内前缀编码（v3.1 记录格式） ----------------------------------------
// 页头字节 36 = pfx（本页首末键的公共“高位字节”数，0..7），字节 37 = fmt（1 = 启用）。
// 记录 = [键后缀 8-pfx B][len 2B][值]；键 = 页首键的高 pfx 字节 ‖ 后缀。
// 有序键（自增/时间戳）一页 100 条能共享 4~7 B/条；随机键 pfx=0，格式与旧版逐字节相同。
// 旧库不用迁移：旧页的 36/37 是 0（页缓冲零初始化）⇒ pfx=0、fmt=0 ⇒ 走原路径。
inline u8 pg_fmt(const u8* pg) { return pg[37]; }
inline u8 pg_pfx(const u8* pg) { return pg[37] ? (u8)(pg[36] & 7u) : 0u; }
inline u32 pg_rec_size(u8 pfx, u16 len) {
    return 2u + (len == OVFL_MARK ? 16u : ((len + 1u) & ~1u)) + 8u - pfx;
}
inline u64 pg_key_at(const u8* pg, u32 off) {
    u8 pfx = pg_pfx(pg);
    if (!pfx) { u64 k; std::memcpy(&k, pg + off, 8); return k; }
    u8 w = (u8)(8u - pfx);
    u64 lo = 0, hi;
    std::memcpy(&lo, pg + off, w);             // 低 w 字节是键后缀（小端）
    std::memcpy(&hi, pg + 16, 8);              // 高位来自页首键
    return lo | (hi & (~0ull << (8u * w)));
}
inline const u8* pg_val_at(const u8* pg, u32 off) { return pg + off + 2u + (8u - pg_pfx(pg)); }

struct RecHdr { u64 key; u16 len; };
inline void rd_rec(const u8* pg, u32 off, RecHdr& h) {
    u8 pfx = pg_pfx(pg), w = (u8)(8u - pfx);
    std::memcpy(&h.len, pg + off + w, 2);
    if (!pfx) { std::memcpy(&h.key, pg + off, 8); return; }
    u64 lo = 0, hi;
    std::memcpy(&lo, pg + off, w);
    std::memcpy(&hi, pg + 16, 8);
    h.key = lo | (hi & (~0ull << (8u * w)));
}
// ------------------------------------------------------------ 内存表
// 以前是 std::map<u64, Rec{u32 ver; std::vector<u8> val; bool ovfl}>：每条记录两次堆分配
//（树节点 + 值向量）、一次 O(log n) 比较树下降，200k 条实测 0.51 µs/条；
// 而内存表的全部需求只有：点查、覆盖写、按键序吐出一次、整体清空。
// 现在：条目数组 + 开放寻址哈希（存下标）+ 一块连续值区；flush 时对 (key, idx) 排一次序。
// 条目 24 B、槽 4 B（装载 ≤ 1/2）、值按原长紧挨着放 ⇒ 没有逐条分配，清空就是三个 clear。
// 覆盖写：新值不长于旧值就原地改，否则追加到值区末尾（旧字节成垃圾；垃圾过半且 > 1 MB 时重整一次）。
class MemTable {
public:
    struct Ent {
        u64 key = 0;
        u32 ver = 0;
        u32 off = 0;          // 值在 blob_ 里的偏移
        u16 len = 0;          // 0 = 墓碑；溢出值 = 16（描述符）
        bool ovfl = false;    // 大值：值区里是 16 B 溢出描述符（真值在溢出页链里）
    };
    size_t size() const { return ents_.size(); }
    bool empty() const { return ents_.empty(); }
    const std::vector<Ent>& entries() const { return ents_; }
    Ent& ent(u32 i) { ++gen_; return ents_[i]; }     // 可写访问（调用方要改它）⇒ 视作一次变更
    u64 gen() const { return gen_; }                  // 每次变更递增：游标据此判断键序视图是否过期
    u64 epoch() const { return epoch_; }              // 每次 clear 递增：条目下标在同一 epoch 内只追加不变动
    void clear() {
        ++gen_; ++epoch_;
        ents_.clear(); blob_.clear(); garbage_ = 0;
        // 槽表按需缩回：一批 200k 之后全是 2k 的小批，不该每次都清 1 MB 的槽
        if (slots_.size() > 4096 && ents_.capacity() < slots_.size() / 8) { slots_.assign(1024, 0); return; }
        std::fill(slots_.begin(), slots_.end(), 0u);
    }
    const Ent* find(u64 key) const {
        if (ents_.empty()) return nullptr;
        const u32 mask = (u32)slots_.size() - 1;
        for (u32 i = hslot(key); ; i = (i + 1) & mask) {
            u32 s = slots_[i];
            if (!s) return nullptr;
            if (ents_[s - 1].key == key) return &ents_[s - 1];
        }
    }
    const u8* val(const Ent& e) const { return blob_.data() + e.off; }
    // 取（或建）键的条目；existed 告诉调用方是不是覆盖写
    Ent& upsert(u64 key, bool& existed) {
        if (slots_.empty()) slots_.assign(1024, 0);
        if ((ents_.size() + 1) * 2 > slots_.size()) rehash(slots_.size() * 2);
        const u32 mask = (u32)slots_.size() - 1;
        u32 i = hslot(key);
        for (;; i = (i + 1) & mask) {
            u32 s = slots_[i];
            if (!s) break;
            if (ents_[s - 1].key == key) { existed = true; return ents_[s - 1]; }
        }
        existed = false;
        ++gen_;
        ents_.push_back(Ent{});
        ents_.back().key = key;
        slots_[i] = (u32)ents_.size();
        return ents_.back();
    }
    // 设值：原地覆盖 / 追加。len == 0 ⇒ 墓碑（不占值区）
    void set_val(Ent& e, const u8* p, u16 len, bool ovfl) {
        ++gen_;
        if (len <= e.len) {
            garbage_ += e.len - len;
            if (len) std::memcpy(blob_.data() + e.off, p, len);
        } else {
            garbage_ += e.len;
            e.off = (u32)blob_.size();
            blob_.insert(blob_.end(), p, p + len);
        }
        e.len = len; e.ovfl = ovfl;
        if (garbage_ > (1u << 20) && garbage_ * 2 > blob_.size()) compact();
    }
    // 键序下标（flush 用；一次排序代替树的逐条比较）
    void sorted(std::vector<u32>& ord) const {
        std::vector<std::pair<u64, u32>> kv;
        kv.reserve(ents_.size());
        for (u32 i = 0; i < ents_.size(); ++i) kv.emplace_back(ents_[i].key, i);
        std::sort(kv.begin(), kv.end());
        ord.resize(kv.size());
        for (size_t i = 0; i < kv.size(); ++i) ord[i] = kv[i].second;
    }
    const Ent& at(u32 i) const { return ents_[i]; }
    u64 blob_bytes() const { return blob_.size(); }
private:
    u32 hslot(u64 key) const { return (u32)((key * 0x9E3779B97F4A7C15ull) >> 32) & ((u32)slots_.size() - 1); }
    void rehash(size_t n) {
        slots_.assign(n, 0);
        const u32 mask = (u32)n - 1;
        for (u32 k = 0; k < ents_.size(); ++k) {
            u32 i = hslot(ents_[k].key);
            while (slots_[i]) i = (i + 1) & mask;
            slots_[i] = k + 1;
        }
    }
    void compact() {
        ++gen_;
        std::vector<u8> nb;
        nb.reserve(blob_.size() - garbage_);
        for (auto& e : ents_) {
            u32 off = (u32)nb.size();
            nb.insert(nb.end(), blob_.data() + e.off, blob_.data() + e.off + e.len);
            e.off = off;
        }
        blob_.swap(nb);
        garbage_ = 0;
    }
    std::vector<Ent> ents_;
    std::vector<u32> slots_;     // 2 的幂；存 ents_ 下标 + 1（0 = 空）
    std::vector<u8> blob_;
    u64 garbage_ = 0;
    u64 gen_ = 1, epoch_ = 1;
};

// 数据页头 40B：0 kind | 4 next(不参与 CRC) | 8 chk | 12 ver
//                 16 first_key | 24 last_key | 32 nrec:u16 | 34 used:u16
inline void put_pg_hdr(u8* p, u32 ver, u64 first, u64 last, u16 nrec, u16 used, u8 pfx = 0) {
    wr32(p + 0, PK_DATA);
    wr32(p + 4, NIL);
    wr32(p + 12, ver);
    std::memcpy(p + 16, &first, 8);
    std::memcpy(p + 24, &last, 8);
    wr16(p + 32, nrec);
    wr16(p + 34, used);
    p[36] = pfx & 7u; p[37] = 1; p[38] = 0; p[39] = 0;   // 页内前缀长度 + 格式位
    wr32(p + 8, crc32c(p + 12, (size_t)(used - 12)));
}

// ---------------------------------------------------------------- 布隆过滤器
//   每条段一个：把「这次查找要不要碰这个段」从 O(#段) 页读降成一次位测试。
//   10 bit/key ⇒ 假阳性 ~1%，内存 1.25 B/key。
struct Bloom {
    // 每键 16 bit、4 个探测位：误判率 ≈ 0.24%。
    // 读路径的代价 ≈ 1 页 + 段数 × 误判率，所以“段多”几乎不影响页读次数，
    // 这也是敢把 SMAX 放大的底气 —— 用一点点 RAM 换掉大量压实写。
    std::vector<u64> w;
    u32 bits = 0, nk = 0;

    void reset(u32 nkeys) {
        nk = 0;
        bits = (nkeys < 8 ? 8 : nkeys) * 16;
        w.assign(bits / 64 + 1, 0);
    }
    static void pos(u64 h, u32 bits, u32& a, u32& b, u32& c, u32& d) {
        a = (u32)(h % bits);
        b = (u32)((h >> 16) % bits);
        c = (u32)((h >> 32) % bits);
        d = (u32)((h >> 48) % bits);
    }
    void add(u64 h) {
        if (!bits) reset(8);
        u32 a, b, c, d;
        pos(h, bits, a, b, c, d);
        w[a >> 6] |= 1ull << (a & 63);
        w[b >> 6] |= 1ull << (b & 63);
        w[c >> 6] |= 1ull << (c & 63);
        w[d >> 6] |= 1ull << (d & 63);
        ++nk;
    }
    bool may(u64 h) const {
        if (!bits) return true;
        u32 a, b, c, d;
        pos(h, bits, a, b, c, d);
        return ((w[a >> 6] >> (a & 63)) & 1u) &&
               ((w[b >> 6] >> (b & 63)) & 1u) &&
               ((w[c >> 6] >> (c & 63)) & 1u) &&
               ((w[d >> 6] >> (d & 63)) & 1u);
    }
};

inline u64 khash(u64 k) {                       // 记录级哈希（布隆用）
    k ^= k >> 33; k *= 0xff51afd7ed558ccdull;
    k ^= k >> 33; k *= 0xc4ceb9fe1a85ec53ull;
    k ^= k >> 33;
    return k;
}

// ---------------------------------------------------------------- 段 / 单元
// 稀疏块：每 SP 条记录一个「块」，记录块内首/末键 + 起始位置。
// 首末键让我们能在**不读页**的情况下证明「这个 run 在 [lo,hi) 里根本没有键」——
// 窄区间扫描的跳跃就靠它（随机键空间里，块与块之间的空洞很大）。
struct SpEnt {
    u64 first = 0, last = 0;
    u32 packed = 0;              // 页号 << SP_SHIFT | 页内偏移（见 sp_pack）
};

struct Run {
    u32 page0 = 0, npages = 0;
    u32 mnpg = 0;                 // 紧随其后的元数据页数（fences/pbytes/sp/bloom 的持久化副本）
    u32 mpage = 0;                // meta 页起始（0 = 没有）；挂载时先记账，真要用才读
    u32 novfl = 0;                // 本 run 里溢出值的条数（>0 才需要在释放/重建空闲表时扫链）
    // 本 run **自有**的溢出链（会随这条 run 一起释放）。
    // 归并时"原样接管"的链记在 ovfl_ref 里：它不是我们的，摘链时不能释放。
    std::vector<std::pair<u32, u32>> own_chains;
    std::vector<std::pair<u32, u32>> ovfl_ref;     // 接管来的链（释放时不还）
    u32 aux_pg = NIL, aux_npg = 0;                 // 溢出链清单页（`'AOVL'`），nrec_ovfl > 0 时有
    // 页上每条溢出记录的 (数据页, 描述符偏移)。纯 RAM，封页时由 RunWriter 抄过来；
    // 有它才能"零读接管"链（归并时不用把大值读出来再写一遍）。
    std::vector<std::pair<u32, u32>> ovfl_loc;    // 页上的描述符位置 (数据页, 记录偏移)
    bool loc_ready = false;                      // ovfl_loc 已经建立过（**空表也算数**）
    // 0 = 就绪，1 = 待装，2 = 正在装（P1：共享模式下多个读者可能同时第一次碰到这条 run）
    std::atomic<u8> meta_pending{0};
    u64 first = 0, last = 0;
    u32 ver = 0, seq = 0, refs = 0, nbytes = 0, nrec = 0;   // seq：全局单调，用于“新→旧”顺序
    u32 lvl = 0;                  // 层号：0 = 刚刷盘；分层合并后上升
    // 运行级存活账：该 run 里“仍是某键最新副本”的记录数/字节数。
    // 归零 ⇒ 整个 run 全是垃圾，可直接摘链释放（零写回收）。
    u64 live_bytes = 0;
    u32 live_recs = 0;
    // R6-lite：挂载时不算存活账 ⇒ live_bytes 先按 nbytes（全活，保守）；惰性补算（recount_sweep）期间把各单元的
    // 赢家字节累进 lb_acc，全部单元补算完再一次性换成精确值（层合并的脏度判断从此"照常"）。
    bool lb_unknown = false;
    u64 lb_acc = 0;
    std::vector<u64> fences;      // 每页首键
    std::vector<u32> pbytes;      // 每页有效字节
    // pbytes 的前缀和（npages+1 项）。recount 要算「本单元这些页里一共有多少记录字节」，
    // 有了它整页区间是 O(1)，只有单元边界落在的那一两页才需要真去解码。
    std::vector<u64> pcum;
    std::vector<u16> pnrec;       // 每页记录条数（页头 +32 处就有，抄一份省一次读页）
    std::vector<u32> pncum;       // pnrec 的前缀和（单选段单元的 live_recs 靠它 O(1) 算）
    // 稀疏记录索引：每 SP 条记录存 (键, 页<<16|页内偏移)，用于把“定位到某键”
    // 从“页内线性 ≤nrec 步”降到“二分 + ≤SP 步”。纯 RAM，挂载时重建。
    std::vector<SpEnt> sp;
    // 可选：该 run 的全部键（8 B/键）。打开后区间扫描可以**精确**判断
    // “这条 run 在 [lo,hi) 里有没有键”，窄区间扫描只碰真正命中的页。
    std::vector<u64> kidx;
    u32 nrec_idx = 0;             // 仅用于重建 sp 的计数
    Bloom bloom;                  // 键存在性预判（读放大 ≈ 1 页）
};
using RunPtr = Run*;

// 段 = (run, 页区间, 键域)。键域让“一个页被相邻单元共享”变得安全：
// 每段只为该单元自己那一截键负责，页里邻居的记录既不计入也不可读。
// live：本单元内由该段胜出的记录数。run->live_recs == 它在所有单元里的 live 之和，
// 因此 run 级存活账和“逐单元归并”的口径永远一致（跨单元、压实产物同 seq 都对得上）。
struct Seg {
    u32 rid = 0, p0 = 0, p1 = 0; u64 klo = 0, khi = ~0ull; u32 live = 0;
    u8 unk = 0;                                    // R6-lite（第 12 轮）：存活数未知（live 里是占位 1 条，保证 run 不被当成全死）
    // C2（第 12 轮）：seg_totals 的 memo —— (run, 单元键域) 决定的常量；键域对不上（单元切分后复制过来的段）就重算
    mutable u64 tlo = 1, thi = 0; mutable u64 tb = 0; mutable u32 tn = 0;
};

// C1（第 12 轮）：单元的段表从 std::map 换成**有序 vector**。一个单元通常只有 1 ~ 8 段，map 每段一个堆结点
//（结点 ≈ 48 B 开销 + 三次指针跳转）在 split_pass 候选扫描 / total_rec_bytes / recount / get 的 rbegin 遍历里是纯浪费。
// 接口保持 std::map 的子集（find/count/erase/emplace_hint/operator[]/lower_bound/begin/end/rbegin/rend/size/empty/swap/clear），
// 调用点一行不改。与 map 的**唯一语义差别**：往同一个单元插入/删除段会让该单元其它段的迭代器和 Seg& 失效——
// 现有调用点都是"先 find 再改/删，不跨插入持引用"（审计见 docs/DISCUSS12.md C1）；新代码别在持 Seg& 期间往同一单元插段。
class SegMap {
public:
    using value_type = std::pair<u64, Seg>;
    using Vec = std::vector<value_type>;
    using iterator = Vec::iterator;
    using const_iterator = Vec::const_iterator;
    using reverse_iterator = Vec::reverse_iterator;
    using const_reverse_iterator = Vec::const_reverse_iterator;
    iterator begin() { return v_.begin(); }
    iterator end() { return v_.end(); }
    const_iterator begin() const { return v_.begin(); }
    const_iterator end() const { return v_.end(); }
    reverse_iterator rbegin() { return v_.rbegin(); }
    reverse_iterator rend() { return v_.rend(); }
    const_reverse_iterator rbegin() const { return v_.rbegin(); }
    const_reverse_iterator rend() const { return v_.rend(); }
    size_t size() const { return v_.size(); }
    bool empty() const { return v_.empty(); }
    void clear() { v_.clear(); }
    void swap(SegMap& o) { v_.swap(o.v_); }
    iterator lower_bound(u64 k) { return std::lower_bound(v_.begin(), v_.end(), k, [](const value_type& a, u64 b) { return a.first < b; }); }
    const_iterator lower_bound(u64 k) const { return std::lower_bound(v_.begin(), v_.end(), k, [](const value_type& a, u64 b) { return a.first < b; }); }
    iterator find(u64 k) { auto it = lower_bound(k); return it != v_.end() && it->first == k ? it : v_.end(); }
    const_iterator find(u64 k) const { auto it = lower_bound(k); return it != v_.end() && it->first == k ? it : v_.end(); }
    size_t count(u64 k) const { return find(k) != v_.end() ? 1 : 0; }
    Seg& operator[](u64 k) {
        auto it = lower_bound(k);
        if (it == v_.end() || it->first != k) it = v_.insert(it, value_type(k, Seg{}));
        return it->second;
    }
    // 与 std::map::emplace_hint 同语义：键已存在则**不覆盖**、返回已有项；提示迭代器只是提示（这里忽略，二分定位）
    iterator emplace_hint(const_iterator, u64 k, Seg sg) {
        auto it = lower_bound(k);
        if (it != v_.end() && it->first == k) return it;
        return v_.insert(it, value_type(k, std::move(sg)));
    }
    iterator erase(const_iterator it) { return v_.erase(it); }
    size_t erase(u64 k) { auto it = find(k); if (it == v_.end()) return 0; v_.erase(it); return 1; }
private:
    Vec v_;
};

struct Cell {
    u64 lo = 0, hi = ~0ull;
    // 键 = (段版本 << 32 | run_id)：rbegin() 即“最新段”，读取可命中最新的那份
    SegMap segs;
    u64 pages = 0;                             // 段视图覆盖页数
    u64 live = 0;                              // 存活记录字节（精确；acct=false 时无意义）
    u64 dead = 0;                              // 垃圾记录字节（精确；acct=false 时无意义）
    bool acct = true;                          // R6-lite（第 12 轮）：存活账是否已算（挂载后惰性补算）
    bool lb_added = false;                     // 本单元的赢家字节是否已经累进过"挂载前 run"的 lb_acc（避免重复累加）
    u64 bytes() const { return live + dead; }
};

inline u64 seg_key(u32 seq, u32 rid) { return ((u64)seq << 32) | rid; }

struct Report {
    u32 cells = 0, runs = 0, recs = 0, segs = 0, ovfl = 0;
    u64 ovfl_pages = 0;        // 溢出链占的物理页（不在任何 run 的 [page0,page0+npages) 里）
    u64 bytes = 0, live = 0, pages = 0;
    u32 errors = 0;
    const char* first_err = "";
    u64 first_key = 0;
};

// ---------------------------------------------------------------- 线程槽 / 读写锁（P1 读扩展性）
// 每个线程在进程范围内领一个槽号（0..MAX_TLS-1），线程退出时归还。Store 按槽号保存该线程的私有状态：
// 风险指针（正在使用的页缓存槽）、共享锁深度、每线程计数器、私有页缓冲 / 溢出链暂存。
// 领不到槽（同时活着的线程 > MAX_TLS）的线程仍然可用：读也走独占锁，用第 MAX_TLS 号"公共槽"。
static constexpr u32 MAX_TLS = 32;
struct TlsIdPool {
    std::mutex mu;
    u32 free_[MAX_TLS];
    u32 nfree;
    std::atomic<u32> hwm{0};         // 用过的最大槽号 + 1：扫风险指针只扫到这里（2 个线程就扫 2 格，不扫 32 格）
    TlsIdPool() : nfree(MAX_TLS) { for (u32 i = 0; i < MAX_TLS; ++i) free_[i] = MAX_TLS - 1 - i; }   // 先发小号
    static TlsIdPool& inst() { static TlsIdPool p; return p; }
    u32 acquire() {
        std::lock_guard<std::mutex> g(mu);
        if (!nfree) return MAX_TLS;
        const u32 id = free_[--nfree];
        if (id + 1 > hwm.load(std::memory_order_relaxed)) hwm.store(id + 1, std::memory_order_release);
        return id;
    }
    void release(u32 id) { if (id >= MAX_TLS) return; std::lock_guard<std::mutex> g(mu); free_[nfree++] = id; }
};
struct TlsId {
    u32 id;
    TlsId() : id(TlsIdPool::inst().acquire()) {}
    ~TlsId() { TlsIdPool::inst().release(id); }
};
inline u32 tls_id() { static thread_local TlsId t; return t.id; }

// 写侧可重入独占 + 读侧共享，**写者优先**。独占持有者线程再进任何入口（读或写）都是空操作。
// 坑 86（g7 `3 6000 4` 实抓，4 读者 2 核跑 15 分钟不结束）：std::shared_mutex 在 glibc 上是读者优先的 rwlock，
// 读者只要前赴后继地 lock_shared，写者可以**永远**拿不到锁 —— 2 读者时碰巧能插进去，4 读者就饿死。
// 自己写：有写者在等（wwait_ > 0）时新读者退让；最后一个读者出门叫醒写者；写者出门叫醒所有人。
class XLock {
public:
    void lock() {
        const auto me = std::this_thread::get_id();
        if (owner_.load(std::memory_order_relaxed) == me) { ++depth_; return; }
        // 让一手：有读者还在睡（上一个写者刚走、它们没来得及醒），先等它们拿到共享锁再举牌，**有上界**。
        // 否则写者连续插队（每次 unlock → notify → 读者醒来 50 µs 内写者又 lock 了）会把读者饿死：
        // g7 的写者满负荷时读者 10 s 只做了 314 次 get。代价：有读者等着时每次写入口多 ≤200 µs。
        if (rwait_.load(std::memory_order_seq_cst) > 0) {
            std::unique_lock<std::mutex> lk(mu_);
            cv_.wait_for(lk, std::chrono::microseconds(200), [&] { return rwait_.load(std::memory_order_seq_cst) == 0; });
        }
        wwait_.fetch_add(1, std::memory_order_seq_cst);        // 先举牌（与读者的 st_ 写 / wwait_ 读构成 Dekker 配对）
        int e = 0;
        if (!st_.compare_exchange_strong(e, -1, std::memory_order_seq_cst)) {
            std::unique_lock<std::mutex> lk(mu_);
            cv_.wait(lk, [&] { int x = 0; return st_.compare_exchange_strong(x, -1, std::memory_order_seq_cst); });
        }
        wwait_.fetch_sub(1, std::memory_order_seq_cst);
        owner_.store(me, std::memory_order_relaxed);
        depth_ = 1;
    }
    void unlock() {
        if (--depth_ != 0) return;
        owner_.store(std::thread::id(), std::memory_order_relaxed);
        { std::lock_guard<std::mutex> lk(mu_); st_.store(0, std::memory_order_seq_cst); }   // 在 mu_ 内改：不丢唤醒
        cv_.notify_all();
    }
    bool held_by_me() const { return owner_.load(std::memory_order_relaxed) == std::this_thread::get_id(); }
    void lock_shared() {
        bool slept = false;
        for (unsigned spins = 0;; ++spins) {
            if (wwait_.load(std::memory_order_seq_cst) == 0) {
                int x = st_.load(std::memory_order_relaxed);
                if (x >= 0 && st_.compare_exchange_weak(x, x + 1, std::memory_order_seq_cst)) {
                    if (slept && rwait_.fetch_sub(1, std::memory_order_seq_cst) == 1) {   // 最后一个睡过的读者进来了：放写者举牌
                        std::lock_guard<std::mutex> g(mu_);
                        cv_.notify_all();
                    }
                    return;
                }
                continue;                                       // 和别的读者撞了：直接重试
            }
            if (spins < 64) { std::this_thread::yield(); continue; }
            std::unique_lock<std::mutex> lk(mu_);
            if (!slept) { slept = true; rwait_.fetch_add(1, std::memory_order_seq_cst); }
            cv_.wait(lk, [&] { return wwait_.load(std::memory_order_seq_cst) == 0 && st_.load(std::memory_order_seq_cst) >= 0; });
            spins = 0;
        }
    }
    void unlock_shared() {
        if (st_.fetch_sub(1, std::memory_order_seq_cst) == 1 && wwait_.load(std::memory_order_seq_cst) != 0) {
            std::lock_guard<std::mutex> lk(mu_);                // 配合写者在 mu_ 内评估谓词：不丢唤醒
            cv_.notify_all();
        }
    }
private:
    std::mutex mu_;
    std::condition_variable cv_;
    std::atomic<int> st_{0};         // >0 读者数；-1 写者；0 空闲
    std::atomic<unsigned> wwait_{0}; // 正在等/正在拿的写者数
    std::atomic<unsigned> rwait_{0}; // 睡过一觉、还没拿到共享锁的读者数（写者让手的依据）
    std::atomic<std::thread::id> owner_{};
    u32 depth_ = 0;
};

// ============================================================================
class Store {
public:
    // ------------------------------------------------------------ 线程私有状态（P1）
    enum { C_HITS, C_MISSES, C_GETS, C_PROBES, C_BLOOM, C_SEGS, C_SPSKIP, C_CUR, NCTR };
    struct alignas(64) Tls {
        std::atomic<u32> pin{NIL};       // 风险指针：本线程上一次 page() 返回的指针所在的缓存槽（NIL = 无）
        u32 sdepth = 0;                  // 本线程在本 Store 上的共享锁深度
        u64 ctr[NCTR] = {};              // 每线程计数器（统计口径 = 各槽求和）
        std::vector<u8> pgbuf;           // 私有页缓冲：组内两路都被别的读者钉住时的退路
        std::vector<u8> ovfl_buf;        // read_ovfl 的暂存区（以前是 Store 共享的一份）
    };
    Tls& tls() { const u32 id = tls_id(); return tls_[id < MAX_TLS ? id : MAX_TLS]; }
    u64 ctr_sum(u32 k) const { u64 t = 0; for (u32 i = 0; i <= MAX_TLS; ++i) t += tls_[i].ctr[k]; return t; }
    // 写入口：独占（可重入）
    struct WGuard {
        Store* s;
        bool busy = false;               // 本线程正持共享锁（select 回调里写）：不能升级，入口返回 BUSY
        explicit WGuard(Store* st) : s(st) {
            if (!s->xl_.held_by_me() && s->tls().sdepth > 0) { busy = true; return; }
            s->xl_.lock();
        }
        ~WGuard() { if (!busy) s->xl_.unlock(); }
    };
    // 读入口：持独占的本线程 ⇒ 空操作；本线程已持共享 ⇒ 深度 +1；
    // 关闭共享读 / 账脏（要重建）/ 没领到线程槽 ⇒ 退化为独占。
    struct RGuard {
        Store* s;
        int mode;                        // 0 = 空操作，1 = 共享，2 = 独占
        explicit RGuard(Store* st) : s(st), mode(0) {
            if (s->xl_.held_by_me()) return;
            Tls& t = s->tls();
            if (t.sdepth > 0) { ++t.sdepth; mode = 1; return; }
            if (!s->shared_reads_ || s->dirty_ || tls_id() >= MAX_TLS) { s->xl_.lock(); mode = 2; return; }
            s->xl_.lock_shared();
            if (s->dirty_) { s->xl_.unlock_shared(); s->xl_.lock(); mode = 2; return; }   // 窗口里变脏了
            t.sdepth = 1; mode = 1;
        }
        ~RGuard() {
            if (mode == 1) {
                Tls& t = s->tls();
                if (--t.sdepth == 0) { t.pin.store(NIL, std::memory_order_release); s->xl_.unlock_shared(); }
            } else if (mode == 2) s->xl_.unlock();
        }
    };
    // 共享读模式：get/select/scan 走共享锁，可与其它读者并行；写与维护仍独占。
    // 约束：开启后**不要在 select/scan 回调里写**（同一线程持共享再要独占 ⇒ 写入口返回 BUSY，不会死锁）。
    void set_shared_reads(bool on) { WGuard g(this); if (!g.busy) shared_reads_ = on; }
    bool shared_reads() const { return shared_reads_; }

    // ------------------------------------------------------------ 段游标
    struct Cur {
        RunPtr r = nullptr;
        std::array<u8, PAGE> buf{};        // 固定页缓冲：扫描期间零分配
        u32 p0 = 0, p1 = 0, pi = 0, off = DHDR;
        u64 klo = 0, khi = ~0ull;
        u8 pfx = 0;                        // 当前页的页内前缀长度
        bool done = false;
        bool pf_ = false;              // 是否做顺序预取（只有 open() 打开的游标才开）
        static constexpr u32 PF = 8;   // 预取窗口（页）

        // 走页缓存（与点查共用同一份热页），扫描才不会绕过缓存直捣设备
        bool load(Store* s, u64 from = 0) {
            if (!r || p0 >= p1) { done = true; return false; }
            pi = p0; off = DHDR;
            if (from > r->first && !r->sp.empty()) {         // 二分到最近的稀疏点
                auto it = std::upper_bound(r->sp.begin(), r->sp.end(), from,
                    [](u64 v, const SpEnt& e) { return v < e.first; });
                if (it != r->sp.begin()) {
                    --it;
                    u32 p = sp_page(it->packed), o = sp_off(it->packed);
                    if (p >= p0 && p < p1 && o >= DHDR) { pi = p; off = o; }
                }
            }
            return fill(s);
        }
        bool fill(Store* s) {          // 注意：保留 off（定位到页内某条记录时用得上）
            const u8* p = s->page((PageId)(r->page0 + pi));
            if (!p) { done = true; return false; }
            std::memcpy(buf.data(), p, PAGE);
            pfx = pg_pfx(buf.data());
            // 顺序扫描的预取：扫到第 i 页时，把同一条 run 的 i+1..i+PF 先读进来。
            // 只在"单游标顺序扫"的场合开（open() 里置位）；k 路归并同时开预取会互相踢缓存。
            if (pf_ && pi + 1 < p1) s->prefetch(r->page0 + pi + 1, std::min<u32>(PF, p1 - pi - 1));
            return fixup(s);
        }
        bool fixup(Store* s) {
            for (;;) {
                if (done) return false;
                u16 used = rd16(buf.data() + 34);
                if (used >= DHDR && used <= PAGE && off + pg_rec_size(pfx, 0) <= used) {
                    RecHdr h;
                    rd_rec(buf.data(), off, h);
                    if (off + pg_rec_size(pfx, h.len) <= used) return true;
                }
                if (++pi >= p1) { done = true; return false; }
                // 下一页的首键已经越过本段键域 ⇒ 不必把它读进来（fence 在内存里）
                if (pi < r->fences.size() && r->fences[pi] >= khi) { done = true; return false; }
                off = DHDR;
                if (!fill(s)) return false;
            }
        }
        bool advance(Store* s, u16 len) { off += pg_rec_size(pfx, len); return fixup(s); }
        void hdr(RecHdr& h) const { rd_rec(buf.data(), off, h); }
        // 溢出值时把链读进 vb，返回 vb.data()。vb 是 **可变** 的：
        // 调用方必须在下一次 next() 之前用完（与 pg_val_at 的指针契约一致）。
        // cacheable=false：归并/压实物化大值是一遍过的，别让它碰链缓存（连准入 ghost 表也别碰，
        // 否则合并刚读过的 2000 条链会让随后一遍冷扫描有 40% 被"误认为第二次"而收进缓存）。
        const u8* val(Store* s, u16 len, bool cacheable = true) {
            const u8* p = pg_val_at(buf.data(), off);
            if (len != OVFL_MARK) return p;
            OvflDesc d = desc_of(p);
            vb.resize(d.total ? d.total : 1);
            if (s->read_ovfl(d, vb.data(), (u32)vb.size(), nullptr, cacheable) != RC::OK) return nullptr;
            return vb.data();
        }
        const u8* val() const { return pg_val_at(buf.data(), off); }
        u32 osz(u16 len) const { return pg_rec_size(pfx, len); }   // 本页上的实际占用
        std::vector<u8> vb;                // 溢出值物化缓冲（只有大值才非空）
    };


    // ------------------------------------------------------------ 异步写
    // 「页写」交给后台线程，"元数据 / 决策 / 归并"留在前台单线程里。
    // 这样提交点之前的 CPU 工作（压实的 DP、分层合并的归并）可以和上一批页写重叠。
    // 读路径若碰到正在写的页，会在 page() 里等它落地 —— 正确性不依赖时序。
    struct IoJob {
        u32 pid = 0;
        u32 n = 1;                                  // 连续页数（>1 ⇒ 用 buf+off，整页写）
        std::vector<u8> img;                        // 单页作业：页镜像（只含用到的字节）
        std::shared_ptr<std::vector<u8>> buf;       // 多页作业：共享的整块缓冲（B4，零拷贝）
        size_t off = 0;
        RC run(BlockDev* d) const {
            if (buf) return d->write_multi((PageId)pid, n, buf->data() + off);
            return d->write((PageId)pid, 0, img.data(), (u32)img.size());
        }
    };
    void set_async_writes(bool on) {
        if (on == async_) return;
        if (on) { async_ = true; start_workers(); }
        else { stop_workers(); async_ = false; }
    }
    // 多写线程：一条 run 的页按队列分给 k 个工作线程（设备队列深时压停顿）。
    void set_io_threads(u32 k) {
        if (k < 1) k = 1;
        if (k == io_threads_) return;
        bool was = async_;
        if (was) set_async_writes(false);
        io_threads_ = k;
        if (was) set_async_writes(true);
    }
    u32 io_threads() const { return io_threads_; }
    bool async_writes() const { return async_; }
    // 攒够多少条记录才在后台落一批数据页（太小 ⇒ run 变碎，写放大回升）
    void set_async_flush_min(u32 n) { async_min_ = n ? n : 1; }
    u32 async_flush_min() const { return async_min_; }
    // 工作区高水位（字节）：异步写的意义之一是压住它
    u64 mem_high_water() const { return mem_hw_; }
    // 分层旋钮：小 = 读优化（层内 run 少、合并多），大 = 写优化（少合并、run 多）
    void set_lvl_t(u32 t) { lvl_t_ = t < 2 ? 2 : t; }
    u32 lvl_t() const { return lvl_t_; }
    // R2（第 11 轮）：每次提交最多做几次层合并（0 = 不限）。设 1 时级联合并摊到后续提交，单次提交最坏 ≈ 一次合并；
    // 某层积压到 lvl_t×4 条 run 时不受预算限制（防无界积压 ⇒ 读放大）。
    // 默认 0（老行为）—— 实测（bench/probe/wprof，FileDev）：20k×500B max 75 → 58 ms、100k×100B max 175 → 111 ms，
    // 但 p90 +20 ~ 30%、run 数更多；100k×500B 的 max（≈500 ms）是**单次**大合并，预算帮不上，run 数 11 → 32。
    // 读者尾延迟优先的部署可以开 1；吞吐/读放大优先保持 0。
    void set_level_merges(u32 n) { lvl_merges_ = n; }
    u32 level_merges() const { return lvl_merges_; }
    // R3-lite / R2b（第 12 轮）：维护模式与层合并切片预算，见 maint_mode_ 的说明。
    //   0 = 维护在提交点之前（老行为）；1 = 提交点之后由 commit() 的调用线程按单元做（默认）；
    //   2 = commit() 不做维护，由应用自己（比如后台线程）循环调 maintain() 直到返回 OK。
    void set_maint_mode(int m) { maint_mode_ = m < 0 ? 0 : (m > 2 ? 2 : m); }
    int  maint_mode() const { return maint_mode_; }
    // 跑最多 max_units 个维护单元（每个单元内持锁，单元之间放锁）。MORE = 还有活；OK = 暂时没活。
    // 产物 run 的 sync 在这 max_units 个单元**全部跑完后只做一次**（锁外）：maintain(1) 紧循环 = 每条产物一次 fdatasync，
    // 想省 fsync 就把 max_units 给大一点（比如 16）。
    RC maintain(u32 max_units = 1) {
        RC last = RC::OK;
        bool need_sync = false;
        for (u32 i = 0; i < (max_units ? max_units : 1); ++i) {
            bool wrote = false;
            {
                WGuard g(this); if (g.busy) { last = RC::BUSY; break; }
                if (RC r = ensure_ready(); r != RC::OK) { last = r; break; }
                last = maint_unit(i == 0);
                ++maint_units_;
                if (last != RC::MORE && last != RC::OK) { ++maint_errs_; dirty_ = true; break; }
                if (maint_sync_pending_) { need_sync = wrote = true; maint_sync_pending_ = false; }
            }
            if (wrote) wait_io();            // 同 maint_after_commit：按单元等写完，sync 只做一次
            if (last != RC::MORE) break;
        }
        if (need_sync && dev_) { wait_io(); dev_->sync(); }
        return last;
    }
    void set_merge_budget_pages(u32 n) { merge_budget_ = n; }
    u32  merge_budget_pages() const { return merge_budget_; }
    void set_maint_units_max(u32 n) { maint_units_max_ = n ? n : 1; }
    // R6-lite：挂载时是否惰性算存活账（默认开；关掉 = 老行为，open 时全量 recompute_liveness）
    void set_lazy_liveness(bool on) { lazy_acct_ = on; }
    u32  unknown_cells() const { return unk_cells_; }
    void set_sweep_cells(u32 n) { sweep_cells_ = n ? n : 1; }
    struct MaintStats { u64 units, slices, errs, compactions, rebalances; };   // 后两项第 12 轮加（观测用）
    MaintStats maint_stats() const { return MaintStats{maint_units_, maint_slices_, maint_errs_, cmp_valve_ + cmp_gc_, rebal_calls_}; }
    // R7（第 11 轮）：范围墓碑条数 ≥ n 且无快照时，每次提交后自动做一步分步归一直到墓碑清空（0 = 关，默认）。
    void set_range_tomb_auto(u32 n) { range_auto_ = n; }
    // R8（第 11 轮）：局部 TRIM —— 提交点之后回到空闲表的整段 ≥ min_pages 页时调用 dev->discard()（FileDev = PUNCH_HOLE）。
    // 0 = 关（默认）。沙箱里测不出收益（tmpfs/overlay 不省空间），真机 SSD 上省擦写、稀疏文件省磁盘。
    void set_discard_min_pages(u32 min_pages) { discard_min_ = min_pages; }
    u32 range_tomb_auto() const { return range_auto_; }
    u64 mem_bytes() const { return mem_bytes_; }
    Store() : tls_(new Tls[MAX_TLS + 1]) {}
    // 坑 98（第 12 次讨论）：以前析构只停 IO 线程，runs_ / cells_（含 run 的 bloom / 稀疏索引 / 页表）全部泄漏（每次 open/close 丢掉整个常驻状态，1M 条 ≈ 8 MB）。
    ~Store() {
        if (async_) set_async_writes(false); else wait_io(true);
        clear_state();
    }

    void start_workers() {
        stop_io_ = false;
        io_.reserve(io_threads_);
        for (u32 i = 0; i < io_threads_; ++i) io_.emplace_back([this] { io_loop(); });
    }
    void stop_workers() {
        wait_io(true);                 // 收线程必须把在飞的页排空（这里不允许超时）
        { std::lock_guard<std::mutex> g(io_mu_); stop_io_ = true; }
        io_cv_.notify_all();
        for (auto& t : io_) if (t.joinable()) t.join();
        io_.clear();
    }
    // 有界等待（毫秒，0 = 不限）。
    // 设备卡住（写不返回/队列不前进）时，调用方必须拿到 RC::TIMEOUT 而不是永远挂在条件变量上。
    void set_io_timeout_ms(u32 ms) { io_timeout_ms_ = ms; }
    u32  io_timeout_ms() const { return io_timeout_ms_; }
    u64  io_timeouts() const { return io_timeout_; }
    // 返回 false = 等到超时还没完成（此时 **不能** 认为数据已落盘）
    bool wait_io(bool unbounded = false) {
        if (!async_) return true;
        std::unique_lock<std::mutex> lk(io_mu_);
        if (io_stalled_ && io_timeout_ms_ && inflight_ != 0 && !unbounded) { ++io_timeout_; return false; }
        const u32 tmo = unbounded ? 0 : io_timeout_ms_;
        auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(tmo);
        auto overdue = [&] { return tmo && std::chrono::steady_clock::now() >= deadline; };
        // 没有工作线程却还有在飞的页 = 队列永远没人排空。这里就地跑一遍，
        // 保证 wait_io 在任何配置下都有出口（宁可慢，绝不挂死）。
        while (inflight_ != 0) {
            if (!io_.empty()) {
                if (!tmo) { io_cv_.wait(lk, [&] { return inflight_ == 0; }); continue; }
                if (io_cv_.wait_until(lk, deadline, [&] { return inflight_ == 0; })) continue;
                ++io_timeout_;              // 到点：明确告诉调用方"还在飞"
                io_stalled_ = true;         // 之后的所有等待都快失败（别一页一页地各等一轮）
                return false;
            }
            if (q_.empty()) { inflight_ = 0; hang_.clear(); break; }
            if (overdue()) { ++io_timeout_; io_stalled_ = true; return false; }
            IoJob j = std::move(q_.front());
            q_.pop_front();
            lk.unlock();
            RC rc = j.run(dev_);
            lk.lock();
            for (u32 i = 0; i < j.n; ++i) hang_.erase(j.pid + i);
            --inflight_;
            if (rc == RC::OK) ++io_done_; else ++io_err_;
        }
        return true;
    }
    u64 io_done() const { return io_done_; }

    // 上一次提交失败 ⇒ 内存账可能已经改了一半。任何公开入口先用它把状态按盘重建。
    // 重建同样有界：设备还在卡着就立刻返回 TIMEOUT，让调用方自己决定重试还是放弃。
    RC ensure_ready() {
        if (!dirty_) return RC::OK;
        if (!wait_io()) return RC::TIMEOUT;
        RC rc = reload();
        if (rc != RC::OK) return rc;
        dirty_ = false;
        return RC::OK;
    }
    bool needs_recovery() const { return dirty_; }

    RC open(BlockDev* dev, u8* arena, u32 arena_pages) {
        (void)arena;
        dev_ = dev;
        cap_ = dev->max_pages ? dev->max_pages : dev->capacity();   // 缩过也能长回来
        dev_pages_ = dev->capacity();                              // 设备当前长度
        // 两路组相联：总条目数取偶数（至少 2），否则 page() 里第二个 way 会越界
        u32 n = arena_pages ? arena_pages : 1;
        if (n < 2) n = 2;
        if (n & 1) --n;
        cache_n_ = n;
        cache_.reset(new CacheEnt[n]);
        sets_.reset(new CSet[n / 2]);
        return mount();
    }

    u32 last_commit() const { return vers_; }
    u32 open_vers() const { return (u32)(vers_ + 1); }
    u32  snapshots() const { return nsnap_; }
    u32 snap_version(u32 id) const { return id < nsnap_ ? snaps_[id].vers : 0; }
    // 最老快照的可见版本。回收只看它：ver > snap_min 的 run 里没有"老快照还需要的东西"
    //（老快照只读 ver <= snap_min 的版本），所以这些 run 可以照常合并/回收。
    // 范围墓碑：把 [lo,hi) 里 ver <= 墓碑版本的记录一律视为已删。
    // 它**只活在清单里**（M_RANGE），不进键空间 —— 于是扫描/游标/flush 全都不需要特殊处理，
    // 只有"判定一条记录是否还活着"的几处（get / 游标 / 归并）要看一眼。
    // 代价：墓碑本身占清单条目（40 B/个）。数量超过阈值就强制归一，归一会把被覆盖的记录真的丢掉，
    // 之后墓碑也就没用了（见 clear_covered_ranges）。
    RC del_range(u64 lo, u64 hi) {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        if (lo >= hi) return RC::INVALID;
        if (hi > IDX_BASE) hi = IDX_BASE;
        if (lo >= IDX_BASE) return RC::INVALID;
        // 坑 75/76（g5 抓到的两条，一起修）：
        //  * 以前墓碑只在提交时登记、版本取提交版本 ⇒ 提交前 get 看不见这次删除（76）；
        //    而同一批里 del_range **之后**再 put 的键，flush 出来的 run 版本 == 墓碑版本，被一并盖掉（75，丢写）。
        //  * 现在：版本定在**发出时刻**的 open_vers()，立即登记进 ranges_（提交时再按同版本落清单）；
        //    内存表里已有的同范围条目就地改成点墓碑（它们比墓碑早）；之后的 put 版本只会更大，
        //    而 range_hidden 的规则是“墓碑版本严格大于记录版本才盖”⇒ 之后的写不受影响。
        //    快照视图 S < open_vers() 看不到这条墓碑（r.ver <= view 不成立）⇒ 时间旅行不变。
        const u32 tv = open_vers();
        // 范围内的内存表条目：走键序视图（O(log n + m)），不是逐条扫 ——
        // 逐条扫在 100k 条内存表上是 143 µs/次（实测），5000 条墓碑就是 0.7 s。
        // 先收集下标再改：ent()/set_val 会让视图的代号过期（键和下标不变，下次按增量路径 O(1) 续上）。
        std::vector<u32> hit;
        {
            const auto& ms = mem_sorted();
            for (auto it = std::lower_bound(ms.begin(), ms.end(), std::make_pair(lo, 0u)); it != ms.end() && it->first < hi; ++it)
                hit.push_back(it->second);
        }
        for (u32 i : hit) {
            MemTable::Ent& e = mem_.ent(i);
            if (e.len == 0) continue;
            drop_mem_chain(e);                              // 坑 73：大值的链要跟着放掉
            mem_.set_val(e, nullptr, 0, false);
        }
        pend_ranges_.push_back(PendRange{lo, hi, tv, false});
        add_tomb(lo, hi, tv);
        ++wr_gen_;
        return RC::OK;
    }
    // 这条记录（版本 ver）在当前视图下是否被某个范围墓碑盖住
    // 每个条目带一份"前缀最大 hi"（maxhi）：往回走时一旦 maxhi <= k，更早的条目
    // 全部不可能覆盖 ⇒ 立刻停。没有它，几千个墓碑会让每次点查都退化成 O(墓碑数)。
    bool range_hidden(u64 k, u32 ver, u32 view) const {
        if (ranges_.empty()) return false;
        ensure_maxhi();
        auto it = ranges_.upper_bound({k, ~0u});     // 第一个 lo > k
        while (it != ranges_.begin()) {
            --it;
            const RangeTomb& r = it->second;
            if (r.maxhi <= k) return false;
            if (r.hi > k && r.ver <= view && r.ver > ver) return true;   // 严格大于：同版本的写在墓碑之后（坑 75）
        }
        return false;
    }
    // 登记一条范围墓碑（提交与清单重放共用一份规则）。同 lo 允许多条：
    //  * 新条目被某条旧条目支配（ver 不更新且 hi 不更远）⇒ 不插；
    //  * 旧条目被新条目支配 ⇒ 删掉旧的（省清单条目）—— **但只在没有快照还需要它时**；
    //  * 其余情况并存（各自 hi/ver 不同，缺一条都会漏盖）。
    // 坑 93（第 11 次讨论，storm rsb）：旧条目 A 被新条目 B 支配只是对视图 V >= B.ver 成立；
    // 存活快照 S 满足 A.ver <= S < B.ver 时，range_hidden(k, ver, S) 里 B 不算数、A 又没了 ⇒ 快照视图里被 A 删掉的键复活。
    // 快照都建在提交点上、B.ver 是当前开放版本 ⇒ 「有快照需要 A」⇔ snap_max() >= A.ver。同 ver 的条目对所有视图等价，总可删。
    // 快照全部释放后由 prune_tombs() 按同一规则惰性剪枝。查询侧本来就回溯同 lo 的全部条目，不用改。
    void add_tomb(u64 lo, u64 hi, u32 ver) {
        auto it = ranges_.lower_bound({lo, 0});
        const u32 smax = nsnap_ ? snap_max() : 0;
        while (it != ranges_.end() && it->first.first == lo) {
            if (it->second.ver >= ver && it->second.hi >= hi) return;
            const bool dominated = it->second.ver <= ver && it->second.hi <= hi;
            const bool unneeded  = it->second.ver == ver || nsnap_ == 0 || it->second.ver > smax;
            if (dominated && unneeded) it = ranges_.erase(it);
            else ++it;
        }
        ranges_[{lo, ver}] = RangeTomb{lo, hi, hi, ver};
        maxhi_dirty_ = true;
    }
    // 快照释放后剪掉被支配的旧墓碑（add_tomb 在快照期留下的）。同 lo 的条目按 ver 升序排列：
    // 从新往旧走，hi 不超过"更新条目的最大 hi"的旧条目对任何视图都多余。
    void prune_tombs() {
        if (nsnap_ || ranges_.size() < 2) return;
        bool changed = false;
        auto it = ranges_.end();
        while (it != ranges_.begin()) {
            --it;
            const u64 lo = it->first.first;
            u64 maxhi = it->second.hi;                       // 本 lo 组里最新条目的 hi
            while (it != ranges_.begin()) {
                auto prev = std::prev(it);
                if (prev->first.first != lo) break;
                if (prev->second.hi <= maxhi) { ranges_.erase(prev); changed = true; }
                else { maxhi = prev->second.hi; it = prev; }
            }
        }
        if (changed) maxhi_dirty_ = true;
    }
    u32 range_tombstones() const { return (u32)ranges_.size(); }
    // 重算"前缀最大 hi"：**按需**、一次 O(墓碑数)。
    // 不能每次插入都全量重算：5000 个墓碑 × O(n) 是 O(n²)（实测插入从 54 ms 涨到 3 s 量级）。
    void ensure_maxhi() const {
        if (!maxhi_dirty_.load(std::memory_order_acquire)) return;
        std::lock_guard<std::mutex> g(maxhi_mu_);               // 共享模式：多个读者同时发现脏，只算一次
        if (!maxhi_dirty_.load(std::memory_order_relaxed)) return;
        u64 m = 0;
        for (auto& kv : ranges_) { m = std::max(m, kv.second.hi); kv.second.maxhi = m; }
        maxhi_dirty_.store(false, std::memory_order_release);
    }

    u32 snap_min() const {
        if (!nsnap_) return 0;
        u32 v = (u32)~0u;
        for (u32 i = 0; i < nsnap_; ++i) if (snaps_[i].vers < v) v = snaps_[i].vers;
        return v;
    }
    // 最新快照的版本。**回收的判据用它，不是 snap_min()**：
    // 一个 ver <= snap_max 的 run 可能被"较新的那个快照"看见（视图 V 看见 ver <= V 的记录），
    // 用 snap_min 当门槛会把这种 run 压掉，于是 select_at(V) 直接丢记录。
    u32 snap_max() const {
        if (!nsnap_) return 0;
        u32 v = 0;
        for (u32 i = 0; i < nsnap_; ++i) if (snaps_[i].vers > v) v = snaps_[i].vers;
        return v;
    }
    // 这条 run 的页能不能**立刻复用**（不推迟到快照释放）：
    //   ver > 所有快照版本 ⇒ 任何视图都看不见它；它的清单项也早于任何回退点 ⇒ 回退也不需要它。
    bool run_page_safe(const Run* r) const {
        return nsnap_ == 0 || (r && r->ver > snap_max());
    }
    u32  used_pages() const { return tail_; }        // 文件高水位（真实磁盘占用）
    // 空闲表里"高水位以下"的页数。活页 = 高水位 − 空闲。
    u64  free_page_count() const {
        u64 n = 0;
        for (auto& kv : free_) {
            u32 p0 = kv.first, np = kv.second;
            if (p0 >= tail_) continue;
            if ((u64)p0 + np > tail_) np = tail_ - p0;
            n += np;
        }
        return n;
    }
    u64  live_page_count() const { return (u64)tail_ - free_page_count(); }
    u32  free_extents() const { return (u32)free_.size(); }
    u32  deferred_pages() const { u32 n = 0; for (auto& d : deferred_) n += d.first; return n; }   // 等快照释放的页（P5 观测用）
    u32  largest_free() const {                       // 最大空闲整块（搬家能不能落地就看它）
        u32 best = 0;
        for (auto& kv : free_) best = std::max(best, kv.second);
        return best;
    }
    u32  live_pages() const {                        // 归一整库后能留下的页数
        u64 t = 0;
        for (auto& kv : runs_) t += kv.second->npages;
        return (u32)t;
    }
    u64  cache_hits() const { return ctr_sum(C_HITS); }
    u64  cache_misses() const { return ctr_sum(C_MISSES); }
    DevStats& dev_stats() { return dev_->st; }
    const Report& last_report() const { return last_rep_; }
    u32  cell_count() const { return (u32)cells_.size(); }
    // R0：按层数 run 数（下标 = 层号，长度 = LVL_MAX+1）。g8/bench6 ovw 用它盯"压实产物有没有逃出层结构"。
    std::vector<u32> lvl_hist() const {
        std::vector<u32> h(LVL_MAX + 1, 0);
        for (auto& kv : runs_) h[std::min<u32>(kv.second->lvl, LVL_MAX)]++;
        return h;
    }
    u32  max_segs_per_cell() const { size_t m = 0; for (auto& kv : cells_) m = std::max(m, kv.second->segs.size()); return (u32)m; }
    u64  wr_flush() const { return wr_flush_; }
    u64  wr_compact() const { return wr_compact_; }
    u64  wr_merge() const { return wr_merge_; }        // 分层合并（与单元压实分开看）
    u64  wr_man() const { return wr_man_; }
    u64  gets() const { return ctr_sum(C_GETS); }
    u64  probes() const { return ctr_sum(C_PROBES); }
    u64  bloom_skips() const { return ctr_sum(C_BLOOM); }
    u64  sp_skips() const { return ctr_sum(C_SPSKIP); }
    u64  cursors_opened() const { return ctr_sum(C_CUR); }
    u64  segs_seen() const { return ctr_sum(C_SEGS); }
    u32  kidx_runs() const { u32 n = 0; for (auto& kv : runs_) if (!kv.second->kidx.empty()) ++n; return n; }
    // 平衡旋钮：打开后每个 run 额外驻留 8 B/键，换取区间扫描的精确定位
    //（窄区间扫描只碰真正命中的页；点查也能绕开 Bloom 误判）。
    void set_key_index(bool on) { keyidx_ = on; }
    bool key_index() const { return keyidx_; }
    // run 元数据页策略：0 = 不写（挂载时逐页扫，写放大回到最低），1 = 只给 >= min 页的 run 写（默认）。
    // 实测（§10.6）：写放大 +0.19 换 503 MB 的库重开 1.3 s → 97 ms。库越大越划算。
    void set_rmeta_mode(u32 m) { rmeta_mode_ = m ? 1 : 0; }
    // 顺序扫描预取：默认开。关掉之后扫描会退化成"一页一次 pread"
    //（只在单段顺序扫描时生效；多路归并本来就会自动关）。
    void set_prefetch(bool on) { pf_ok_ = on; }
    // 大值：默认开。关掉之后 > INLINE_VAL_MAX 的 put 直接返回 RANGE（老行为）。
    void set_overflow(bool on) { ovfl_ok_ = on; }
    bool overflow() const { return ovfl_ok_; }
    // 归并/压实时"原样接管"溢出链（默认开：压实不再重写大值）。
    // 关掉之后退化成"读出来再写一遍"—— 用来对比 / 当逃生开关。
    void set_ovfl_take(bool on) { ovfl_take_ = on; }
    // 溢出链小缓存（按值缓存整条链的载荷，不占页缓存）：0 = 关。默认 256 KB。
    // 它只对"同一批大值被反复读"有用；顺序读一遍的负载命中率为 0，只多一次线性查表。
    void set_ovfl_cache_bytes(u32 n) { ovc_max_bytes_ = n; if (!n) ovc_clear(); }

    // ---- 常开追踪环（A4）----
    // 固定 4096 条、每条 24 B、写一条几 ns：alloc/free/清单项/提交点/回退/重放/退休/搬家/收缩。
    // 追 s2 op 7310 那次靠 -DFCS_TRACE 全量输出再手看 50 行；有了环，CHECK 失败的现场自带最近
    // 几千步的分配与清单历史（`trace_dump(stderr)`），测试还能用 `trace_mark(op)` 把自己的步号打进去。
    enum TrKind : u16 { TR_NONE = 0, TR_ALLOC, TR_FREE, TR_MAN, TR_COMMIT, TR_ROLLBACK, TR_REPLAY,
                        TR_SNAP, TR_RETIRE, TR_SHRINK, TR_RELOC, TR_CF, TR_MOUNT, TR_MARK, TR_NOSPACE };
    struct TraceEv { u16 kind = 0; u16 aux = 0; u32 a = 0, b = 0, c = 0; u64 seq = 0; };
    void trace_mark(u32 tag, u32 extra = 0) { tr(TR_MARK, tag, extra, vers_); }
    void trace_dump(FILE* f, u32 last = 400) const {
        static const char* names[] = { "-", "ALLOC", "FREE", "MAN", "COMMIT", "ROLLBACK", "REPLAY",
                                       "SNAP", "RETIRE", "SHRINK", "RELOC", "CF", "MOUNT", "MARK", "NOSPACE" };
        const u64 n = std::min<u64>(tr_seq_, std::min<u64>(last, tr_.size()));
        std::fprintf(f, "--- fcs trace ring: last %llu of %llu events (tail=%u vers=%u runs=%zu) ---\n",
                     (unsigned long long)n, (unsigned long long)tr_seq_, tail_, vers_, runs_.size());
        for (u64 i = tr_seq_ - n; i < tr_seq_; ++i) {
            const TraceEv& e = tr_[i % tr_.size()];
            const char* nm = e.kind < sizeof(names) / sizeof(names[0]) ? names[e.kind] : "?";
            switch (e.kind) {
            case TR_ALLOC:   std::fprintf(f, "%8llu %-8s [%u,+%u) %s tail=%u\n", (unsigned long long)e.seq, nm, e.a, e.b, e.aux == 2 ? "man" : e.aux ? "maint" : "user", e.c); break;
            case TR_FREE:    std::fprintf(f, "%8llu %-8s [%u,+%u) %s tail=%u\n", (unsigned long long)e.seq, nm, e.a, e.b, e.aux == 1 ? "deferred" : e.aux == 2 ? "safe" : "pending", e.c); break;
            case TR_MAN:     std::fprintf(f, "%8llu %-8s op=%u rid=%u npg=%u ver=%u\n", (unsigned long long)e.seq, nm, e.aux, e.a, e.b, e.c); break;
            case TR_COMMIT:  std::fprintf(f, "%8llu %-8s vers=%u tail=%u man_last=%u nman=%u\n", (unsigned long long)e.seq, nm, e.a, e.b, e.c, e.aux); break;
            case TR_ROLLBACK:std::fprintf(f, "%8llu %-8s id=%u -> vers=%u tail=%u\n", (unsigned long long)e.seq, nm, e.aux, e.a, e.b); break;
            case TR_REPLAY:  std::fprintf(f, "%8llu %-8s rid=%u npg=%u ver=%u seq=%u\n", (unsigned long long)e.seq, nm, e.a, e.b, e.c, e.aux); break;
            case TR_SNAP:    std::fprintf(f, "%8llu %-8s id=%u vers=%u tail=%u\n", (unsigned long long)e.seq, nm, e.aux, e.a, e.b); break;
            case TR_RETIRE:  std::fprintf(f, "%8llu %-8s rid=%u npg=%u seq=%u\n", (unsigned long long)e.seq, nm, e.a, e.b, e.c); break;
            case TR_SHRINK:  std::fprintf(f, "%8llu %-8s tail %u -> %u\n", (unsigned long long)e.seq, nm, e.a, e.b); break;
            case TR_RELOC:   std::fprintf(f, "%8llu %-8s rid %u -> %u npg=%u\n", (unsigned long long)e.seq, nm, e.a, e.b, e.c); break;
            case TR_CF:      std::fprintf(f, "%8llu %-8s stage=%u tail=%u runs=%u ext=%u\n", (unsigned long long)e.seq, nm, e.aux, e.a, e.b, e.c); break;
            case TR_MOUNT:   std::fprintf(f, "%8llu %-8s vers=%u tail=%u man_last=%u nman=%u\n", (unsigned long long)e.seq, nm, e.a, e.b, e.c, e.aux); break;
            case TR_MARK:    std::fprintf(f, "%8llu %-8s tag=%u extra=%u vers=%u\n", (unsigned long long)e.seq, nm, e.a, e.b, e.c); break;
            case TR_NOSPACE: std::fprintf(f, "%8llu %-8s np=%u tail=%u lim=%u maint=%u\n", (unsigned long long)e.seq, nm, e.a, e.b, e.c, e.aux); break;
            default:         std::fprintf(f, "%8llu %-8s %u %u %u %u\n", (unsigned long long)e.seq, nm, e.a, e.b, e.c, e.aux); break;
            }
        }
    }
    u32  ovfl_cache_bytes() const { return ovc_max_bytes_; }
    u64  ovfl_cache_hits() const { return ovc_hits_; }
    u64  ovfl_cache_misses() const { return ovc_misses_; }
    u32  rmeta_mode() const { return rmeta_mode_; }
    void set_rmeta_min_pages(u32 n) { rmeta_min_ = n; }
    u32  rmeta_min_pages() const { return rmeta_min_; }
    u32  seg_max() const {
        u32 m = 0;
        for (auto& kv : cells_) m = std::max<u32>(m, (u32)kv.second->segs.size());
        return m;
    }
    u32  run_count() const { return (u32)runs_.size(); }
    u32  bad_manifest() const { return bad_man_; }
    u64  commits_merged() const { return commits_merged_; }   // 自动组提交省掉的 fsync 次数
    u64  meta_hits() const { return meta_hits_.load(std::memory_order_relaxed); }

    // ------------------------------------------------------------ 读
    RC get(u64 key, void* out, u16 cap, u16* olen) {
        RGuard g(this);                                     // open_vers() 读 vers_：必须在锁内取（g7/TSan）
        return get_at(key, open_vers(), out, cap, olen);
    }

    // 段按版本从新到旧探测：命中即停 ⇒ 热键通常 1 次读
    RC get_at(u64 key, u32 view, void* out, u16 cap, u16* olen) {
        RGuard g(this);
        if (RC r = ensure_ready(); r != RC::OK) return r;
        if (const MemTable::Ent* me = mem_.find(key); me && me->ver <= view) {
            if (me->len == 0) return RC::NOTFOUND;
            if (me->ovfl) {
                // 未提交的大值：内存表里只有 16 B 描述符，真值在溢出链里。
                // 以前这里把描述符当值抄给了调用方（len=16，坑 64）。
                return get_ovfl_into(desc_of(mem_.val(*me)), out, cap, olen);
            }
            if (olen) *olen = me->len;
            if (out && cap) std::memcpy(out, mem_.val(*me), std::min<size_t>(cap, me->len));
            return RC::OK;
        }
        Cell* c = find_cell(key);
        if (!c) return RC::NOTFOUND;
        Tls& t = tls();
        ++t.ctr[C_GETS];
        const u64 hk = khash(key);
        for (auto it = c->segs.rbegin(); it != c->segs.rend(); ++it) {
            RunPtr r = run_at(it->first);
            if (!r) continue;
            if (r->meta_pending.load(std::memory_order_acquire)) ensure_meta(r);   // bloom 也在 meta 里：先装再问
            if (!r->bloom.may(hk)) { ++t.ctr[C_BLOOM]; continue; }
            ++t.ctr[C_PROBES];
            const u8* v = nullptr;
            u16 vlen = 0;
            RC rc = probe(r, it->second.p0, std::min(it->second.p1, r->npages), key, view, v, vlen, nullptr, nullptr);
            if (rc == RC::OK && vlen == 0) return RC::NOTFOUND;   // 墓碑：更新版本已删除
            if (rc == RC::OK && range_hidden(key, r->ver, view)) return RC::NOTFOUND;
            if (rc == RC::OK && vlen == OVFL_MARK) {               // 大值：v 是页里的 16 B 描述符，先抄出来再读链
                const OvflDesc d = desc_of(v);
                rc = get_ovfl_into(d, out, cap, olen);
                if (rc == RC::CORRUPT) continue;
                return rc;
            }
            if (rc == RC::OK) {
                if (olen) *olen = vlen;
                if (out && cap) std::memcpy(out, v, vlen < cap ? vlen : cap);
                return RC::OK;
            }
            if (rc == RC::CORRUPT) continue;
        }
        return RC::NOTFOUND;
    }

    // 扫描：目录顺序 = 键序；单元内多段归并（顺序是派生结果，不是结构）
    // ------------------------------------------------------------ 游标
    // 可暂停 / 可重定位 / 可定时（快照视图）的范围游标。
    // 语义：按 key 升序吐出「在该视图下最新、且非墓碑」的记录。
    // 单元内多段归并，跨单元自动续接；next() 之间可以任意插入其它读写。
    class Cursor {
    public:
        Cursor() = default;
        Cursor(Store* s, u64 lo, u64 hi, u32 view = 0) { open(s, lo, hi, view); }
        ~Cursor() = default;

        bool open(Store* s, u64 lo, u64 hi, u32 view = 0) {
            if (s && s->ensure_ready() != RC::OK) { done_ = true; mi_ = mend_ = 0; return false; }
            st_ = s; lo_ = lo; hi_ = hi;
            view_ = view ? view : s->open_vers();
            auto it = s->cells_.upper_bound(lo);
            if (it != s->cells_.begin()) --it;
            cell_ = it;
            done_ = (hi_ <= lo_);
            pend_ = -1;
            have_run_ = false;
            mfrom_ = lo_;
            mi_ = mend_ = 0;
            if (!done_) { prime(); refresh_mem(); }
            return !done_ || mi_ < mend_;
        }
        void close() { cs_.clear(); st_ = nullptr; done_ = true; pend_ = -1; have_run_ = false; mi_ = mend_ = 0; }
        bool seek(u64 k) { return open(st_, k, hi_, view_); }

        // 取下一行；v 指向内部缓冲，有效到下一次 next()/close()。
        // 坑 77（g5）：以前游标只归并 run ⇒ put/del 之后 get 看得见、select/count/scan 看不见，直到数据进 run。
        // 现在把内存表（键序视图，见 Store::mem_sorted）当作最新的一路一起归并：同键内存表赢，墓碑不吐。
        bool next(u64& k, const u8*& v, u16& l) {
            if (!st_) return false;
            if (st_->mem_.gen() != mgen_) refresh_mem();    // next() 之间有过写入：从上次位置重建内存表视图
            for (;;) {
                if (!have_run_) have_run_ = run_next(rk_, rv_, rl_);
                const auto& ms = st_->mem_sorted();
                const MemTable::Ent* me = nullptr;
                while (mi_ < mend_) {                           // 跳过该视图不可见的（比游标视图新的）条目
                    const MemTable::Ent& e = st_->mem_.at(ms[mi_].second);
                    if (e.ver <= view_) { me = &e; break; }
                    ++mi_;
                }
                if (!me && !have_run_) return false;
                if (me && (!have_run_ || me->key <= rk_)) {
                    if (have_run_ && me->key == rk_) have_run_ = false;   // run 里的同键旧副本：丢掉
                    ++mi_;
                    mfrom_ = me->key == ~0ull ? ~0ull : me->key + 1;
                    if (me->len == 0) continue;                              // 墓碑
                    k = me->key;
                    if (me->ovfl) {                                          // 未提交的大值：物化
                        OvflDesc d = st_->desc_of(st_->mem_.val(*me));
                        u32 got = 0;
                        mbig_.resize(d.total);
                        if (st_->read_ovfl(d, mbig_.data(), d.total, &got) != RC::OK) continue;
                        v = mbig_.data(); l = (u16)d.total;
                    } else { v = st_->mem_.val(*me); l = me->len; }
                    return true;
                }
                have_run_ = false;
                mfrom_ = rk_ == ~0ull ? ~0ull : rk_ + 1;
                k = rk_; v = rv_; l = rl_;
                return true;
            }
        }

    private:
        // 内存表键序视图里 [mfrom_, hi_) 这一段
        void refresh_mem() {
            const auto& ms = st_->mem_sorted();
            mgen_ = st_->mem_.gen();
            auto lo = std::lower_bound(ms.begin(), ms.end(), std::make_pair(mfrom_, 0u));
            auto hi = std::lower_bound(ms.begin(), ms.end(), std::make_pair(hi_, 0u));
            mi_ = (size_t)(lo - ms.begin());
            mend_ = (size_t)(hi - ms.begin());
            if (mend_ < mi_) mend_ = mi_;
        }
        // 只归并 run 的那一路（原来的 next）
        bool run_next(u64& k, const u8*& v, u16& l) {
            if (pend_ >= 0) {                      // 延迟推进：保证上一行的 v 不被覆盖
                if (!cs_[pend_].advance(st_, pend_len_)) cs_[pend_].done = true;
                pend_ = -1;
            }
            for (;;) {
                if (done_) return false;
                int best = -1; u64 bk = 0; u32 bver = 0, bseq = 0; u16 blen = 0;
                for (size_t i = 0; i < cs_.size(); ++i) {
                    Cur& c = cs_[i];
                    for (;;) {
                        if (c.done) break;
                        RecHdr h; c.hdr(h);
                        if (h.key < clo_ || c.r->ver > view_) {   // 越界 / 该视图不可见
                            if (!c.advance(st_, h.len)) c.done = true;
                            continue;
                        }
                        if (h.key >= cend_) { c.done = true; break; }   // 越过本单元
                        if (best < 0 || h.key < bk ||
                            (h.key == bk && (c.r->ver > bver ||
                                             (c.r->ver == bver && c.r->seq > bseq)))) {
                            best = (int)i; bk = h.key; bver = c.r->ver; bseq = c.r->seq;
                            blen = h.len;
                        }
                        break;
                    }
                }
                if (best < 0) { if (!advance_cell()) return false; continue; }
                for (size_t i = 0; i < cs_.size(); ++i) {          // 同键的旧副本全部丢弃
                    if ((int)i == best || cs_[i].done) continue;
                    Cur& c = cs_[i];
                    for (;;) {
                        RecHdr h; c.hdr(h);
                        if (h.key != bk || c.done) break;
                        if (!c.advance(st_, h.len)) { c.done = true; break; }
                    }
                }
                if (!blen) {                            // 墓碑：推进后继续找（不可见）
                    if (!cs_[best].advance(st_, 0)) cs_[best].done = true;
                    continue;
                }
                if (st_->range_hidden(bk, cs_[best].r->ver, view_)) {   // 范围删除盖住
                    if (!cs_[best].advance(st_, blen)) cs_[best].done = true;
                    continue;
                }
                pend_ = best; pend_len_ = blen;
                k = bk;
                if (blen == OVFL_MARK) {                 // 大值：物化到游标自己的缓冲
                    const u8* pv = cs_[best].val(st_, blen);
                    if (!pv) { if (!cs_[best].advance(st_, blen)) cs_[best].done = true; continue; }
                    v = pv; l = (u16)cs_[best].vb.size();
                } else { v = cs_[best].val(); l = blen; }
                return true;
            }
        }

        bool advance_cell() {
            if (!st_ || cell_ == st_->cells_.end()) { done_ = true; return false; }
            ++cell_;
            // 目录有序 ⇒ 下一个单元的 lo 已经 >= 查询上界就整体结束，不再逐格空转
            if (cell_ != st_->cells_.end() && cell_->first >= hi_) {
                done_ = true; cell_ = st_->cells_.end(); return false;
            }
            return prime();
        }
        bool prime() {
            cs_.clear();
            cs_.reserve(16);
            if (!st_ || cell_ == st_->cells_.end()) { done_ = true; return false; }
            Cell* c = cell_->second;
            clo_ = std::max(lo_, c->lo); cend_ = std::min(hi_, c->hi);
            done_ = false;
            if (clo_ >= cend_) return true;             // 空区间：next() 会直接推进
            Tls& t = st_->tls();
            for (auto& sg : c->segs) {
                ++t.ctr[C_SEGS];
                RunPtr r = st_->run_at(sg.second.rid);
                if (!r || sg.second.p0 >= sg.second.p1) continue;
                if (sg.second.khi <= clo_ || sg.second.klo >= cend_) continue;
                if (r->meta_pending.load(std::memory_order_acquire)) st_->ensure_meta(r);
                if (!run_may_have(r, clo_, cend_)) { ++t.ctr[C_SPSKIP]; continue; }  // 键域摘要：整条 run 跳过
                cs_.emplace_back();
                ++t.ctr[C_CUR];
                Cur& x = cs_.back();
                x.r = r; x.p0 = sg.second.p0; x.p1 = sg.second.p1;
                x.klo = sg.second.klo; x.khi = sg.second.khi;
                x.pf_ = st_->pf_ok_;           // 顺序扫描才预取；多段归并时下面会关掉
                x.load(st_, clo_);
            }
            if (cs_.size() > 1) for (auto& x : cs_) x.pf_ = false;   // 多路归并：预取只会互相踢
            return true;
        }

        Store* st_ = nullptr;
        std::vector<Cur> cs_;
        std::map<u64, Cell*>::iterator cell_;
        u64 lo_ = 0, hi_ = 0, clo_ = 0, cend_ = 0;
        u32 view_ = 0, pend_len_ = 0;
        int pend_ = -1;
        bool done_ = true;
        // 内存表一路
        size_t mi_ = 0, mend_ = 0;    // mem_sorted() 里的 [当前, 末尾)
        u64 mgen_ = 0, mfrom_ = 0;    // 视图对应的 mem_ 代号；下一次重建从这个键起
        bool have_run_ = false;       // run 一路已取出一行、尚未吐出
        u64 rk_ = 0; const u8* rv_ = nullptr; u16 rl_ = 0;
        std::vector<u8> mbig_;        // 未提交大值的物化缓冲
    };

    // 复用同一个扫描游标：容量与页缓冲跨查询保留 ⇒ 扫描路径上零分配。
    // 若回调里又发起一次扫描（嵌套），自动退化为栈上游标，互不干扰。
    class CursorRef {
    public:
        explicit CursorRef(Store* s) : st_(s) {
            if (!st_->scr_busy_.exchange(true, std::memory_order_acquire)) { owned_ = true; c_ = &st_->scr_; }
            else c_ = &local_;                       // 池子被占（并发读者 / 嵌套）：用栈上的
        }
        ~CursorRef() { if (owned_) st_->scr_busy_.store(false, std::memory_order_release); }
        Cursor* operator->() { return c_; }
        Cursor& operator*() { return *c_; }
    private:
        Store* st_ = nullptr;
        bool owned_ = false;
        Cursor local_;
        Cursor* c_ = nullptr;
    };

    // 范围查询：limit=0 表示不限；offset 跳过前 N 条；view=0 表示当前打开版本
    template <class F>
    RC select(u64 lo, u64 hi, F&& fn, u32 limit = 0, u32 offset = 0, u32 view = 0) {
        RGuard g(this);
        if (hi > IDX_BASE) hi = IDX_BASE;          // 默认只查用户键空间
        CursorRef ref(this);
        Cursor& cur = *ref;
        if (!cur.open(this, lo, hi, view)) return RC::OK;
        u64 k; const u8* v; u16 l;
        u32 skipped = 0, emitted = 0;
        while (cur.next(k, v, l)) {
            if (skipped < offset) { ++skipped; continue; }
            if (!fn(k, v, l)) break;
            if (limit && ++emitted >= limit) break;
        }
        return RC::OK;
    }
    // 快照视图下的一致性扫描（时间旅行）
    template <class F>
    RC select_at(u32 view, u64 lo, u64 hi, F&& fn, u32 limit = 0) {
        return select(lo, hi, fn, limit, 0, view);
    }
    // 前缀查询：key 的高 prefix_bits 位等于 pfx（前缀值语义，与字符串前缀同构）
    template <class F>
    RC select_prefix(u64 pfx, u32 prefix_bits, F&& fn, u32 limit = 0, u32 view = 0) {
        if (prefix_bits == 0 || prefix_bits >= 64) return select(0, IDX_BASE, fn, limit, 0, view);
        u32 sh = 64 - prefix_bits;
        u64 lo = pfx << sh;                        // 半开区间 [lo, lo + 2^sh)
        u64 hi = lo + (1ull << sh);
        if (lo >= IDX_BASE) return RC::OK;
        return select(lo, std::min<u64>(hi, IDX_BASE), fn, limit, 0, view);
    }

    // ------------------------------------------------------------ 二级索引
    // 索引条目与主记录同一次提交 ⇒ 原子；索引扫描 = 一次范围扫描 + N 次主键回表。
    RC index_put(u32 idx, u64 skey, u64 pk) {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (idx >= IDX_MAX) return RC::RANGE;
        return put_raw(idx_enc(idx, skey), &pk, 8);
    }
    RC index_del(u32 idx, u64 skey) {
        if (idx >= IDX_MAX) return RC::RANGE;
        return del(idx_enc(idx, skey));
    }
    RC index_get(u32 idx, u64 skey, u64& pk) {
        u8 b[8]; u16 l = 0;
        RC rc = get(idx_enc(idx, skey), b, sizeof b, &l);
        if (rc != RC::OK || l != 8) return rc == RC::OK ? RC::CORRUPT : rc;
        std::memcpy(&pk, b, 8);
        return RC::OK;
    }
    // [slo, shi) 的索引范围扫描：回调拿到 (skey, pk)
    template <class F>
    RC index_scan(u32 idx, u64 slo, u64 shi, F&& fn, u32 limit = 0, u32 view = 0) {
        if (idx >= IDX_MAX) return RC::RANGE;
        u64 lo = idx_enc(idx, slo), hi = idx_enc(idx, shi);
        if (hi < lo) return RC::RANGE;
        RGuard g(this);                                     // 以前漏了锁（g7 审计补上）
        CursorRef ref(this);
        Cursor& cur = *ref;
        if (!cur.open(this, lo, hi, view)) return RC::OK;
        u64 k; const u8* v; u16 l;
        u32 emitted = 0;
        while (cur.next(k, v, l)) {
            u64 pk = 0;
            if (l >= 8) std::memcpy(&pk, v, 8);
            if (!fn((k & SKEY_MAX), pk)) return RC::OK;
            if (limit && ++emitted >= limit) break;
        }
        return RC::OK;
    }
    // 调试：遍历所有 run 的所有页（绕过键空间/段视图），用于定位异常记录
    template <class F>
    void raw_dump(F&& fn) {
        wait_io();
        std::vector<u8> buf(PAGE);
        for (auto& kv : runs_) {
            RunPtr r = kv.second;
            for (u32 p = 0; p < r->npages; ++p) {
                if (dev_->read((PageId)(r->page0 + p), 0, buf.data(), PAGE) != RC::OK) continue;
                u16 used = rd16(buf.data() + 34);
                u8 pf = pg_pfx(buf.data());
                u32 off = DHDR;
                while (off + pg_rec_size(pf, 0) <= used) {
                    RecHdr h; rd_rec(buf.data(), off, h);
                    u32 rs = pg_rec_size(pf, h.len);
                    if (off + rs > used) break;
                    fn(kv.first, r, p, off, h, pg_val_at(buf.data(), off));
                    off += rs;
                }
            }
        }
    }

    u32 count(u64 lo, u64 hi) {
        u32 n = 0;
        select(lo, hi, [&](u64, const u8*, u16) { ++n; return true; });
        return n;
    }

    // 全库遍历（含索引键空间）：就是一次 [0, ~0) 的游标扫描 —— 同样归并内存表（坑 77）。
    template <class F>
    RC scan(F&& fn) {
        RGuard g(this);
        CursorRef ref(this);
        Cursor& cur = *ref;
        if (!cur.open(this, 0, ~0ull, 0)) return RC::OK;
        u64 k; const u8* v; u16 l;
        while (cur.next(k, v, l))
            if (!fn(k, v, l)) break;
        return RC::OK;
    }

    // ------------------------------------------------------------ 写
    RC put(u64 key, const void* val, u16 len) {
        if (key >= IDX_BASE) return RC::RANGE;      // 索引命名空间由引擎专用
        return put_raw(key, val, len);
    }
    RC put_raw(u64 key, const void* val, u16 len) {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        if (len == 0) len = 1;
        if (len == OVFL_MARK) return RC::RANGE;      // 65535 保留给溢出标记
        if (len > INLINE_VAL_MAX && !ovfl_ok_) return RC::RANGE;   // 见 set_overflow
        if (len > INLINE_VAL_MAX) {
            // 大值：**现在就**落成溢出链（mem 里只放 16 B 描述符）。
            // 这样 memtable 不会因为几条大值就吃满内存，提交时也不用再搬。
            // 先写链再动内存表：写失败时内存表原样不动。
            OvflDesc d;
            RC rc = write_ovfl((const u8*)val, len, d, true);   // P3：异步模式下链交给 IO 线程
            if (rc != RC::OK) return rc;
            u8 dsc[16];
            put_desc(dsc, d);
            bool existed = false;
            MemTable::Ent& r = mem_.upsert(key, existed);
            u64 old = r.len ? (u64)rec_size(r.len) : 0;
            drop_mem_chain(r);
            r.ver = open_vers();
            mem_.set_val(r, dsc, 16, true);
            mem_bytes_ = mem_bytes_ + (u64)rec_size(len) - old;
        } else {
            bool existed = false;
            MemTable::Ent& r = mem_.upsert(key, existed);
            u64 old = r.len ? (u64)rec_size(r.len) : 0;
            drop_mem_chain(r);
            r.ver = open_vers();
            mem_.set_val(r, (const u8*)val, len, false);
            mem_bytes_ = mem_bytes_ + (u64)rec_size(len) - old;
        }
        if (mem_bytes_ > mem_hw_) mem_hw_ = mem_bytes_;
        ++wr_gen_;
        return RC::OK;
    }
    RC del(u64 key) {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        bool existed = false;
        MemTable::Ent& r = mem_.upsert(key, existed);
        drop_mem_chain(r);
        r.ver = open_vers();
        mem_.set_val(r, nullptr, 0, false);
        ++wr_gen_;
        return RC::OK;
    }
    // 坑 73（A2 的页所有权检查第一次跑就抓到的）：同一批里把大值覆盖成别的值 / 删掉，旧链没人释放。
    // 链在 put 时就已经落盘（mem 里只有 16 B 描述符），覆盖掉描述符 ⇒ 链既不属于任何 run、也不在空闲表 ——
    // 进程活着就一直漏（重开后 rebuild_free 才把它当空闲收回）。
    // 这条链写在上一个提交点之后，没有快照、也没有回退点能引用它 ⇒ 可以 snap_safe 立即归还。
    void drop_mem_chain(const MemTable::Ent& r) {
        if (!r.ovfl || r.len != 16) return;
        const OvflDesc d = desc_of(mem_.val(r));
        free_pages(d.pg0, d.npages, true);
    }

    // 调试用：打印每条 run 的存活账（FCS_TRACE 构建下可用）
    void dbg_runs() const {
        u64 tl = 0, tn = 0, tlb = 0;
        for (auto& kv : runs_) {
            const Run* r = kv.second;
            tl += r->live_recs; tn += r->nrec; tlb += r->live_bytes;
            if (r->live_recs * 4 < r->nrec || r->nrec == 0)
                std::fprintf(stderr, "  RUN seq=%u rid=%u npg=%u nrec=%u live_recs=%u live_bytes=%llu\n",
                    r->seq, r->page0, r->npages, r->nrec, r->live_recs, (unsigned long long)r->live_bytes);
        }
        std::fprintf(stderr, "  RUNS total nrec=%llu live_recs=%llu live_bytes=%llu\n", (unsigned long long)tn, (unsigned long long)tl, (unsigned long long)tlb);
    }

    // 组提交：
    //   commit(false) —— 只推进“逻辑提交点”，数据留在内存里攒批（不产生任何 I/O）；
    //   commit(true)  —— 一次物理提交，把攒下的所有批次写成一条 run + 一个提交点。
    // 掉电时丢失的是“最后一次同步之后的逻辑提交”，这与同步语义完全一致：
    // 逻辑提交只承诺“这组写要么整体可见、要么整体不见”，持久性由 sync 承诺。
    RC commit(bool durable = true) {
        RC rc;
        {
            WGuard g(this); if (g.busy) return RC::BUSY;
            rc = commit_locked(durable);
        }
        // R3-lite：提交点已落盘、锁已放；维护按单元做，单元之间读者/写者都能插进来。
        if (rc == RC::OK && durable && maint_mode_ == 1) maint_after_commit();
        return rc;                         // mode 2：维护留给应用的 maintain()
    }
    // 一次 commit() 之后的维护循环：{拿锁 → 一个单元 → 放锁}，直到没有维护可做或到达单元上限。
    // 第一个单元 = retire + rebalance（split/compact 本身就是按单元有界的），之后每个单元 = 一片层合并。
    // 任何一步失败：账可能已脏 ⇒ dirty_（下次公开调用按盘重建，损失的只是这次维护的产物）；用户的提交不受影响。
    void maint_after_commit() {
        bool need_sync = false;
        for (u32 i = 0; i < maint_units_max_; ++i) {
            RC r;
            bool wrote = false;
            {
                WGuard g(this); if (g.busy) break;
                if (dirty_) break;
                r = maint_unit(i == 0);
                ++maint_units_;
                if (r != RC::MORE && r != RC::OK) { ++maint_errs_; dirty_ = true; break; }
                if (maint_sync_pending_) { need_sync = wrote = true; maint_sync_pending_ = false; }
            }
            // 维护产物的页由维护线程自己在锁外等写完（wait_io）：锁内不会再有人等这批 I/O；
            if (wrote) wait_io();
            if (r != RC::MORE) break;
        }
        // …… 而 sync 只在整个维护循环**结束后做一次**：下一次提交点的 write_sb 里就没有这笔 I/O 了
        //（以前顶层合并的几十 MB 全压在提交路径的 fsync 上：停顿 = 合并 I/O 体量）。
        // 第 12 轮 M2 验收时发现：按"每个写了 run 的单元"各 sync 一次，压实产物（每个单元一条小 run）会把一次提交后的
        // 维护变成几十次 fdatasync（沙箱上每次 5 ~ 12 ms）⇒ wprof avg +26%；改成一次之后 fsync 次数从"每单元"回到"每次提交"。
        // 但 wait_io 仍按单元做：只 sync 一次的第一版让几十片的写积压在 I/O 队列里，锁内等它的那一下把读者卡到 92 ms。
        if (need_sync && dev_) { wait_io(); dev_->sync(); }
    }
    RC maint_unit(bool first) {
        std::vector<ManEnt> d;
        RC rc = RC::OK;
        bool more = false;
#ifdef FCS_PROF_MAINT
        const u64 pt0 = prog_us(); u64 pt1 = pt0, pt2 = pt0, pt3 = pt0;
        const u32 unk0 = unk_cells_; const bool job0 = job_ != nullptr; const u32 sl0 = job_ ? job_->slices : 0;
        const size_t runs0 = runs_.size(), cells0 = cells_.size();
#endif
        if (unk_cells_ && recount_sweep(sweep_cells_)) more = true;   // R6-lite：每个单元补算一批未知单元
#ifdef FCS_PROF_MAINT
        pt1 = prog_us();
#endif
        if (first || split_pending_) {
            rc = rebalance(d);
            if (rc == RC::OK) retire_dead_runs(d);
            if (split_pending_) more = true;                           // 坑 100：128 刀没切完 ⇒ 还有活
        }
#ifdef FCS_PROF_MAINT
        pt2 = prog_us();
#endif
        if (rc == RC::OK) {
            rc = level_pass(d, true);
            if (rc == RC::MORE) { more = true; rc = RC::OK; }
        }
#ifdef FCS_PROF_MAINT
        pt3 = prog_us();
        if (pt3 - pt0 > 10000)
            std::fprintf(stderr, "[maint] unit %.1f ms: sweep %.1f (unk %u->%u) rebal+retire %.1f (cells %zu->%zu) level %.1f (job %d->%d slices %u->%u runs %zu->%zu)%s\n",
                (pt3 - pt0) / 1e3, (pt1 - pt0) / 1e3, unk0, unk_cells_, (pt2 - pt1) / 1e3, cells0, cells_.size(), (pt3 - pt2) / 1e3,
                (int)job0, (int)(job_ != nullptr), sl0, job_ ? job_->slices : 0, runs0, runs_.size(), first ? " [first]" : "");
#endif
        if (!d.empty()) {
            for (auto& m : d) if (m.op == M_RUN_ADD) { maint_sync_pending_ = true; break; }   // 有新 run：锁外 sync
            pend_delta_.insert(pend_delta_.end(), d.begin(), d.end());   // 下一个提交点入账
        }
        if (rc != RC::OK) return rc;
        return more ? RC::MORE : RC::OK;
    }
    RC commit_locked(bool durable) {
        if (RC r = ensure_ready(); r != RC::OK) return r;
        if (!durable) {
            ++vers_;                       // 逻辑提交：版本前移
            ++gpend_;
            // 异步组提交：把本批数据页丢给后台线程，前台只等到“提交点前一刻”。
            // 只做 flush（写数据页 + 挂 run），不做 rebalance / 回收 / 合并：
            // 那些会释放或重写页，必须等提交点落盘（pending 纪律）。
            // 只有攒够一批才送后台：否则每个逻辑提交都写一条小 run，写放大失控
            if (async_ && (mem_.size() >= async_min_ || mem_bytes_ >= async_bytes_min_)) {
                RC rc = flush_mem(pend_delta_, vers_);      // 版本 = 刚推进到的逻辑提交点
                if (rc != RC::OK) return rc;
                mem_.clear();                  // 已落 run，工作区可以空出来
                mem_bytes_ = 0;
            }
            return RC::OK;
        }
        static const bool prof_on = std::getenv("FCS_PROF") != nullptr;
        auto prof = [](const char* tag, u64 t0) {
            if (!prof_on) return;
            std::printf("[prof] %-12s %7.2f ms\n", tag, (double)(prog_us() - t0) / 1000.0);
        };
        // 自动组提交：拿锁之前别人已经提交过，而且那次提交**已经包含**了我这条写
        //（wr_gen_ 在 put 时就递增，durable_gen_ 记录提交点覆盖到哪）⇒ 我这几步不用再写一遍。
        // 注意必须在 mtx_ 之内判断：否则判断与提交之间有窗口，会漏掉别人新写的记录。
        if (wr_gen_ == durable_gen_ && pend_delta_.empty() && gpend_ == 0) { ++commits_merged_; return RC::OK; }
        const u64 my_gen = wr_gen_;
        const u64 err0 = io_err_;
        if (io_err_ != io_seen_) {                 // 后台写失败过 ⇒ 先回滚到盘上的提交点
            io_seen_ = io_err_;
            reload();
            return RC::IO;
        }
        gpend_ = 0;
        dead_added_ = 0;
        std::vector<ManEnt> delta;                 // 后台已落页的 run（pend_delta_）由 commit_delta 统一并入
        if (!mem_.empty()) {
            u64 tf = prog_us();
            RC rc = flush_mem(delta, open_vers());
            if (rc == RC::NOSPACE) {               // 空间不够：先做一次零写回收再试
                retire_dead_runs(delta);
                // 坑 99：退休的 DEL（以及 async 刷出、盖住它们的 pend_delta_ ADD）必须先过一个提交点，页才能复用；
                // 否则崩溃后清单仍引用已被覆盖的页。这里写一个**只含 DEL/ADD、不含范围墓碑**的中间提交点
                //（范围墓碑属于本批、不能先于本批的 put 落盘），然后再放页、再试。
                if (!delta.empty() || !pend_delta_.empty()) {
                    if (!wait_io() || io_err_ != err0) { io_seen_ = io_err_; dirty_ = true; return RC::IO; }
                    RC r2 = commit_delta(delta, false);
                    if (r2 != RC::OK) { dirty_ = true; return r2; }
                    delta.clear();
                }
                promote_pending();
                rc = flush_mem(delta, open_vers());
                if (rc != RC::OK) { dirty_ = true; return rc; }   // 账已动过（退休的 run）⇒ 下次按盘重建
            }
            if (rc != RC::OK) return rc;           // 还没动账，直接返回
            prof("flush_mem", tf);
#ifdef FCS_TRACE
            check_liveness("after flush");
#endif
        }
        if (delta.empty() && pend_delta_.empty() && pend_ranges_.empty()) {
            promote_pending();
            durable_gen_ = wr_gen_;        // 没有要写的页、也没有后台已落页待入账：账已是最新
            return RC::OK;
        }
        // 从这里开始账已经被改过：任何一步失败都回到“上一个提交点”。
        // mem_ 与 pend_delta_ 都原样保留 ⇒ 调用方重试就能成功。
        // 失败即“账已脏”：**不在这里**按盘重建（重建要等 I/O，设备卡住时会把调用方拖住），
        // 只打个标记；下一次任何公开调用会先 ensure_ready() 重建。失败路径因此永远有界。
        auto fail = [&](RC rc, const char* step) -> RC {
#ifdef FCS_TRACE
            std::fprintf(stderr, "    COMMIT FAIL at %s rc=%s\n", step, rc_str(rc));
#endif
            dirty_ = true; return rc; };
        u64 tp = prog_us();
        apply_ranges(delta);               // 墓碑先落账：retire_dead_runs 这次就能把整条被盖住的 run 退休
        RC rc = RC::OK;
        if (maint_mode_ == 0) {            // 老行为：维护在提交点之前、同一个提交点入账（mode 1 在 maint_after_commit）
            recount_all_unknown();         // R6-lite（mode 0）：没有维护单元可分摊 ⇒ 第一次提交前一次性补齐
            rc = rebalance(delta);
            if (rc != RC::OK) return fail(rc, "rebalance");
            prof("rebalance", tp); tp = prog_us();
            retire_dead_runs(delta);       // 零写回收：整条 run 全垃圾 ⇒ 直接释放
            rc = level_pass(delta);        // 分层合并：控制 run 数（读放大 / 空间）
            if (rc != RC::OK) return fail(rc, "level_pass");
            prof("level", tp); tp = prog_us();
        }
        // 提交点必须落在数据之后（顺序性）。有界等待：设备卡住就报 TIMEOUT，
        // 而不是永远挂在条件变量上 —— 这是"绝不挂死"的最后一道闸。
        if (!wait_io()) { io_seen_ = io_err_; return fail(RC::TIMEOUT, "wait_io"); }
        if (io_err_ != err0) { io_seen_ = io_err_; return fail(RC::IO, "wait_io"); }  // 后台页写失败 ⇒ 提交点绝不越过它
        rc = commit_delta(delta);
        if (rc != RC::OK) return fail(rc, "commit_delta");
        prof("commit_delta", tp); tp = prog_us();
        mem_.clear();
        mem_bytes_ = 0;
        pend_delta_.clear();
        promote_pending();                 // 提交点已落盘（write_sb 内部已同步）：挂起的页现在安全
        prof("promote", tp);
        durable_gen_ = my_gen;             // 直到 my_gen 的所有写都已在此提交点内
        // R7（第 11 轮）：范围墓碑自动归一。墓碑一条一个清单项，几千条就把清单撑大（每次提交都要写全量快照）；
        // 阈值到了就在**本次提交点之后**顺手做一步分步归一（有界：一组 run 的归并，见 consolidate_step），
        // 若干次提交后最后一步把墓碑清掉并重写一份紧凑清单。只在无快照时做（有快照墓碑不能清）。
        // 默认关（range_auto_ = 0）：这是一个策略开关，开了每次提交多付一次提交点的代价直到清完。
        if (range_auto_ && nsnap_ == 0 && ranges_.size() >= range_auto_) {
            RC r2 = consolidate_step_impl();
            if (r2 != RC::OK && r2 != RC::MORE) { dirty_ = true; return r2; }
        }
        return RC::OK;
    }

    // 归一：把段压成一条 run。
    //   min_segs = 0 ⇒ 全库合成一条（最省空间、段数=1，代价是整库重写）
    //   min_segs = N ⇒ 只压“段数 ≥ N”的单元（增量版，只碰碎片化的单元）
    // 全库归一之后，被范围墓碑盖住的记录已经在归并时丢掉了 ⇒ 这些墓碑再没有作用。
    // 只在**真的把全库合成一条**（min_segs==0 且没有快照挡住老 run）时清理。
    void clear_covered_ranges() {
        if (ranges_.empty()) return;
        ranges_.clear();
        ++wr_gen_;                       // 墓碑消失也是一次状态变化：让提交别被"自动组提交"跳过
    }

    // 维护操作（consolidate / relocate / checkpoint / compact_file）= 提交点。
    // 以前它们只把“已刷出的 run”入账、不刷 mem_、不落范围墓碑 ⇒ 落盘状态是个混合物：
    // 坑 78（g5）：del_range 之后 compact_file，归并把被盖住的记录丢了，墓碑本身却没进清单，
    // 重开后“部分删除”——既不是上个提交点、也不是现在。规则改成：先 commit()，再动页。
    // 没有未提交的写时 commit() 直接短路，不多写一个字节。
    RC maint_commit() {
        if (!(wr_gen_ == durable_gen_ && pend_delta_.empty() && gpend_ == 0 && pend_ranges_.empty())) {
            if (RC r = commit_locked(true); r != RC::OK) return r;   // 维护操作自己就是提交点、且持锁：不跑提交后维护循环（mode 1）
        }
        recount_all_unknown();             // M2：显式维护入口先把未知单元全部落账——退休/脏度/回收判断与惰性账之前完全一致
        return RC::OK;
    }
    RC consolidate(u32 min_segs = 0) { return consolidate_impl(min_segs, false); }
    // R2（第 11 轮）分步维护：每次只做**一个有界单位**就提交、放锁、返回 MORE；应用或后台线程循环到 OK。
    //   consolidate_step()：合并一组（≤ lvl_t 条、全库 seq 连续、ver > snap_max）最老的 run；只剩 ≤1 条可合并 run 时
    //                       收尾（脏则重写一遍；无快照时清掉已覆盖的范围墓碑并重写全量清单）并返回 OK。
    //   compact_file_step()：先 consolidate_step，再每步搬一条 run（relocate_step），最后 checkpoint + shrink。
    // 代价（明说）：整库从 N 条 run 并成 1 条，一次性 consolidate 每条记录重写 1 次，分步要重写 ⌈log_{lvl_t} N⌉ 次
    //（23 条 / lvl_t=8 ⇒ 2 次）；每步多 2 次 fdatasync；垃圾多留几步。换来的是每步独占时长 ≈ 一组 run 的大小而不是整库。
    // 分步 compact_file 不做 compact_file() 里的"强制弹跳"（把顶部链物化到低处）：那一步本身就是整条 run 的重写，
    // 分不了步；需要极致收尾的仍用 compact_file()。
    // 不变量不变：每一步 = 提交点（先 maint_commit 再动页），快照期只动 ver > snap_max 的 run。
    RC consolidate_step() {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        if (RC r = maint_commit(); r != RC::OK) return r;
        return consolidate_step_impl();
    }
    RC compact_file_step() {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        if (RC r = maint_commit(); r != RC::OK) return r;
        struct ManHigh { bool& f; explicit ManHigh(bool& x) : f(x) { f = true; } ~ManHigh() { f = false; } } mh(man_high_);
        RC rc = consolidate_step_impl();
        if (rc != RC::OK) return rc;                 // MORE / 错误
        rc = relocate_step_impl();
        if (rc != RC::OK) return rc;
        rc = checkpoint();
        if (rc != RC::OK) return rc;
        rc = shrink();
        if (rc != RC::OK) return rc;
        for (int i = 0; i < 2 && man_can_drop(); ++i) {   // 同 compact_file 收尾：清单页再压低 1 ~ 2 页
            rc = checkpoint();
            if (rc != RC::OK) return rc;
            rc = shrink();
            if (rc != RC::OK) return rc;
        }
        // shrink 之后洞合并了，刚才搬不下去的 run 可能现在装得下（compact_file 的"第二遍"）：搬了就 MORE，
        // 下次调用再 checkpoint + shrink；搬不动 ⇒ 收工（有界：每次 MORE 都伴随一次真实搬运，run 只会往低处走）。
        if (tail_ > live_page_count() + 32) {
            rc = relocate_step_impl();
            if (rc != RC::OK) return rc;
        }
        return RC::OK;
    }
    RC consolidate_step_impl() {
        std::vector<ManEnt> delta;
        const u32 vmin = snap_max();
        std::vector<RunPtr> el;                      // 可合并：有页且不被快照钉住
        std::vector<u32> all_seq;
        u64 tot = 0;
        for (auto& kv : runs_) {
            if (!kv.second->npages) continue;
            all_seq.push_back(kv.second->seq);
            if (vmin && kv.second->ver <= vmin) continue;
            el.push_back(kv.second);
            tot += (u64)kv.second->npages * PAGE;
        }
        std::sort(all_seq.begin(), all_seq.end());
        std::sort(el.begin(), el.end(), [](RunPtr a, RunPtr b) { return a->seq < b->seq; });
        auto gap_between = [&](u32 a, u32 b) {
            auto it = std::upper_bound(all_seq.begin(), all_seq.end(), a);
            return it != all_seq.end() && *it < b;
        };
        // 在 seq 连续（中间不夹组外 run）的窗口里：先要**尽量长**（≤ lvl_t 条），同长度里挑**总页数最小**的 ——
        // 小 run 先并成大 run，大 run 之间最后再并，每条记录重写 ≈ log_{lvl_t} N 次。
        //（只按"总页数最小"会永远挑 2 条；只按"最老优先"会让第一组产物被后面每一步反复重写，N/lvl_t 次。）
        size_t b = 0, e = 0; u64 best = ~0ull; size_t blen = 0;
        for (size_t i = 0; i < el.size(); ++i) {
            u64 pg = el[i]->npages;
            for (size_t j = i + 1; j < el.size() && j - i < lvl_t_; ++j) {
                if (gap_between(el[j - 1]->seq, el[j]->seq)) break;
                pg += el[j]->npages;
                const size_t len = j - i + 1;
                if (len > blen || (len == blen && pg < best)) { blen = len; best = pg; b = i; e = j + 1; }
            }
        }
        if (e - b >= 2) {
            std::vector<RunPtr> grp(el.begin() + b, el.begin() + e);
            const bool whole = grp.size() == el.size();      // 这一组就是全部 run ⇒ 归并后库里没有任何被墓碑盖住的记录
            RC rc = merge_run_set(grp, delta, 0, false);
            if (rc != RC::OK) return rc;
            if (whole && nsnap_ == 0 && !ranges_.empty()) {   // 同 consolidate_impl(0)：顺手清墓碑 + 重写全量清单，收工
                clear_covered_ranges();
                delta.clear();
                rc = write_man_snapshot();
                if (rc != RC::OK) return rc;
                pend_.clear();
                promote_pending();
                return RC::OK;
            }
            if (delta.empty()) return RC::OK;
            if (!wait_io()) return RC::TIMEOUT;
            rc = commit_delta(delta);
            if (rc != RC::OK) return rc;
            promote_pending();
            return RC::MORE;
        }
        // 收尾：≤ 1 条可合并 run（或全被钉住隔开）。脏则重写一遍（和 consolidate(0) 同口径）。
        // 范围墓碑只有在"被盖住的记录已经物理消失"之后才能清：consolidate(0) 是先把**全部** run 归并一遍再清；
        // 这里最后一步可能一次归并都没做（上一步之后新来了 del_range，或者本来就只剩 1 条 run），
        // 所以有墓碑、无快照时也强制重写这条 run（g5 seed 3：清了墓碑没重写，rollback 后 [1381,1392) 复活）。
        bool rewritten = false;
        if (el.size() == 1) {
            u64 live = 0;
            for (auto& kv : cells_) live += kv.second->live;
            if (live * 2 < tot || (nsnap_ == 0 && !ranges_.empty())) {
                std::vector<RunPtr> one{el[0]};
                RC rc = merge_run_set(one, delta, 0, true);
                if (rc != RC::OK) return rc;
                rewritten = true;
            }
        }
        if (nsnap_ == 0 && !ranges_.empty() && (el.empty() || rewritten)) {   // 同 consolidate_impl(0)：墓碑清掉 ⇒ 必须重写全量清单
            clear_covered_ranges();
            delta.clear();
            RC rc = write_man_snapshot();
            if (rc != RC::OK) return rc;
            pend_.clear();
            promote_pending();
            return RC::OK;
        }
        if (delta.empty()) return RC::OK;
        if (!wait_io()) return RC::TIMEOUT;
        RC rc = commit_delta(delta);
        if (rc != RC::OK) return rc;
        promote_pending();
        return RC::OK;
    }
    // 搬一条 run（最靠后、且下方有装得下整块的空闲洞的那条）；搬了 ⇒ MORE，没得搬 ⇒ OK
    RC relocate_step_impl() {
        const u32 vmax = snap_max();
        std::vector<RunPtr> all;
        for (auto& kv : runs_) if (kv.second->npages && !(nsnap_ > 0 && kv.second->ver <= vmax)) all.push_back(kv.second);
        std::sort(all.begin(), all.end(), [](RunPtr a, RunPtr b) { return a->page0 < b->page0; });
        for (auto it = all.rbegin(); it != all.rend(); ++it) {
            RunPtr r = *it;
            bool lower = false;
            for (auto& kv : free_) {
                if (kv.first >= r->page0) break;
                if (kv.second >= run_block(r)) { lower = true; break; }
            }
            if (!lower) continue;
            std::vector<ManEnt> delta;
            std::vector<RunPtr> one{r};
            tr(TR_RELOC, r->page0, 0, run_block(r));
            RC rc = merge_run_set(one, delta, r->lvl, true);
            if (rc != RC::OK) return rc;
            if (delta.empty()) return RC::OK;
            if (!wait_io()) return RC::TIMEOUT;
            rc = commit_delta(delta);
            if (rc != RC::OK) return rc;
            promote_pending();
            return RC::MORE;
        }
        return RC::OK;
    }
    // force：全库只剩一条 run 且不脏时也重写（compact_file 第二遍靠它把高位链物化下来）
    RC consolidate_impl(u32 min_segs, bool force) {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        // P5（第 9 轮）：快照存活时不再整体 BUSY，只合并 **ver > 最新快照** 的 run（和 compact_pass / retire_dead_runs
        // 一个口径）。这些 run 任何视图都看不见、任何回退点都不需要，它们的旧页立刻可复用（run_page_safe）——
        // 快照期间新写入的垃圾就能收回来。ver <= snap_max 的 run 原样留着：合并它们要么丢掉某个较新快照还看得见的版本
        //（用 snap_min 当门槛的老坑），要么得按"相邻快照区间"分组合并 + 每组自己的墓碑视图 —— 收益小，没做。
        // 以前这里写的是 snap_min()，只因有 BUSY 门槛才没出事。
        if (RC r = maint_commit(); r != RC::OK) return r;
        std::vector<ManEnt> delta;
        const u32 vmin = snap_max();
        if (min_segs == 0) {
            std::vector<RunPtr> all;
            u64 tot = 0;
            for (auto& kv : runs_) {
                if (!kv.second->npages) continue;
                if (vmin && kv.second->ver <= vmin) continue;   // 某个快照还要读的版本：原样留着
                all.push_back(kv.second);
                tot += (u64)kv.second->npages * PAGE;
            }
            if (all.empty()) return RC::OK;
            // “脏不脏”必须用**精确**的存活字节判断：run->live_bytes 是合并时的
            // 布隆保守估计，只会高估，用它判断会让垃圾永远不被重写。
            recount_all_unknown();           // R6-lite：脏度要用精确账
            u64 live = 0;
            for (auto& kv : cells_) live += kv.second->live;
            bool dirty = live * 2 < tot;
            if (all.size() < 2 && !dirty && !force) return RC::OK;
            RC rc = merge_run_set(all, delta, 0, dirty || force);
            if (rc != RC::OK) return rc;
        } else {
            for (auto& kv : cells_) {
                Cell* c = kv.second;
                if (c->segs.size() < min_segs) continue;
                if (cell_has_old(c, vmin)) continue;
                RC rc = compact_cell(c, delta);
                if (rc != RC::OK) return rc;
            }
            retire_dead_runs(delta);           // 整条被压空的 run 顺手摘掉
        }
        // 全库归一时顺手清墓碑（覆盖的记录已经在归并里被丢掉了）。
        // 有快照时不成立：老快照仍要看到"当时还没删"的版本。
        if (min_segs == 0 && nsnap_ == 0 && !ranges_.empty()) {
            clear_covered_ranges();
            // 墓碑从清单里消失 ⇒ 必须重写一份全量清单，否则老清单页还会把它读回来
            delta.clear();
            RC rc = write_man_snapshot();
            if (rc != RC::OK) return rc;
            pend_.clear();
            promote_pending();                   // write_sb 已同步：提交点持久后才复用页
            return RC::OK;
        }
        if (delta.empty()) return RC::OK;
        if (!wait_io()) return RC::TIMEOUT;      // 合并前必须等旧页写完，但绝不无限等
        RC rc = commit_delta(delta);
        if (rc != RC::OK) return rc;
        promote_pending();
        return RC::OK;
    }

    // 当前真正被引用的最高页号 + 1（run + 清单链；超级块在 0/1）
    // 一条 run 占的**连续**页区间：数据 + meta + 溢出链清单（附件）
    static u32 run_block(const Run* r) { return r->npages + r->mnpg + r->aux_npg; }
    u32 live_top() {
        u32 top = 2;
        // 必须把 meta 页算进去：算漏了 shrink 就会把高水位截到 meta 页里，
        // 下一次分配从 tail_ 起就正好压在还活着的元数据页上（曾经真的踩过）。
        for (auto& kv : runs_) {
            RunPtr r = kv.second;
            top = std::max(top, r->page0 + run_block(r));
            // 溢出链不在 run 的连续块里，但它和 run 一样是活数据：
            // 漏算的话 shrink 会把高水位截到链中间，下一次写就压在链上（数据静默消失）。
            if (r->novfl) {
                ensure_ovfl_loc(r);
                for (auto& e : r->ovfl_loc) {
                    const u8* p = page(e.first);
                    if (!p) continue;
                    OvflDesc d = desc_of(pg_val_at(p, e.second));
                    top = std::max(top, d.pg0 + d.npages);
                }
            }
        }
        u32 pid = man_last_;
        for (u32 i = 0; i < nman_ && pid != NIL; ++i) {
            top = std::max(top, pid + 1);
            const u8* p = page(pid);
            pid = p ? rd32(p + 4) : (u32)NIL;
        }
        // 坑 74（g5 第一个种子第 303 步抓到的）：**未提交**的大值在 put 时就落成了链，只有内存表的描述符
        // 引用它。live_top()/rebuild_free() 以前只看 run 和清单 ⇒ shrink() 把高水位截到这种链下面、
        // 接着的分配把它盖掉 ⇒ 提交后 run 的描述符指向别人的页（NOTFOUND / CRC 错）。
        for_each_mem_chain([&](const OvflDesc& d) { top = std::max(top, d.pg0 + d.npages); });
        return top;
    }
    // 内存表里每一条溢出描述符（未提交的大值的链）
    template <class F> void for_each_mem_chain(F&& fn) const {
        for (const auto& e : mem_.entries())
            if (e.ovfl && e.len == 16) fn(desc_of(mem_.val(e)));
    }

    // 尾部回落：把高水位收回到“最高引用页”，文件随之收缩。
    // 前提是活页已经集中在低地址（配 consolidate() 使用），否则收益有限。
    RC shrink() {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (!wait_io()) return RC::TIMEOUT;
        promote_pending();                     // 待释放页先归位，别让它们假性抬高活区
        u32 top = live_top();
        // P5：快照期也能收尾。回退点需要的页 = 它的清单链（仍在当前链里 ⇒ live_top 算到；被 checkpoint 换掉 ⇒ deferred_）
        // + 它引用的 run / 溢出链（仍活着 ⇒ live_top；之后被释放 ⇒ ver <= snap_max 不是 snap_safe ⇒ deferred_）。
        // 所以 deferred_ 的上界一并算进去就够了；不必把 top 钉在 s.tail（那会让快照期间文件一页都收不回来：
        // s2 实测 used 575 / 实际占用 201）。回退时 tail_ 夹到设备长度（见 rollback）。
        for (auto& d : deferred_) top = std::max(top, d.second + d.first);
        if (top > tail_) top = tail_;
        if ((u64)top * PAGE >= (u64)dev_->capacity() * PAGE) return RC::OK;   // 已经不大了
        u32 old = tail_ > top ? tail_ : (u32)dev_->capacity();
        inval(top, old - top);                 // 落在收缩区间的缓存一律作废
        tr(TR_SHRINK, tail_, top);
        tail_ = top;
        rebuild_free();                        // 高于高水位的空闲区间自然消失
        if (dev_->truncate((PageId)top)) dev_pages_ = top;   // 设备不支持就只收紧分配器
        // 坑 82（g6）：shrink 不走 commit_delta，vers_ 没前移 ⇒ SB 会写进**上一个提交点同一个槽**。
        // 撕裂时两个槽里只剩更老的那个，而它引用的页早已随上一提交点释放、可能被复用。
        // 版本前移一格（等价于一次空的逻辑提交），SB 落到另一槽，上一提交点原样保留。
        ++vers_;
        return write_sb();                     // 新高水位落进提交点
    }

    // 搬家：把（通常只剩一条的）run 重写到尽可能低的空闲整块。
    // 归一会把旧空间整片释放，于是这一步总能落到文件前部 ⇒ 尾部才有得回落。
    // 崩溃安全：新副本写在“当前清单不引用的空闲页”上，旧 run 直到提交点才释放。
    RC relocate() {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        if (RC r = maint_commit(); r != RC::OK) return r;
        // P5：快照期只搬 ver > snap_max 的 run。搬老 run 是**正确**的（同 ver 同 seq，视图不变；旧页进 deferred_ 等回退用），
        // 但旧页要等快照全部释放才能复用、链也不能接管只能重写 —— 就是第 6 轮量到的"快照期空间 1.7×"。不值。
        const u32 vmax = snap_max();
        std::vector<RunPtr> all;
        for (auto& kv : runs_) if (kv.second->npages && !(nsnap_ > 0 && kv.second->ver <= vmax)) all.push_back(kv.second);
        if (all.empty()) return RC::OK;
        std::sort(all.begin(), all.end(), [](RunPtr a, RunPtr b) { return a->page0 < b->page0; });
        std::vector<ManEnt> delta;
        for (auto it = all.rbegin(); it != all.rend(); ++it) {   // 从最靠后的 run 往前搬
            RunPtr r = *it;
            // 只有“确实存在更低的空闲整块”才搬：否则白写一遍，还可能把活区抬高
            bool lower = false;
            for (auto& kv : free_) {
                if (kv.first >= r->page0) break;
                if (kv.second >= run_block(r)) { lower = true; break; }   // 要装得下整块（数据+meta+附件），不只是数据页
            }
            if (!lower) continue;
            std::vector<RunPtr> one{r};
            tr(TR_RELOC, r->page0, 0, run_block(r));
            RC rc = merge_run_set(one, delta, r->lvl, true);
            if (rc != RC::OK) return rc;
        }
        if (delta.empty()) return RC::OK;
        if (!wait_io()) return RC::TIMEOUT;
        RC rc = commit_delta(delta);
        if (rc != RC::OK) return rc;
        promote_pending();
        return RC::OK;
    }

    // 检查点：把清单重写成一份紧凑快照（顺带回收旧链）。清单页很会飘到高处，
    // 不收拾它，尾部回落会被几页清单卡住。
    RC checkpoint() {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        // P5：快照期也能重写清单。老清单链的页走 free_pages(snap_safe=false) ⇒ deferred_，回退点仍能从 s.man_last 重放。
        if (RC r = maint_commit(); r != RC::OK) return r;
        // 自愈：走过一次"没有 meta 的挂载"（老文件 / CRC 坏 / meta 被关掉）之后，
        // 这些 run 每次重开都要重新扫一遍。checkpoint 本来就要重写清单，
        // 顺手把它们用 merge_run_set 单跑搬一次 —— 新 run 自然带上 meta。
        // 只搬"确实缺 meta 且够大"的：小的扫几页比搬一遍便宜。
        heal_missing_meta(512);          // 每次 checkpoint 最多补 512 页数据的工作量
        RC rc = write_man_snapshot();
        if (rc != RC::OK) return rc;
        pend_.clear();
        promote_pending();
        return RC::OK;
    }

    // 元数据自愈：给"没有 meta 的活 run"补一份。
    // 优先**原地**补：meta 就贴在 page0+npages，只要那几页正好空闲就写进去，
    // 一个字节的数据都不用重写。拿不到连续空闲才退回重写整条 run（受页预算约束）。
    u32 heal_missing_meta(u32 page_budget) {
        if (!rmeta_mode_) return 0;
        u32 healed = 0, spent = 0;
        std::vector<u32> cand;                    // 先收集：merge_run_set 会改 runs_，不能边遍历边改
        const u32 vmax = snap_max();
        for (auto& kv : runs_) {
            RunPtr r = kv.second;
            if (r->mnpg) continue;
            if (r->npages < rmeta_min_) continue;
            if (nsnap_ > 0 && r->ver <= vmax) continue;   // P5：快照期不重写老 run（同 relocate 的理由）
            cand.push_back(r->page0);
        }
        for (u32 rid : cand) {
            if (spent >= page_budget) break;
            auto f = runs_.find(rid);
            if (f == runs_.end()) continue;
            RunPtr r = f->second;
            ensure_meta(r);                       // 先把派生数组准备好（顺便可能就命中了）
            if (r->mnpg) continue;
            u32 mn = rmeta_pages(rmeta_size(r));
            const u32 want = r->page0 + r->npages;
            auto it = free_.find(want);            // 贴着的空闲整块（coalesce 过后是唯一的键）
            if (it != free_.end() && it->second >= mn && want + mn <= tail_) {
                const u32 blk = it->second;            // erase 之后 it 就失效了，必须先存
                free_.erase(it);
                if (blk > mn) free_[want + mn] = blk - mn;
                u64 w = 0;
                // build_rmeta 会把 r->mnpg 写进自我描述字段（selfpg），
                // 所以必须先设好再写，否则加载时的自校验会把这份 meta 判成坏的。
                r->mnpg = mn;
                if (write_rmeta(r, want, nullptr, w) == RC::OK) {
                    r->mpage = want;
                    ++healed; spent += mn;
                    continue;
                }
                r->mnpg = 0;
                free_[want] = it->second;         // 写失败：还回去
                coalesce();
            }
            std::vector<ManEnt> d;
            std::vector<RunPtr> one{r};
            u32 npg = r->npages;
            if (merge_run_set(one, d, r->lvl, true) == RC::OK) { ++healed; spent += npg; }
        }
        return healed;
    }

    // 一条命令把空间还给文件系统：归一 → 搬家 → 清单检查点 → 尾部回落
    // 整库紧凑：归一 → 搬 run → 清单快照 → 截尾。
    // 大值库的硬伤（第 6 轮遗留：66000×3900 B 库 compact_file 后 +31%）：
    // 归一时链是零写接管的，所以**链从不移动**；高水位被散在高位的链钉住，截不下来。
    // 现在分两遍：
    //   第一遍：全部接管（零写）。跑完之后 free_ 里就是全部的洞，live_page_count() = 真实活页 L。
    //   第二遍：T = L + 余量。只把末页 > T 的链物化（读一遍、写到低位的洞里），T 以下的照旧接管；
    //           旧 run 释放后高位整段空出，relocate 再把新 run 块搬下来，shrink 截到 ≈ T。
    // 代价与收益成正比：只重写"必须搬的那些链"。洞比链小时（链长不一）这遍搬不完，最多再补一遍；
    // 剩下的就是碎片，诚实地留着（used/live 打印在 bench6 cfcurve 里）。
    RC compact_file() {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        auto pass = [&](bool force) -> RC {
            RC rc = consolidate_impl(0, force);
            if (rc != RC::OK) return rc;
#ifdef FCS_TRACE
            std::fprintf(stderr, "  CF after consolidate tail=%u runs=%zu ext=%zu limit=%u\n", tail_, runs_.size(), free_.size(), take_limit_);
#endif
            rc = relocate();
            if (rc != RC::OK) return rc;
#ifdef FCS_TRACE
            std::fprintf(stderr, "  CF after relocate    tail=%u runs=%zu ext=%zu\n", tail_, runs_.size(), free_.size());
#endif
            rc = checkpoint();
            if (rc != RC::OK) return rc;
#ifdef FCS_TRACE
            std::fprintf(stderr, "  CF after checkpoint  tail=%u top=%u nman=%u man_last=%u runs=%zu\n", tail_, live_top(), nman_, man_last_, runs_.size());
#endif
            rc = shrink();
#ifdef FCS_TRACE
            std::fprintf(stderr, "  CF after shrink      tail=%u rc=%s\n", tail_, rc_str(rc));
#endif
            return rc;
        };
        struct ManHigh { bool& f; explicit ManHigh(bool& x) : f(x) { f = true; } ~ManHigh() { f = false; } } mh(man_high_);
        RC rc = pass(false);
        if (rc != RC::OK) return rc;
        // 判据用 live_page_count()（活页 = 高水位 − 空闲），它**算上溢出链**：
        // 用 live_pages()（只算 run 自身的数据页）会永远判定"还有很大空间可收"。
        for (int i = 0; i < 2 && tail_ > live_page_count() + 32; ++i) {
            const u32 T = (u32)std::min<u64>(live_page_count() + 32, NIL - 1);
            // 只有确实有链钉在 T 之上才强制重写（物化它们）；否则就是普通的"再搬一次 run"
            //（没有大值的库也会走到这里：第一遍 relocate 时洞还比 run 块小，第二遍才搬得下去）。
            // 无条件 force 会让小库每次 compact_file 多白写一遍整条 run（s2 长跑实测写页 +23%）。
            // 第二种值得 force 的情形：顶部 run 块正下方有个大洞，却比块小一点（b1：30155 vs 30890 页）。
            // 直接搬搬不下去；强制重写一次会先落到尾部，再由 relocate 落进合并后的大洞 —— 2 次重写换回
            // 整个洞。只在洞 ≥ 32 页且 ≥ 块的 1/8 时做，小洞不值得（s2 长跑实测无条件 force 写页 +23%）。
            u32 blk = 0;
            const u32 gain = bounce_gain(blk);
            const bool need = chain_top() > T || (gain >= 32 && (u64)gain * 8 >= blk);
            take_limit_ = need ? T : NIL;
            rc = pass(need);
            take_limit_ = NIL;
            if (rc != RC::OK) return rc;
        }
        // 收尾：清单页只能落在"分配那一刻"的空闲页上，而紧贴 run 块上方的旧清单页要等新页写完才释放，
        // 所以 checkpoint 之后清单页往往比最紧位置高 1–2 页、下面留一个小洞（每轮多 1 页）。
        // 能再低就再写一次（1 页 + SB），把洞收掉。
        for (int i = 0; i < 2 && man_can_drop(); ++i) {
            rc = checkpoint();
            if (rc != RC::OK) return rc;
            rc = shrink();
            if (rc != RC::OK) return rc;
        }
        return rc;
    }
    // 顶部 run 块正下方那个空闲洞的大小（没有 ⇒ 0）；blk 带出该块大小
    u32 bounce_gain(u32& blk) const {
        const Run* top = nullptr;
        for (auto& kv : runs_) if (kv.second->npages && (!top || kv.second->page0 > top->page0)) top = kv.second;
        if (!top) { blk = 0; return 0; }
        blk = run_block(top);
        for (auto& kv : free_) if (kv.first + kv.second == top->page0) return kv.second;
        return 0;
    }
    // 清单链只有一页、且最高 run 块之上存在比它更低的空闲页 ⇒ 重写一次就能更紧
    bool man_can_drop() const {
        if (nman_ != 1 || man_last_ == NIL) return false;
        u32 base = 2;
        for (auto& kv : runs_) base = std::max(base, kv.second->page0 + run_block(kv.second));
        for (auto& kv : free_) {
            const u32 p0 = kv.first, n = kv.second;
            if (p0 >= tail_) break;
            if (p0 + n <= base) continue;
            return std::max(p0, base) < man_last_;
        }
        return false;
    }
    // 所有溢出链里最高的末页（没有链 ⇒ 0）
    u32 chain_top() {
        u32 top = 0;
        for (auto& kv : runs_) {
            RunPtr r = kv.second;
            if (!r->novfl) continue;
            ensure_ovfl_loc(r);
            for (auto& e : r->ovfl_loc) {
                const u8* p = page(e.first);
                if (!p) continue;
                OvflDesc d = desc_of(pg_val_at(p, e.second));
                top = std::max(top, d.pg0 + d.npages);
            }
        }
        return top;
    }

    // 组提交里“已逻辑提交但未落盘”的数据不能丢 ⇒ 先把攒的批真正提交，再清空工作区
    RC abort() {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (gpend_) {
            RC rc = commit_locked(true);   // 持锁内部提交：不跑提交后维护循环
            if (rc != RC::OK) return rc;
        }
        for (const auto& e : mem_.entries()) drop_mem_chain(e);   // 坑 73：未提交大值的链随之归还
        mem_.clear();
        if (!pend_ranges_.empty()) {        // 坑 76：未提交的范围墓碑已登记进 ranges_ ⇒ 按盘重建才能干净撤掉
            pend_ranges_.clear();
            RC rc = reload();
            if (rc != RC::OK) return rc;
        }
        return RC::OK;
    }
    RC sync() { return commit(); }
    u32 pending_commits() const { return gpend_; }

    // ------------------------------------------------------------ 快照 / 回退
    RC snapshot() {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (nsnap_ >= MAX_SNAP) return RC::FULL;
        // 快照点 = 一个**持久提交点**。以前只抓 pend_（超级块内联增量），不抓 mem_ 里的逻辑提交、
        // 也不抓 pend_delta_ 里"后台已落页、未入账"的 run ⇒ commit(false) 之后立刻 snapshot，
        // 回退会把这些已对读者可见的写丢掉（坑 69）。先 commit() 再抓，语义才闭合。
        // 第 12 轮：这里必须是 commit_locked 而不是 commit() —— mode 1 的 commit() 在提交点之后还会跑维护单元，
        // 维护释放的源页会进 pending_free_、产物进 pend_delta_（都不属于刚落盘的提交点）；快照若在那之后抓
        // pending_free_，回退时就把仍被清单引用的源页当成"待归位"的页 ⇒ verify "page owned twice"（g5 种子 2）。
        if (RC rc = commit_locked(true); rc != RC::OK) return rc;
        tr(TR_SNAP, vers_, tail_, man_last_, (u16)nsnap_);
        Snap& s = snaps_[nsnap_++];
        s.vers = vers_; s.tail = tail_;
        s.man_last = man_last_; s.nman = nman_; s.man_first = man_first_;
        s.pend = pend_;
        s.pending_free = pending_free_;
        s.deferred = deferred_;
        man_new_.clear();                 // 到此为止的清单页都进了这个回退点的链
        return RC::OK;
    }

    // 释放全部快照 ⇒ 允许回收页（回退点消失后，旧页才可以复用）
    RC forget_snapshots() {
        WGuard g(this); if (g.busy) return RC::BUSY;
        nsnap_ = 0;
        man_new_.clear();
        prune_tombs();                      // 坑 93：快照期为老视图多留的墓碑现在可以剪掉
        // 延迟页现在真的可以回来了。注意：
        //  - 越过高水位的页不用管（本来就能靠增长拿到）；
        //  - 与现有空闲块重叠时以"挖掉"为准（carve），否则会同一页记两次。
        if (sb_gen_ < def_need_gen_) {     // 坑 99：有延迟页的 DEL 还没过提交点 ⇒ 整表转进 pending_free_，等下一个 SB
            for (auto& p : deferred_) pending_free_.push_back(p);
            deferred_.clear();
            pend_need_gen_ = std::max(pend_need_gen_, def_need_gen_);
            promote_pending();
            return RC::OK;
        }
        for (auto& p : deferred_) {
            u32 p0 = p.second, n = p.first;
            if (p0 >= tail_) continue;
            if ((u64)p0 + n > tail_) n = tail_ - p0;
            if (dev_) for (u32 i = 0; i < n; ++i) dev_->erase((PageId)(p0 + i));
            carve_free(p0, n);              // 先挖掉重叠部分，再整块放回
            free_[p0] = n;
        }
        deferred_.clear();
        coalesce();
        promote_pending();
        return RC::OK;
    }

    // O(1) 回退：指针回退 + 清单截断（不重写任何数据页）
    RC rollback(u32 id) {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (id >= nsnap_) return RC::INVALID;
        // 在飞的数据页先落地，再按快照重建（等不到就报 TIMEOUT，绝不带着半页重建）
        if (!wait_io()) return RC::TIMEOUT;
        Snap s = snaps_[id];
        const u32 cur = vers_;        // 回退前的逻辑时钟：必须保持单调

#ifdef FCS_TRACE
        std::fprintf(stderr, "  ROLLBACK id=%u -> vers=%u tail=%u man_last=%u nman=%u pend=%zu\n",
                     id, s.vers, s.tail, s.man_last, s.nman, s.pend.size());
#endif
        tr(TR_ROLLBACK, s.vers, s.tail, s.man_last, (u16)std::min<u32>(id, 0xFFFFu));
        mem_.clear();
        vers_ = s.vers; tail_ = s.tail;
        man_last_ = s.man_last; nman_ = s.nman; man_first_ = s.man_first;
        pend_ = s.pend;                 // 位置下标不可靠（中途可能被写进清单页），要按内容还原
        pend_delta_.clear();            // 这些段属于被回退掉的分支
        nsnap_ = id;
        man_new_.clear();               // 快照之后分配的清单页随这条分支一起作废（rebuild_free 会把它们当空闲）
        RC rc = reload();
        if (rc != RC::OK) return rc;
        // reload 会按盘重建 free_，但要还原“尚未归位”的两张表：
        //   pending_free_ = 快照时刻还没 promote 的页（它们仍在被当前状态引用）
        //   deferred_     = 快照时刻因更早的快照而延迟回收的页
        pending_free_ = s.pending_free;   // 这些页不属于回退后的状态，等下一个提交点归位
        deferred_ = nsnap_ > 0 ? s.deferred : std::vector<std::pair<u32, u32>>{};   // 没有更早的快照 ⇒ 延迟页可以归位
        pend_need_gen_ = def_need_gen_ = sb_gen_ + 1;   // 保守：都等回退后的第一个提交点
        tail_ = s.tail;
        // P5：快照期 shrink 可能把设备截到 s.tail 之下（回退点需要的页都还在，见 shrink）。回退恢复的是**状态**不是文件
        // 长度：高水位夹到设备长度即可，不必把文件撑回去。
        if (tail_ > dev_pages_) tail_ = dev_pages_;
        rebuild_free();                   // 空闲表按“回退后的状态”重建；两张表在里面 carve（坑 87）
        // 逻辑时钟只前进不后退：回退的是**状态**，不是历史。
        // 否则另一个超级块槽里“版本更高的旧分支”会在下次挂载时胜出，把回退结果整条复活。
        vers_ = cur + 1;
        return write_sb();
    }

    // ------------------------------------------------------------ 校验
    // 精确判断一条 run 里是否还剩"没被更新版本覆盖"的记录。
    // 回收前用它复核（run 级计数是增量维护的提示值，宁可多扫一遍也不能误删）。
    // 精确重算一条 run 的存活记录数（run 级计数是提示值，必要时用它校准）
    // 注意：newer_has 内部会读别的页（page() 是**直映缓存**，会覆盖当前缓冲），
    // 所以必须先把自己这一页拷出来，再逐条判定。
    // 整条 run 的键域 [first,last] 被同一条范围墓碑（ver > run.ver）盖住 ⇒ 一条都不活，一页都不用读。
    bool run_fully_hidden(const Run* r) const {
        if (ranges_.empty() || r->nrec == 0) return false;
        ensure_maxhi();
        auto it = ranges_.upper_bound({r->first, ~0u});
        while (it != ranges_.begin()) {
            --it;
            const RangeTomb& t = it->second;
            if (t.maxhi <= r->first) return false;
            if (t.lo <= r->first && t.hi > r->last && t.ver > r->ver) return true;
        }
        return false;
    }
    u32 exact_live_recs(RunPtr r, bool early_out = false) {
        // 校准必须和归并口径一致：范围墓碑盖住的记录也是死的。以前这里只看"有没有更新版本"，
        // 于是被 del_range 盖住的整条 run 每次提交都被"校准"回 live=nrec，永远不退休，
        // 而且每次提交都把它全部页重扫一遍（坑 63：长删循环 runs 20→138、del 提交 2→68 ms）。
        if (run_fully_hidden(r)) return 0;
        // 坑 92（第 11 次讨论，storm r）：只数**仍被某个单元的段引用**的键域。单元压实把某个键整个丢掉之后
        //（最新版本被范围墓碑盖住 ⇒ 归并不 emit，旧副本/点墓碑作为"同键旧副本"跳过），老 run 里那些记录物理上
        // 还在页里，但已经不在任何段的键域内 —— 对任何视图都不可见。以前整条 run 逐页扫，把这种悬空点墓碑
        //（没有更新版本、len==0）算成 live=1 ⇒ 全死的 run 被"校准"成永不退休（188 页拖到探针结束），
        // verify 报 `run live recs`（它的口径 = 逐单元归并，只看段内）。顺带：扫描量从 npages 降到被引用的页。
        struct Span { u64 klo, khi; u32 p0, p1; };
        std::vector<Span> spans;
        const u64 sk = seg_key(r->seq, r->page0);
        for (auto& kv : cells_) {
            auto f = kv.second->segs.find(sk);
            if (f == kv.second->segs.end()) continue;
            const Seg& sg = f->second;
            if (sg.p0 >= sg.p1 || sg.klo >= sg.khi) continue;
            spans.push_back({sg.klo, sg.khi, sg.p0, std::min(sg.p1, r->npages)});
        }
        if (spans.empty()) return 0;                 // 没有任何单元引用 ⇒ 按定义全死
        u32 n = 0;
        for (const Span& sp : spans) {
            bool past = false;
            for (u32 i = sp.p0; i < sp.p1 && !past; ++i) {
                const u8* src = page(r->page0 + i);
                if (!src) return r->nrec;
                std::vector<u8> buf(src, src + PAGE);
                const u8* p = buf.data();
                u16 used = rd16(p + 34);
                if (used < DHDR || used > PAGE) return r->nrec;
                u8 pf = pg_pfx(p);
                u32 off = DHDR;
                while (off + pg_rec_size(pf, 0) <= used) {
                    RecHdr h;
                    rd_rec(p, off, h);
                    u32 rs = pg_rec_size(pf, h.len);
                    if (off + rs > used) break;
                    off += rs;
                    if (h.key < sp.klo) continue;                 // 边界页：键域外的记录属于邻单元的段
                    if (h.key >= sp.khi) { past = true; break; }  // run 内键有序：本段到头
                    // 统一口径（坑 79/95）：被**更新的**范围墓碑盖住的记录——包括点墓碑——都是死的
                    if (!range_hidden(h.key, r->ver, 0xFFFFFFFFu) && !newer_has(h.key, r->seq, r->page0)) {
                        ++n; if (early_out) return n;
                    }
                }
            }
        }
        return n;
    }
    bool run_has_live(RunPtr r) { return exact_live_recs(r, true) > 0; }


    // 见 private 里的 scrub_impl
    // 坑 85（g7 第一次跑就抓到）：以前这里**不拿 mtx_**。单线程下无感；有并发读者时 scrub 的 page()/ensure_ovfl_loc
    // 与读者的页缓存操作互踩，把好页判成 CORRUPT。公开入口一律持锁；要"后台轻量扫"就用 budget_bytes 分多次来。
    RC scrub(u32* bad = nullptr, u32* first = nullptr, u64 budget_bytes = 0) {
        WGuard g(this); if (g.busy) return RC::BUSY;
        return scrub_impl(bad, first, budget_bytes);
    }

    RC verify(Report* out = nullptr) {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        settle_ranges();                 // 未提交的范围墓碑已生效：先把存活账结清再对账
        recount_all_unknown();           // R6-lite：惰性账先补齐，再精确对账
        Report rep;
        // 1) 段：CRC / 有序 / 版本
        for (auto& kv : runs_) {
            RunPtr r = kv.second;
            ensure_meta(r);
            if (r->npages == 0) verr(rep, "empty run");
            if (r->page0 + r->npages > cap_) verr(rep, "run range");
            if (r->fences.size() != r->npages || r->pbytes.size() != r->npages) verr(rep, "fence count");
            u64 prev = 0; bool first = true;
            for (u32 i = 0; i < r->npages; ++i) {
                const u8* p = page(r->page0 + i);
                if (!p) { verr(rep, "run page"); break; }
                if (rd32(p) != PK_DATA) { verr(rep, "page kind"); break; }
                u16 used = rd16(p + 34);
                if (used > PAGE || used < DHDR) { verr(rep, "page used"); break; }
                if (crc32c(p + 12, used - 12) != rd32(p + 8)) verr(rep, "page crc");
                if (i < r->fences.size() && r->fences[i] != *(const u64*)(p + 16)) verr(rep, "fence");
                if (i < r->pbytes.size() && r->pbytes[i] != used - DHDR) verr(rep, "page bytes");
                u8 pf = pg_pfx(p);
                u32 off = DHDR;
                while (off + pg_rec_size(pf, 0) <= used) {
                    RecHdr h;
                    rd_rec(p, off, h);
                    u32 rs = pg_rec_size(pf, h.len);
                    if (off + rs > used) { verr(rep, "rec len"); break; }
                    if (!first && h.key < prev) verr(rep, "run unsorted", h.key);
                    if (r->ver > vers_) verr(rep, "future ver", h.key);
                    prev = h.key; first = false;
                    ++rep.recs;
                    if (h.len == OVFL_MARK) {
                        // 溢出链：页头 + 每页 CRC + 总长度 + 链尾。
                        // 注意：read_ovfl 会去读别的页 ⇒ **p 立刻失效**（page() 的指针契约）。
                        // 所以先把 16 B 描述符拷出来，读完再重新取本页指针。
                        u8 dsc[16];
                        std::memcpy(dsc, pg_val_at(p, off), 16);
                        OvflDesc d = desc_of(dsc);
                        ++rep.ovfl;
                        if (d.npages == 0 || d.pg0 < 1 || (u64)d.pg0 + d.npages > cap_) {
                            verr(rep, "ovfl range", h.key);
                        } else {
                            rep.ovfl_pages += d.npages;
                            std::vector<u8> tmp(d.total ? d.total : 1);
                            if (read_ovfl(d, tmp.data(), (u32)tmp.size(), nullptr, false) != RC::OK)   // 看介质，绕过链缓存
                                verr(rep, "ovfl data", h.key);
                            p = page(r->page0 + i);           // 重新定位本页
                            if (!p) { verr(rep, "run page"); break; }
                        }
                    }
                    off += rs;
                }
            }
        }
        // 2) 目录：有序不重叠 + 区间覆盖 + 字节一致
        u64 last_hi = 0;
        for (auto& kv : cells_) {
            Cell* c = kv.second;
            ++rep.cells;
            if (c->lo >= c->hi) verr(rep, "cell range");
            if (c->lo < last_hi) verr(rep, "cells overlap");
            last_hi = c->hi;
            rep.segs += (u32)c->segs.size();
            u64 pg = 0;
            for (auto& sg : c->segs) {
                RunPtr r = runs_[sg.second.rid];
                if (!r) { verr(rep, "dangling seg"); continue; }
                if (sg.second.p0 >= sg.second.p1) verr(rep, "empty seg");
                if (sg.second.p1 > r->npages) verr(rep, "seg range");
                pg += sg.second.p1 - std::min(sg.second.p1, r->npages);
                pg += std::min(sg.second.p1, r->npages) - sg.second.p0;
            }
            if (pg != c->pages) verr(rep, "cell pages");
            if (c->live > c->bytes() || c->live + c->dead != c->bytes()) {
#ifdef FCS_TRACE
                std::fprintf(stderr, "  LIVENESS cell [%llu,%llu) bytes=%llu live=%llu dead=%llu\n",
                    (unsigned long long)c->lo, (unsigned long long)c->hi,
                    (unsigned long long)c->bytes(), (unsigned long long)c->live, (unsigned long long)c->dead);
#endif
                verr(rep, "cell liveness");
            }
            rep.bytes += c->bytes();
            rep.live += c->live;
            rep.pages += c->pages;
        }
        if (cells_.empty()) verr(rep, "empty directory");
        else {
            if (cells_.begin()->second->lo != 0) verr(rep, "directory start");
            if (cells_.rbegin()->second->hi != ~0ull) verr(rep, "directory end");
        }
        // 3) 精确 live 复核（归并每个单元，与增量记账对照）
        std::map<u32, u64> live_per_run;
        for (auto& kv : cells_) {
            Cell* c = kv.second;
            std::vector<Cur> cs;
            for (auto& sg : c->segs) {
                RunPtr r = runs_[sg.second.rid];
                if (!r || sg.second.p0 >= sg.second.p1) continue;
                cs.emplace_back();
                cs.back().r = r;
                cs.back().p0 = sg.second.p0;
                cs.back().p1 = std::min(sg.second.p1, r->npages);
                cs.back().klo = sg.second.klo;
                cs.back().khi = sg.second.khi;
                cs.back().load(this);
            }
            u64 live = 0;
            const bool vdbg = std::getenv("FCS_VERIFY_DBG") != nullptr;
            merge_emit(c, cs, [&](u64 k, u32 vv, const u8*, u16 l, u32 osz, RunPtr src, const u8*) {
                live += osz;
                if (src) ++live_per_run[src->page0];     // run 级存活记录数（精确）
                if (vdbg) std::fprintf(stderr, "  VLIVE cell=%llu key=%llu ver=%u len=%u osz=%u rid=%u\n", (unsigned long long)c->lo, (unsigned long long)k, vv, l, osz, src ? src->page0 : 0);
                return true;
            }, false);                                   // 只算账，不读大值
            if (live != c->live) {
                verr(rep, "live mismatch", c->lo);
                if (std::getenv("FCS_VERIFY_DBG"))
                    std::fprintf(stderr, "  live mismatch cell [%llu,%llu) counted=%llu acct=%llu segs=%zu\n",
                        (unsigned long long)c->lo, (unsigned long long)c->hi, (unsigned long long)live,
                        (unsigned long long)c->live, c->segs.size());
            }
            u64 total = total_rec_bytes(c);
            if (total != c->live + c->dead) verr(rep, "dead mismatch", c->lo);
        }
        // 4) run 级存活账必须和"逐单元归并出来的引用数"逐条对上。
        //    这是空间放大不收敛的根因检测点：账错了 ⇒ 该回收的 run 永远不回收。
        for (auto& kv : runs_) {
            u64 want = 0;
            auto it = live_per_run.find(kv.first);
            if (it != live_per_run.end()) want = it->second;
#ifdef FCS_VERR_DBG
            if (kv.second->live_recs != want) {
                for (auto& cc : cells_)
                    std::fprintf(stderr, "    CELL [%llu,%llu) segs=%zu\n",
                                 (unsigned long long)cc.second->lo, (unsigned long long)cc.second->hi,
                                 cc.second->segs.size());
                for (auto& cc : cells_) {
                    auto f = cc.second->segs.find(seg_key(kv.second->seq, kv.second->page0));
                    if (f == cc.second->segs.end()) continue;
                    std::fprintf(stderr, "    SEG cell=%llu rid=%u live=%u p0=%u p1=%u klo=%llu khi=%llu\n",
                                 (unsigned long long)cc.first, f->second.rid, f->second.live,
                                 f->second.p0, f->second.p1,
                                 (unsigned long long)f->second.klo, (unsigned long long)f->second.khi);
                }
                std::fprintf(stderr, "--- runs at mismatch ---\n");
                for (auto& q : runs_)
                    std::fprintf(stderr, "  RUN rid=%u seq=%u lvl=%u npg=%u nrec=%u live=%u first=%llu last=%llu\n",
                                 q.second->page0, q.second->seq, q.second->lvl, q.second->npages,
                                 q.second->nrec, q.second->live_recs,
                                 (unsigned long long)q.second->first, (unsigned long long)q.second->last);
            }
            if (kv.second->live_recs != want)
                std::fprintf(stderr, "  VERR run=%u stored=%u want=%llu nrec=%u seq=%u lvl=%u\n",
                             kv.second->first, kv.second->live_recs, (unsigned long long)want,
                             kv.second->nrec, kv.second->seq, kv.second->lvl);
#endif
            if (kv.second->live_recs != want) verr(rep, "run live recs", kv.second->first);
        }
        for (auto& kv : runs_) {
            const u32 slow = count_refs(kv.first);
            if (slow == 0) verr(rep, "leaked run");
            if (slow != kv.second->refs) verr(rep, "run refs", kv.second->first);      // R0：refs 与慢路数出来的不一致
            if (kv.second->lvl > LVL_MAX) verr(rep, "run lvl", kv.second->first);      // 坑 89：层号越过 LVL_MAX 就没人合并它
        }
        // 5) 页所有权（A2）：[2, tail_) 里每一页恰好有一个主人。
        ownership_check(rep);
        rep.runs = (u32)runs_.size();
        if (out) *out = rep;
        last_rep_ = rep;
        return rep.errors ? RC::CORRUPT : RC::OK;
    }

    // 页所有权不变量（A2）。每一页 ∈ [2, tail_) 必须恰好属于下列之一：
    //   run 块（数据 + meta + 附件）/ 溢出链 / 清单链 / 空闲表 / 延迟回收（deferred_）/ 待提交回收（pending_free_）。
    // "属于两个主人"= 双重释放或重叠（坑 68 那种两条 run 共页，以前要等到丢键才暴露）；
    // "没有主人"= 泄漏（既不活也不在任何空闲账上，重开后 rebuild_free 会悄悄把它当空闲 —— 那是另一种双主）。
    // 代价：一张 tail_ 字节的位图 + 每条溢出链读一页描述符（s2 规模 < 1 ms），所以 verify() 默认就跑。
    // 单独调用（不做归并复核）给 g5 这类"每一步都查"的测试用。
    RC verify_ownership(Report* out = nullptr) {
        WGuard g(this); if (g.busy) return RC::BUSY;
        if (RC r = ensure_ready(); r != RC::OK) return r;
        Report rep;
        ownership_check(rep);
        if (out) *out = rep;
        return rep.errors ? RC::CORRUPT : RC::OK;
    }
private:
    void ownership_check(Report& rep) {
        if (tail_ < 2 || tail_ > cap_) { if (tail_ > cap_) verr(rep, "tail beyond cap"); return; }
        std::vector<u8> own(tail_, 0);
        u32 twice = 0, beyond = 0;
        auto claim = [&](u32 p0, u32 n, u8 kind) {
            for (u32 i = 0; i < n; ++i) {
                const u64 p = (u64)p0 + i;
                if (p >= tail_) { ++beyond; return; }
                if (own[p]) {
                    if (twice++ == 0) {
                        verr(rep, "page owned twice", p);
#ifdef FCS_TRACE
                        std::fprintf(stderr, "  OWNER twice: page %llu first=%u now=%u (range [%u,+%u))\n",
                                     (unsigned long long)p, own[p], kind, p0, n);
#endif
                    }
                    return;
                }
                own[p] = kind;
            }
        };
        for (auto& kv : runs_) {
            RunPtr r = kv.second;
            ensure_aux(r);
            claim(r->page0, run_block(r), 1);
            std::vector<std::pair<u32, u32>> ex;
            collect_ovfl(r, ex);
            for (auto& e : ex) claim(e.first, e.second, 2);
        }
        if (man_last_ != NIL) {
            u32 pid = man_last_;
            for (u32 i = 0; i < nman_ && pid != NIL; ++i) {
                claim(pid, 1, 3);
                const u8* p = page(pid);
                pid = p ? rd32(p + 4) : (u32)NIL;
            }
        }
        for (auto& kv : free_) {
            if (kv.first >= tail_) continue;
            claim(kv.first, std::min<u32>(kv.second, tail_ - kv.first), 4);
        }
        for (auto& e : deferred_) if (e.second < tail_) claim(e.second, std::min<u32>(e.first, tail_ - e.second), 5);
        for (auto& e : pending_free_) if (e.second < tail_) claim(e.second, std::min<u32>(e.first, tail_ - e.second), 6);
        for_each_mem_chain([&](const OvflDesc& d) { claim(d.pg0, d.npages, 7); });   // 未提交大值的链（坑 74）
        u32 unowned = 0; u64 first_un = 0;
        for (u32 p = 2; p < tail_; ++p) if (!own[p]) { if (unowned++ == 0) first_un = p; }
        if (unowned) {
            verr(rep, "page unowned", first_un);
#ifdef FCS_TRACE
            std::fprintf(stderr, "  OWNER unowned: %u pages, first=%llu tail=%u\n", unowned, (unsigned long long)first_un, tail_);
#endif
        }
        if (beyond) verr(rep, "owner beyond tail");
    }

private:
    // ------------------------------------------------------------ 清单项
    struct ManEnt {
        u8 op = 0;
        u8 lvl = 0;               // 借用 op 后的填充字节，不增加记录长度
        u64 key = 0, last = 0;
        u32 page0 = 0, npages = 0, ver = 0, nbytes = 0, seq = 0;
    };
    static void encode_man(u8* e, const ManEnt& m) {
        std::memset(e, 0, MENT);
        e[0] = m.op;
        e[1] = m.lvl;
        std::memcpy(e + 4, &m.ver, 4);
        std::memcpy(e + 8, &m.key, 8);
        std::memcpy(e + 16, &m.last, 8);
        std::memcpy(e + 24, &m.page0, 4);
        std::memcpy(e + 28, &m.npages, 4);
        std::memcpy(e + 32, &m.nbytes, 4);
        std::memcpy(e + 36, &m.seq, 4);
    }
    static ManEnt decode_man(const u8* e) {
        ManEnt m;
        m.op = e[0];
        m.lvl = e[1];
        std::memcpy(&m.ver, e + 4, 4);
        std::memcpy(&m.key, e + 8, 8);
        std::memcpy(&m.last, e + 16, 8);
        std::memcpy(&m.page0, e + 24, 4);
        std::memcpy(&m.npages, e + 28, 4);
        std::memcpy(&m.nbytes, e + 32, 4);
        std::memcpy(&m.seq, e + 36, 4);
        return m;
    }

    // ------------------------------------------------------------ 只读页缓存（两路组相联）
    // 直映缓存的问题：归并/压实一次同时摸 k 条 run 的页，只要两条 run 的当前页同余，
    // 就会互相踢出对方 —— 每换一页都是一次完整读，k 路归并的读放大直接从 1 变成 2。
    // 两路足够盖住这种“同余撞车”（三个以上流同时撞同一个集合才会退化）。
    // 契约不变：**指针只活到下一次 page()**（调用方要留住就必须自己拷）。
    // ------------------------------------------------------------ 页缓存（两路组相联）
    // P1 之后读者可以并行：
    //   * 独占模式（写者 / 关闭共享读）：老路，普通读写，零原子开销；
    //   * 共享模式：风险指针协议 —— 每线程只会同时持有**一个** page() 指针（契约：指针活到下一次 page()），
    //     所以每个线程槽里一个 pin 就够。命中：先发布 pin，再复核 pid（Dekker 配对）；踢页：先把 pid 置 NIL，
    //     再扫所有线程槽的 pin，有人钉着就换另一路，两路都被钉着就读进本线程的私有页缓冲（不进缓存）。
    //     组内互斥用一个字节自旋锁，只有未命中才拿；LRU 退化成每组一个 MRU 位（两路时等价于真 LRU）。
    struct CacheEnt { std::atomic<u32> pid{NIL}; std::vector<u8> buf; };
    struct alignas(64) CSet { std::atomic<u8> lk{0}; std::atomic<u8> mru{0}; };
    static void set_lock(CSet& c) { while (c.lk.exchange(1, std::memory_order_acquire)) std::this_thread::yield(); }
    static void set_unlock(CSet& c) { c.lk.store(0, std::memory_order_release); }
    bool pinned_by_other(u32 slot, const Tls* me) const {     // me == nullptr ⇒ 谁钉着都算（prefetch 不能踢自己正拿着的页）
        const u32 n = TlsIdPool::inst().hwm.load(std::memory_order_acquire);
        for (u32 i = 0; i < n; ++i)
            if (&tls_[i] != me && tls_[i].pin.load(std::memory_order_seq_cst) == slot) return true;
        return false;
    }
    const u8* page(u32 pid) {
        if (pid >= cap_) return nullptr;
        if (!wait_page(pid)) return nullptr;      // 等到超时：当作读失败（明确 RC，不挂死）
        Tls& t = tls();
        const u32 ns = cache_n_ / 2, si = pid % ns;
        CacheEnt* w = &cache_[2 * si];
        CSet& cs = sets_[si];
        if (t.sdepth == 0) {                      // 独占 / 单线程：老路
            for (u32 k = 0; k < 2; ++k)
                if (w[k].pid.load(std::memory_order_relaxed) == pid) {
                    cs.mru.store((u8)k, std::memory_order_relaxed); ++t.ctr[C_HITS]; return w[k].buf.data();
                }
            const u32 v = cs.mru.load(std::memory_order_relaxed) ^ 1u;
            if (w[v].buf.empty()) w[v].buf.resize(PAGE);
            w[v].pid.store(NIL, std::memory_order_relaxed);
            if (dev_->read((PageId)pid, 0, w[v].buf.data(), PAGE) != RC::OK) return nullptr;
            w[v].pid.store(pid, std::memory_order_relaxed);
            cs.mru.store((u8)v, std::memory_order_relaxed);
            ++t.ctr[C_MISSES];
            return w[v].buf.data();
        }
        // 共享模式
        t.pin.store(NIL, std::memory_order_relaxed);                       // 放掉上一页
        for (u32 k = 0; k < 2; ++k) {
            if (w[k].pid.load(std::memory_order_acquire) != pid) continue;
            t.pin.store(2 * si + k, std::memory_order_seq_cst);            // 先发布
            if (w[k].pid.load(std::memory_order_seq_cst) == pid) {         // 再复核
                if (cs.mru.load(std::memory_order_relaxed) != k) cs.mru.store((u8)k, std::memory_order_relaxed);
                ++t.ctr[C_HITS];
                return w[k].buf.data();
            }
            t.pin.store(NIL, std::memory_order_relaxed);
        }
        set_lock(cs);
        for (u32 k = 0; k < 2; ++k) {                                       // 别的读者刚填好
            if (w[k].pid.load(std::memory_order_acquire) != pid) continue;
            t.pin.store(2 * si + k, std::memory_order_seq_cst);
            if (cs.mru.load(std::memory_order_relaxed) != k) cs.mru.store((u8)k, std::memory_order_relaxed);
            set_unlock(cs);
            ++t.ctr[C_HITS];
            return w[k].buf.data();
        }
        u32 v = cs.mru.load(std::memory_order_relaxed) ^ 1u;
        for (u32 tries = 0; ; ++tries) {
            const u32 old = w[v].pid.exchange(NIL, std::memory_order_seq_cst);   // 先作废
            if (!pinned_by_other(2 * si + v, &t)) break;                         // 再查钉子
            w[v].pid.store(old, std::memory_order_release);                       // 被钉着：原样还回去
            if (tries == 1) {                                                     // 两路都被钉着：私有缓冲
                set_unlock(cs);
                if (t.pgbuf.size() < PAGE) t.pgbuf.resize(PAGE);
                if (dev_->read((PageId)pid, 0, t.pgbuf.data(), PAGE) != RC::OK) return nullptr;
                ++t.ctr[C_MISSES];
                return t.pgbuf.data();
            }
            v ^= 1u;
        }
        if (w[v].buf.empty()) w[v].buf.resize(PAGE);
        if (dev_->read((PageId)pid, 0, w[v].buf.data(), PAGE) != RC::OK) { set_unlock(cs); return nullptr; }
        t.pin.store(2 * si + v, std::memory_order_seq_cst);                // 先钉住再发布
        w[v].pid.store(pid, std::memory_order_release);
        cs.mru.store((u8)v, std::memory_order_relaxed);
        set_unlock(cs);
        ++t.ctr[C_MISSES];
        return w[v].buf.data();
    }
    // 预取：把 [pid0, pid0+n) 尽量一次读进来并填进缓存，供紧接着的顺序扫描用。
    // 超出范围的页、已经在缓存里的页都跳过；失败不影响正确性（只是没预取到）。
    // 不记 hits/misses —— 它是加速手段，不该污染读放大的口径。
    void prefetch(u32 pid0, u32 n) {
        if (n == 0) return;
        if (n > 16) n = 16;
        if ((u64)pid0 + n > cap_) n = cap_ > pid0 ? cap_ - pid0 : 0;
        if (!n) return;
        // 坑 67：预取绕过了 wait_page。异步提交刚写出的 run 还在 hang_ 里时被顺序扫
        //（relocate 单 run 归并、提交后立刻 select），read_multi 读到的是该位置**上一任**的旧页，
        // 却以"有效缓存"身份留下；随后 page() 等写落地后命中缓存 ⇒ 用旧页归并 ⇒ 丢记录。
        // 在飞的页一律不预取（截到第一张在飞页为止），让 page() 走它自己的等待路径。
        if (async_ && inflight_.load(std::memory_order_acquire) > 0) {
            std::lock_guard<std::mutex> lk(io_mu_);
            for (u32 i = 0; i < n; ++i) if (hang_.count(pid0 + i)) { n = i; break; }
            if (!n) return;
        }
        const u32 ns = cache_n_ / 2;
        u32 need = 0;
        for (u32 i = 0; i < n; ++i) {
            const u32 pid = pid0 + i;
            const CacheEnt* w = &cache_[2 * (pid % ns)];
            if (w[0].pid.load(std::memory_order_relaxed) == pid || w[1].pid.load(std::memory_order_relaxed) == pid) continue;
            ++need;
        }
        if (!need) return;
        // 一次 read_multi 把那一段读出来（1 次系统调用换 n 次）
        u8 tmp[16 * PAGE];
        if (dev_->read_multi((PageId)pid0, n, tmp) != RC::OK) return;
        Tls& t = tls();
        const bool shared = t.sdepth > 0;
        for (u32 i = 0; i < n; ++i) {
            const u32 pid = pid0 + i, si = pid % ns;
            CacheEnt* w = &cache_[2 * si];
            CSet& cs = sets_[si];
            if (shared) set_lock(cs);
            if (w[0].pid.load(std::memory_order_relaxed) == pid || w[1].pid.load(std::memory_order_relaxed) == pid) { if (shared) set_unlock(cs); continue; }
            const u32 v = cs.mru.load(std::memory_order_relaxed) ^ 1u;
            if (shared) {
                const u32 old = w[v].pid.exchange(NIL, std::memory_order_seq_cst);
                // 自己正拿着的那一页也不能踢（调用方可能还握着上一次 page() 的指针）：me 传 nullptr
                if (pinned_by_other(2 * si + v, nullptr)) { w[v].pid.store(old, std::memory_order_release); set_unlock(cs); continue; }
            } else w[v].pid.store(NIL, std::memory_order_relaxed);
            if (w[v].buf.empty()) w[v].buf.resize(PAGE);
            std::memcpy(w[v].buf.data(), tmp + (size_t)i * PAGE, PAGE);
            w[v].pid.store(pid, std::memory_order_release);
            // 预取页不动 MRU：它们还没被用过，别把刚命中的那一路挤成下一个牺牲品
            if (shared) set_unlock(cs);
        }
    }

    void inval(u32 p0, u32 np) {                  // 只在独占下调用（页被重写/释放）
        const u32 ns = cache_n_ / 2;
        for (u32 p = p0; p < p0 + np; ++p) {
            CacheEnt* w = &cache_[2 * (p % ns)];
            for (u32 k = 0; k < 2; ++k)
                if (w[k].pid.load(std::memory_order_relaxed) == p) w[k].pid.store(NIL, std::memory_order_relaxed);
        }
    }

    // 只用内存里的稀疏块，判断「r 在 [lo,hi) 内是否可能有键」。
    // 返回 false 一定是真没有；返回 true 是「可能有」（保守）。
    static bool run_may_have(const Run* r, u64 lo, u64 hi) {
        if (!r || lo >= hi) return false;
        if (hi <= r->first || lo > r->last) return false;
        if (!r->kidx.empty()) {                    // 精确模式：一次二分给出确定答案
            auto k = std::lower_bound(r->kidx.begin(), r->kidx.end(), lo);
            return k != r->kidx.end() && *k < hi;
        }
        if (r->sp.empty()) return true;
        auto it = std::upper_bound(r->sp.begin(), r->sp.end(), lo,
            [](u64 v, const SpEnt& e) { return v < e.first; });
        if (it == r->sp.begin()) {                 // lo 在第一个块之前
            return r->sp[0].first < hi;
        }
        const SpEnt& b = *(it - 1);                // b.first <= lo
        if (b.last >= lo) return true;             // 块内确实有 >= lo 的键
        if (it == r->sp.end()) return false;       // 最后一个块都 < lo ⇒ run 里没有 >= lo 的键
        return it->first < hi;                     // 下一个键是块 it 的首键：越过 hi 就跳过
    }

    // 在一个段的页区间内二分 + 页内查找
    RC probe(RunPtr r, u32 p0, u32 p1, u64 key, u32 view, const u8*& val, u16& len, u32* osz = nullptr,
              std::vector<u8>* mats = nullptr) {
        if (p0 >= p1) return RC::NOTFOUND;
        if (r->meta_pending) ensure_meta(r);
        if (key < r->fences[p0]) return RC::NOTFOUND;
        auto it = std::upper_bound(r->fences.begin() + p0, r->fences.begin() + p1, key);
        u32 pi = (u32)(it - r->fences.begin());
        if (pi > p0) --pi;
        const u8* pg = page(r->page0 + pi);
        if (!pg) return RC::CORRUPT;
        u16 used = rd16(pg + 34);
        if (used > PAGE || used < DHDR) return RC::CORRUPT;
        u8 pfx = pg_pfx(pg);
        // 页内定位：sp 每 16 条记录一个绝对键锚点（页面 + 页内偏移）。
        // 从锚点起步只需解码 ≤16 条，而不是从页首线性扫到 used（平均 70 条）。
        u32 off = DHDR;
        if (!r->sp.empty()) {
            auto it = std::upper_bound(r->sp.begin(), r->sp.end(), key,
                                       [](u64 k, const SpEnt& e) { return k < e.first; });
            if (it != r->sp.begin()) {
                --it;                                  // 最后一个 first <= key 的块
                u32 loc = it->packed;
                if (sp_page(loc) == pi) off = sp_off(loc);
            }
        }
        while (off + pg_rec_size(pfx, 0) <= used) {
            RecHdr h;
            rd_rec(pg, off, h);
            u32 rs = pg_rec_size(pfx, h.len);
            if (off + rs > used) return RC::CORRUPT;
            if (h.key == key && r->ver <= view) {
                val = pg_val_at(pg, off);
                len = h.len;
                if (h.len == OVFL_MARK) {
                    // 大值：按需物化。只要"有没有 / 占多少"的调用方（probe_prev、newer_has）
                    // 不该为它去读那条链 —— 那是每提交每键一次的成本。
                    // 不物化也必须**报告"命中"**：probe 的调用方里有 newer_has /
                    // exact_live_recs 这类只问"有没有"的（它们的答案参与存活账）。
                    // 以前这里返回 CORRUPT 会被当成"没找到" ⇒ 老版本被误算成活记录。
                    if (!mats) { if (osz) *osz = rs; len = OVFL_MARK; }
                    else {
                        const OvflDesc d = desc_of(val);
                        mats->resize(d.total ? d.total : 1);
                        if (read_ovfl(d, mats->data(), (u32)mats->size(), nullptr) != RC::OK) return RC::CORRUPT;
                        val = mats->data();
                        len = (u16)mats->size();
                    }
                }
                if (osz) *osz = rs;
                return RC::OK;
            }
            off += rs;
        }
        return RC::NOTFOUND;
    }

    // 最近可见版本的记录长度（无则 false）
    // 胜者规则只有一条：(可见)版本最大者胜，同版本取 seq 最新。
    // 段在 cell 里的排列顺序只是“归属”，不再隐含“新旧”——这样合并/压缩怎么排都不会读错。
    bool probe_prev(u64 key, u32 view, u16& len, RunPtr* owner = nullptr, u32* osz = nullptr) {
        Cell* c = find_cell(key);
        if (!c) return false;
        const u64 hk = khash(key);
        bool found = false;
        u32 bver = 0, bseq = 0, blen = 0, bosz = 0;
        RunPtr bow = nullptr;
        // 段按 (seq, rid) 升序存放 ⇒ 反向遍历就是“从新到旧”，第一个命中的就是胜者
        // （版本号与 seq 同向单调；FCS_TRACE 下会交叉验证这一点）。
        // 这是每次提交都要对每个键做一次的路径，能提前退出就别把整条链扫完。
        for (auto it = c->segs.rbegin(); it != c->segs.rend(); ++it) {
            if (key < it->second.klo || key >= it->second.khi) continue;
            RunPtr r = runs_[it->first];
            if (!r || !r->bloom.may(hk)) continue;
            const u8* v = nullptr; u16 l2 = 0; u32 o2 = 0;
            if (probe(r, it->second.p0, std::min(it->second.p1, r->npages), key, view, v, l2, &o2) != RC::OK) continue;
            if (!found || r->ver > bver || (r->ver == bver && r->seq > bseq)) {
                found = true; bver = r->ver; bseq = r->seq; blen = l2; bow = r; bosz = o2;
            }
#ifdef FCS_TRACE
            {   // 交叉验证：后面（更旧）的段里不该有更高的 ver
                for (auto it2 = std::next(it); it2 != c->segs.rend(); ++it2) {
                    RunPtr r2 = runs_[it2->first];
                    if (r2 && r2->ver > bver)
                        std::fprintf(stderr, "  VER/SEQ ORDER key=%llu found=%u/%u older=%u/%u\n",
                                     (unsigned long long)key, bver, bseq, r2->ver, r2->seq);
                }
            }
#endif
            break;
        }
        if (!found) return false;
        // 被范围墓碑盖住的旧副本**不是**存活旧版本：它的字节在 del_range 提交时已经记进 dead。
        // 这里再报一次，flush_mem 就会二次扣减（c->live 被夹到 0、dead 虚高、verify 报账），
        // tight 判定也会把"回填被删范围"误判成不增长。
        // 坑 79（g5）要求这里和归并口径一致；坑 95（第 11 次讨论）把口径统一成：**被更新的范围墓碑盖住的点墓碑也是死的**
        //（merge_emit / exact_live_recs / settle_ranges 整盖快路径 / 这里，四处一致；以前快路径把墓碑清零而归并口径算活，
        // 快照钉住 run 时 verify 报 `live mismatch`）。安全性：墓碑 T(ver t) 被 G(ver g>t) 盖住时，T 能盖的旧值 ver<t<g 也被 G 盖住，
        // 对任何视图 V>=g T 都多余；视图 t<=V<g 只有快照，快照由退休/压实门禁保护。
        if (range_hidden(key, bver, view)) return false;
        len = (u16)blen;
        if (owner) *owner = bow;
        if (osz) *osz = bosz;
        return true;
    }

    // ------------------------------------------------------------ 目录
    RunPtr run_at(u32 rid) const {           // 读路径用 find：operator[] 在键缺席时会插入（共享模式下不许改 map）
        auto it = runs_.find(rid);
        return it == runs_.end() ? nullptr : it->second;
    }
    Cell* find_cell(u64 key) {
        auto it = cells_.upper_bound(key);
        if (it == cells_.begin()) return nullptr;
        --it;
        if (key < it->second->lo || key >= it->second->hi) return nullptr;
        return it->second;
    }

    static u32 page_of(RunPtr r, u64 key) {
        auto it = std::upper_bound(r->fences.begin(), r->fences.end(), key);
        u32 i = (u32)(it - r->fences.begin());
        return i ? i - 1 : 0;
    }
    // key 区间 [lo,hi) 覆盖到的页区间 [p0,p1)
    static void page_range(RunPtr r, u64 lo, u64 hi, u32& p0, u32& p1) {
        u32 i0 = page_of(r, lo);
        u32 i1 = page_of(r, hi);
        if (i0 >= r->npages) { p0 = p1 = r->npages; return; }
        p0 = i0;
        p1 = std::min<u32>(i1 + 1, r->npages);
        if (p1 <= p0) p1 = std::min<u32>(p0 + 1, r->npages);
    }
    u32 count_refs(u32 rid) {
        u32 n = 0;
        for (auto& kv : cells_)
            for (auto& sg : kv.second->segs) if (sg.second.rid == rid) ++n;
        return n;
    }
    void attach_run(RunPtr r) {
        ensure_meta(r);                       // 段的页区间要用 fences ⇒ 先把派生数组准备好
        // R10（第 11 轮）：只走与 run 键域相交的单元，页区间用单调前进的栅栏指针（单元连续、键递增 ⇒ 下一单元的
        // 起始页就是上一单元的结束页），O(单元 + 页)。以前对**全部**单元各做两次 page_of 二分：跨全键域的合并/
        // 压实产物每条 1.3 ~ 2 ms（5500 单元），R0 之后占主线程 CPU 的 8 ~ 20%。语义与 page_range 完全一致
        //（p1 至少 p0+1；retighten / split 依赖这个不变量）。
        if (r->npages == 0) return;
        auto cit = cells_.upper_bound(r->first);
        if (cit != cells_.begin()) --cit;
        const u64 sk = seg_key(r->seq, r->page0);
        const u32 np = r->npages;
        u32 pi = 0;                           // 当前单元下界所在页（= 上一单元上界所在页）
        for (; cit != cells_.end() && cit->second->lo <= r->last; ++cit) {
            Cell* c = cit->second;
            if (r->last < c->lo || r->first >= c->hi) continue;
            while (pi + 1 < np && r->fences[pi + 1] <= c->lo) ++pi;      // page_of(c->lo)
            u32 pj = pi;
            while (pj + 1 < np && r->fences[pj + 1] <= c->hi) ++pj;      // page_of(c->hi)
            u32 p0 = pi, p1 = std::min<u32>(pj + 1, np);
            if (p1 <= p0) p1 = std::min<u32>(p0 + 1, np);
            pi = pj;
            if (p0 >= p1) continue;
            u64 klo = std::max(c->lo, r->first);
            u64 khi = std::min(c->hi, r->last + 1);
            if (klo >= khi) continue;
            // 新 run 的 (seq, rid) 多半是本单元里最大的键（压实产物取新鲜 seq，合并产物取组内最大 seq）：
            // 用 end() 做提示，对的时候 O(1)，错了 std::map 自己退回普通插入。
            auto f = c->segs.find(sk);
            if (f != c->segs.end()) { f->second = Seg{r->page0, p0, p1, klo, khi}; }
            else { c->segs.emplace_hint(c->segs.end(), sk, Seg{r->page0, p0, p1, klo, khi}); ++r->refs; }
            c->pages += p1 - p0;
        }
    }
    // 单元被切分后，段的键域变窄 ⇒ 页区间也必须跟着收紧。
    // 不收紧的话每个单元都要从 run 的首页开始扫（切分 N 次就是 O(N·页数)）。
    void retighten(Cell* c) {
        c->pages = 0;
        for (auto& sg : c->segs) {
            RunPtr r = runs_[sg.second.rid];
            if (!r) continue;
            u32 p0, p1;
            page_range(r, sg.second.klo, sg.second.khi, p0, p1);
            sg.second.p0 = p0;
            sg.second.p1 = p1;
            c->pages += p1 - p0;
        }
    }
    // R0（第 10 轮）：run->refs = 全部单元里引用这条 run 的段数。以前每次要知道"这条 run 还有谁引用"都跑
    // count_refs()（O(单元 × 段)），compact_cell 对每个源段调两次 ⇒ 单次 cell 压实 O(段² × 单元)：
    // 5500 单元 × 93 段时一次 370 ms、一次提交 10 s（坑 88）。现在段的每个插入/删除落点都维护 refs，
    // verify() 用慢路 count_refs 交叉核对。
    void ref_inc(u32 rid) { auto it = runs_.find(rid); if (it != runs_.end()) ++it->second->refs; }
    void ref_dec(u32 rid) { auto it = runs_.find(rid); if (it != runs_.end() && it->second->refs) --it->second->refs; }
    void detach_seg(Cell* c, std::map<u32, RunPtr>& runs, u32 rid) {
        auto it = c->segs.begin();
        while (it != c->segs.end() && it->second.rid != rid) ++it;
        if (it == c->segs.end()) return;
        auto rit = runs.find(rid);
        if (rit != runs.end()) { c->pages -= it->second.p1 - it->second.p0; --rit->second->refs; }
        seg_set_live(it->second, 0);
        c->segs.erase(it);
    }

    static void rebuild_pcum(Run* r) {
        r->pcum.assign(r->npages + 1, 0);
        r->pncum.assign(r->npages + 1, 0);
        for (u32 i = 0; i < r->npages; ++i) {
            r->pcum[i + 1] = r->pcum[i] + r->pbytes[i];
            r->pncum[i + 1] = r->pncum[i] + (i < r->pnrec.size() ? r->pnrec[i] : 0);
        }
    }

    // 单页里落在 [lo,hi) 的记录字节 / 条数（只有被键域切断的边界页才走这里）
    static void page_sum(const u8* p, u64 lo, u64 hi, u64& bytes, u32& recs) {
        u16 used = rd16(p + 34);
        if (used < DHDR || used > PAGE) return;
        u8 pf = pg_pfx(p);
        u32 off = DHDR;
        while (off + pg_rec_size(pf, 0) <= used) {
            RecHdr h;
            rd_rec(p, off, h);
            u32 rs = pg_rec_size(pf, h.len);
            if (off + rs > used) break;
            if (h.key >= lo && h.key < hi) { bytes += rs; ++recs; }
            off += rs;
        }
    }

    // 段 [p0,p1) 与单元键域 [lo,hi) 的交：记录字节 + 条数。
    // 整页区间是前缀和，边界页才解码 ⇒ 与段长无关（O(1)）。
    void seg_totals(RunPtr r, const Seg& sg, u64 lo, u64 hi, u64& bytes, u32& recs) {
        if (sg.tlo == lo && sg.thi == hi) { bytes += sg.tb; recs += sg.tn; return; }   // C2 memo 命中
        const u32 a = sg.p0, b = std::min(sg.p1, r->npages);
        if (a >= b) return;
        const u32 last = b - 1;
        u64 tb = 0; u32 tn = 0; bool full = true;
        // 末页（last+1==npages）当边界页：它的上界只有 hi，扫一页比证明便宜。
        const bool fa = lo <= r->fences[a];
        const bool fb = last + 1 < r->npages && hi >= r->fences[last + 1];
        if (a == last) {
            if (fa && fb) { tb += r->pcum[a + 1] - r->pcum[a]; tn += r->pncum[a + 1] - r->pncum[a]; }
            else { const u8* p = page(r->page0 + a); if (p) page_sum(p, lo, hi, tb, tn); else full = false; }
        } else {
            i64 fl = fa ? (i64)a : (i64)a + 1;
            i64 fh = fb ? (i64)last : (i64)last - 1;
            if (fl <= fh) {
                tb += r->pcum[(size_t)fh + 1] - r->pcum[(size_t)fl];
                tn += r->pncum[(size_t)fh + 1] - r->pncum[(size_t)fl];
            }
            if (!fa) { const u8* p = page(r->page0 + a); if (p) page_sum(p, lo, hi, tb, tn); else full = false; }
            if (!fb) { const u8* p = page(r->page0 + last); if (p) page_sum(p, lo, hi, tb, tn); else full = false; }
        }
        bytes += tb; recs += tn;
        if (full) { sg.tlo = lo; sg.thi = hi; sg.tb = tb; sg.tn = tn; }   // 读页失败时不缓存（下次再算）
    }

    // 单元内全部记录字节（含垃圾），只计 [lo,hi) 内的记录。
    // 页里记录的字节数就是 pbytes（= used-DHDR，封页时已算好并由 verify 交叉校验），
    // 所以整页区间用前缀和一步带过；只有单元键域切断的那一两页需要解码。
    // 旧实现把每个单元的**所有**页都解码一遍，是 recount 里与归并重复的那一半开销。
    u64 total_rec_bytes(Cell* c) {
        u64 t = 0; u32 n = 0;
        for (auto& sg : c->segs) {
            RunPtr r = runs_[sg.second.rid];
            if (!r) continue;
            if (r->meta_pending) ensure_meta(r);
            seg_totals(r, sg.second, c->lo, c->hi, t, n);
        }
        return t;
    }

    // 多段归并输出（scan / compact 共用）：
    //   1) 每个游标先 seek 到单元下界（段内有序 ⇒ 可跳过整段前缀）
    //   2) 每轮取最小键，同键取最大版本；其余同键旧版本直接跳过
    // need_vals=false：调用方只要"这条记录占多少字节"（存活账），不要值。
    // 大值的链因此完全不会被读 —— 压实/归并的第二遍（recount）不再是 O(值总量)。
    template <class F>
    void merge_emit(Cell* c, std::vector<Cur>& cs, F&& fn, bool need_vals = true) {
        for (auto& k : cs) {
            RecHdr h;
            u64 lo = std::max(k.klo, c->lo);
            while (!k.done && (k.hdr(h), h.key < lo)) k.advance(this, h.len);
        }
        for (;;) {
            int best = -1;
            u64 bk = 0; u32 bver = 0, bseq = 0; u16 blen = 0; const u8* bv = nullptr;
            for (size_t i = 0; i < cs.size(); ++i) {
                if (cs[i].done) continue;
                RecHdr h;
                cs[i].hdr(h);
                if (h.key >= std::min(cs[i].khi, c->hi)) continue;   // 段内有序：不再有候选
                u32 sq = cs[i].r->seq, srid = cs[i].r->page0;
                // “最新”按 (seq, rid) 全序判定 —— 与读路径（新→旧段扫描）严格一致。
                // 只比 seq 会在“压实产物与原 run 同 seq”时给出和读路径相反的赢家。
                if (best < 0 || h.key < bk ||
                    (h.key == bk && seg_key(sq, srid) > seg_key(bseq, cs[best].r->page0))) {
                    best = (int)i; bk = h.key; bver = cs[i].r->ver; bseq = sq; blen = h.len; bv = cs[i].val();
                }
            }
            if (best < 0) return;
            // 溢出值：**先把 16 B 描述符拷出来**（页指针只活到下一次 page()），
            // 然后按需物化。fn 的最后一个参数就是描述符：
            //   * 归并/压实时 `RunWriter::add_take()` 可以"零读接管"整条链；
            //   * 不能接管（比如写进内存表）时才读出来。
            u16 plen = blen;                     // 页上的 len 字段（推进用）
            u8 dsc[16] = {};
            bool took = false;                   // 真的接管了吗（没接管就别把描述符交出去）
            bool is_ovfl = (blen == OVFL_MARK);
            if (is_ovfl) {
                std::memcpy(dsc, cs[best].val(), 16);
                if (!need_vals) {
                    // 只做存活账的调用方（recount / verify / check_liveness）**不看值**。
                    // 这里若也去读链，等于每次压实都把全部大值读两遍（实测多读 24.7 MB）。
                    bv = cs[best].val(); blen = plen;
                } else if (take_ok(cs[best].r, dsc)) {
                    bv = nullptr; blen = plen; took = true;   // 接管：fn 用 dsc，不碰 bv
                } else {                                   // 不能接管才物化
                    const u8* pv = cs[best].val(this, blen, false);   // 归并物化：不进链缓存
                    if (!pv) { cs[best].advance(this, plen); continue; }
                    bv = pv; blen = (u16)cs[best].vb.size();
                }
            }
            for (size_t i = 0; i < cs.size(); ++i) {
                if (cs[i].done || (int)i == best) continue;
                for (;;) {
                    RecHdr h;
                    cs[i].hdr(h);
                    if (h.key != bk) break;
                    if (!cs[i].advance(this, h.len)) break;   // 同键旧副本：全部跳过
                }
            }
            // 范围墓碑盖住的记录：归并时直接丢弃（压实之后就真的不在了）。
            // 放在"同键旧副本已跳过"之后，一次跳掉整组，不会逐版本空转。
            // 坑 95：点墓碑同样丢（口径见 probe_prev 的注释）；被更新的范围墓碑盖住的墓碑对当前及之后的视图都多余。
            if (range_hidden(bk, cs[best].r->ver, 0xFFFFFFFFu)) {
                if (!cs[best].advance(this, plen)) cs[best].done = true;
                continue;
            }
            // 先消费（bv 指向游标缓冲，advance 会覆盖它），再推进
            // 只有"接管成功"才交描述符。物化过的值必须交**字节**：
            // 以前这里按 is_ovfl 交描述符，于是"不接管 + 描述符"两条路径同时走到，
            // 新 run 把一条自己并不拥有的链记进 ovfl_ref，源 run 接着把链还了 ⇒ 指针悬空
            //（compact_file 之后 verify 报 `ovfl data`，链被后续分配覆写）。
            if (!fn(bk, bver, bv, blen, cs[best].osz(plen), cs[best].r, took ? dsc : nullptr)) return;
            cs[best].advance(this, plen);
        }
    }

    // ------------------------------------------------------------ 异步写的实现
    // 整段一起入队：一次加锁、一次唤醒（逐页加锁在 k 页/段时纯属浪费）
    void enqueue_batch(std::vector<IoJob>& jobs) {
        if (jobs.empty()) return;
        {
            std::lock_guard<std::mutex> g(io_mu_);
            for (auto& j : jobs) { for (u32 i = 0; i < j.n; ++i) hang_.insert(j.pid + i); q_.push_back(std::move(j)); }
            inflight_ += jobs.size();
        }
        jobs.clear();
        io_cv_.notify_all();
    }
    void enqueue_write(u32 pid, const u8* src, u32 len) {
        IoJob j;
        j.pid = pid;
        j.img.assign(src, src + len);
        {
            std::lock_guard<std::mutex> g(io_mu_);
            hang_.insert(pid);
            ++inflight_;
            q_.push_back(std::move(j));
        }
        io_cv_.notify_all();
    }
    // 等一段连续页全部落地（一次加锁；n 很小：溢出链 ≤ 9 页）
    bool wait_pages(u32 p0, u32 n) {
        if (!async_ || inflight_.load(std::memory_order_acquire) == 0) return true;
        auto any = [&] { for (u32 i = 0; i < n; ++i) if (hang_.count(p0 + i)) return true; return false; };
        {
            std::unique_lock<std::mutex> lk(io_mu_);
            if (!any()) return true;
            if (io_stalled_ && io_timeout_ms_) { ++io_timeout_; return false; }
        }
        if (io_.empty()) return wait_io();
        std::unique_lock<std::mutex> lk(io_mu_);
        if (!io_timeout_ms_) { io_cv_.wait(lk, [&] { return !any(); }); return true; }
        bool ok = io_cv_.wait_for(lk, std::chrono::milliseconds(io_timeout_ms_), [&] { return !any(); });
        if (!ok) { ++io_timeout_; io_stalled_ = true; }
        return ok;
    }
    bool wait_page(u32 pid) {
        if (!async_ || inflight_.load(std::memory_order_acquire) == 0) return true;
        {
            std::unique_lock<std::mutex> lk(io_mu_);
            if (!hang_.count(pid)) return true;
            if (io_stalled_ && io_timeout_ms_) { ++io_timeout_; return false; }
        }
        if (io_.empty()) return wait_io();           // 没有 worker 就自己排空
        // 这一页正在被后台写：读到的可能是半页。必须等它落地。
        std::unique_lock<std::mutex> lk(io_mu_);
        if (!io_timeout_ms_) { io_cv_.wait(lk, [&] { return hang_.count(pid) == 0; }); return true; }
        bool ok = io_cv_.wait_for(lk, std::chrono::milliseconds(io_timeout_ms_),
                                  [&] { return hang_.count(pid) == 0; });
        if (!ok) { ++io_timeout_; io_stalled_ = true; }
        return ok;
    }
    void io_loop() {
        for (;;) {
            IoJob j;
            {
                std::unique_lock<std::mutex> lk(io_mu_);
                io_cv_.wait(lk, [&] { return stop_io_ || !q_.empty(); });
                if (q_.empty()) { if (stop_io_) return; continue; }
                j = std::move(q_.front());
                q_.pop_front();
            }
            RC rc = j.run(dev_);
            {
                std::lock_guard<std::mutex> g(io_mu_);
                for (u32 i = 0; i < j.n; ++i) hang_.erase(j.pid + i);
                --inflight_;
                if (inflight_ == 0) io_stalled_ = false;   // 设备缓过来了
                if (rc == RC::OK) ++io_done_; else ++io_err_;
            }
            io_cv_.notify_all();
        }
    }

    // ------------------------------------------------------------ 挂载
    // 超级块：每次提交都要写它（提交点），于是把本次的小增量直接内联进同一页，
    // 省掉“每提交一个 4KB 清单页”的写放大。
    struct Sb {
        u32 magic = PK_SB, vers = 0, state = COMMIT_WORD, chk = 0;
        u32 tail = 2, man_first = NIL, man_last = NIL, nman = 0;
        u32 n_inl = 0, pad = 0;      // 头固定 40B
    };
    static u32 sb_chk(const u8* buf, u32 n_inl) {
        std::vector<u8> tmp(SB_HDR + (size_t)n_inl * MENT);
        std::memcpy(tmp.data(), buf, tmp.size());
        std::memset(tmp.data() + 12, 0, 4);      // chk 自身不参与
        return crc32c(tmp.data(), (u32)tmp.size());
    }
    bool read_sb(u32 slot, Sb& s, std::vector<ManEnt>& inl) {
        u8 buf[SB_HDR];
        if (dev_->read((PageId)slot, 0, buf, SB_HDR) != RC::OK) return false;
        std::memcpy(&s, buf, SB_HDR);
        if (s.magic != PK_SB || s.state != COMMIT_WORD) return false;
        if (s.n_inl > INLINE_MAX) return false;
        std::vector<u8> all(SB_HDR + (size_t)s.n_inl * MENT);
        std::memcpy(all.data(), buf, SB_HDR);
        if (s.n_inl && dev_->read((PageId)slot, SB_HDR, all.data() + SB_HDR, s.n_inl * MENT) != RC::OK)
            return false;
        if (s.chk != sb_chk(all.data(), s.n_inl)) return false;
        inl.clear();
        for (u32 i = 0; i < s.n_inl; ++i) inl.push_back(decode_man(all.data() + SB_HDR + (size_t)i * MENT));
        return true;
    }
    // 提交协议：擦除本槽 → 写载荷（含 vers，全部纳入 CRC）→ 最后写 4B 提交字。
    // 任一步掉电 ⇒ CRC 或提交字校验失败，挂载回落到另一槽的上一个完整提交。
    // 坑 81（g6 第一次跑就抓到）：以前这里只有"发出顺序"——数据页 → 清单页 → SB → sync。文件/块设备有
    // 页缓存，回写顺序任意：掉电时 SB 可能先到介质而数据页没到 ⇒ 挂载到一个指向垃圾页的"完整提交"。
    // 协议改为 **屏障 → 写 SB → 屏障**：
    //   1) wait_io + sync：这个提交点引用的每一页（含后台线程在写的）先落到介质；
    //   2) 写 SB（擦槽 + 整载荷 + CRC，撕裂由 CRC 兜住，另一槽是上一个完整提交）；
    //   3) sync：write_sb 返回 ⇒ 提交点已持久。调用方随后的 promote_pending/erase 才不会在
    //      "新 SB 还没落、旧 SB 还在引用这些页"的窗口里复用它们。
    // 代价：文件设备上每个持久提交点 2 次 fdatasync（以前 1 次）；RamDev/NOR 的 sync 是空操作，没有变化。
    RC write_sb() {
        if (!wait_io()) return RC::TIMEOUT;
        dev_->sync();
        RC rc = write_sb_raw();
        if (rc != RC::OK) return rc;
        dev_->sync();
        ++sb_gen_;                         // 提交点已落盘：在此之前进 pending_free_ 的页从现在起可复用
        return RC::OK;
    }
    RC write_sb_raw() {
        u32 n = (u32)std::min<size_t>(pend_.size(), INLINE_MAX);
        std::vector<u8> buf(SB_HDR + (size_t)n * MENT, 0);
        Sb sb;
        sb.vers = vers_; sb.tail = tail_;
        sb.man_first = man_first_; sb.man_last = man_last_; sb.nman = nman_;
        sb.n_inl = n;
        std::memcpy(buf.data(), &sb, SB_HDR);
        for (u32 i = 0; i < n; ++i) encode_man(buf.data() + SB_HDR + (size_t)i * MENT, pend_[i]);
        u32 chk = sb_chk(buf.data(), n);
        std::memcpy(buf.data() + 12, &chk, 4);
        // 坑 83（g6）：槽位以前取 vers_ & 1。commit(false) 只前移 vers_ 不写 SB ⇒ 两次持久提交之间夹着奇数个
        // 逻辑提交时，新 SB 会写进**上一个持久提交所在的槽**：撕裂 ⇒ 两槽里只剩更老的那个 ⇒ 已持久的提交点丢失
        //（seed 2 第 1280 步：回到 258 而不是 259）。双槽协议要求的是"每次 SB 写交替"，与版本奇偶无关。
        u32 slot = sb_slot_ ^ 1u;
        // NOR：擦后全 1；随后把整页载荷（含提交字与 CRC）一次写入。
        // 提交的原子性由 CRC 承担：载荷没写全 ⇒ CRC 对不上；写全了就是一次完整提交。
        if (dev_->erase((PageId)slot) != RC::OK) return RC::IO;
        if (dev_->write((PageId)slot, 0, buf.data(), (u32)buf.size()) != RC::OK) return RC::IO;
        sb_slot_ = slot;
        wr_man_ += buf.size();
        tr(TR_COMMIT, vers_, tail_, man_last_, (u16)std::min<u32>(nman_, 0xFFFFu));
#ifdef FCS_TRACE
        std::fprintf(stderr, "  SBWRITE vers=%u n_inl=%u man_last=%u nman=%u bytes=%zu\n",
                     vers_, n, man_last_, nman_, buf.size());
#endif
        return RC::OK;
    }

    RC mount() {
        Sb a, b;
        std::vector<ManEnt> ia, ib;
        bool oa = read_sb(0, a, ia), ob = read_sb(1, b, ib);
        if (!oa && !ob) {
            vers_ = 0; tail_ = 2; man_first_ = man_last_ = NIL; nman_ = 0;
            sb_slot_ = 1;                                 // 两次 write_sb 分别落到槽 0、槽 1
            clear_state();
            RC rc = reload();
            if (rc != RC::OK) return rc;
            if ((rc = write_sb()) != RC::OK) return rc;
            return write_sb();
        }
        Sb* s = (oa && ob) ? (b.vers >= a.vers ? &b : &a) : (oa ? &a : &b);
        sb_slot_ = (s == &a) ? 0 : 1;                     // 下一次 SB 写到另一槽（坑 83）
        vers_ = s->vers; tail_ = s->tail;
        if (tail_ > cap_) tail_ = cap_;          // 收缩后崩溃：SB 的高水位可能大于文件
        // 坑 84（g6）：shrink 先截断设备、再写带新高水位的 SB。截断到了、SB 没到 ⇒ 挂载到老 SB：tail_=110 而
        // 设备只有 81 页。空闲表按 tail_ 建，alloc_pages 从空闲表拿页时不看 dev_pages_ ⇒ 写到设备长度之外（IO）。
        // 物理长度跟着逻辑高水位走：长回去（文件设备就是一次 ftruncate）；长不回去才把高水位夹下来。
        if (tail_ > dev_pages_) {
            if (dev_->truncate((PageId)tail_)) dev_pages_ = tail_;
            else tail_ = dev_pages_;
        }
        man_first_ = s->man_first; man_last_ = s->man_last; nman_ = s->nman;
        pend_ = (s == &a) ? ia : ib;
        tr(TR_MOUNT, vers_, tail_, man_last_, (u16)std::min<u32>(nman_, 0xFFFFu));
#ifdef FCS_TRACE
        std::fprintf(stderr, "  MOUNT oa=%d vers=%u n_inl=%zu man_last=%u nman=%u | ob=%d vers=%u n_inl=%zu\n",
                     (int)oa, a.vers, ia.size(), a.man_last, a.nman, (int)ob, b.vers, ib.size());
#endif
        return reload();
    }

    void clear_state() {
        abandon_job();                                // 作业引用的 run 对象马上没了
        unk_cells_ = 0; sweep_lo_ = 0; split_pending_ = false;
        for (auto& kv : runs_) delete kv.second;
        runs_.clear();
        for (auto& kv : cells_) delete kv.second;
        cells_.clear();
        free_.clear();
        deferred_.clear();
        pending_free_.clear();
        // 范围墓碑是**清单状态**的一部分：回退/重载时必须清掉再按盘重放，
        // 否则"被回退掉的分支"里那些 del_range 会继续遮蔽新分支的数据。
        ranges_.clear();
        pend_ranges_.clear();
        ovc_clear();
    }

    RC reload() {
        // 重建状态前必须把在飞的后台页写完：否则 worker 会把"旧分支的页"
        // 写到刚被重新分配出去的位置上（就是随机坏清单项/数据错乱的来源）。
        if (!wait_io(true)) return RC::TIMEOUT;     // 这里等不到就不重建（宁可报错）
        clear_state();
        if (dev_) dev_pages_ = dev_->capacity();
        next_seq_ = 0x40000000u;
        low_seq_ = 0x3FFFFFFFu;
        Cell* root = new Cell();
        root->lo = 0; root->hi = ~0ull;
        cells_[0] = root;
#ifdef FCS_TIME_OPEN
        auto _r0 = std::chrono::steady_clock::now();
#endif
        RC rc = replay_manifest();
        if (rc != RC::OK) return rc;
#ifdef FCS_TIME_OPEN
        auto _t0 = std::chrono::steady_clock::now();
#endif
        for (auto& m : pend_) apply_man(m);      // 超级块内的联增量
        for (auto& m : pend_delta_) apply_man(m);   // 后台已落页、尚未进提交点的段
#ifdef FCS_TIME_OPEN
        auto _t1 = std::chrono::steady_clock::now();
#endif
        for (auto& kv : runs_) {
            attach_run(kv.second);
            u32 sq = kv.second->seq;
            if (sq >= 0x40000000u) { if (sq >= next_seq_) next_seq_ = sq + 1; }
            else if (sq < low_seq_) low_seq_ = sq ? sq - 1 : 0;
            // 版本是单调逻辑时钟：超级块可能落后于清单页，挂载时取盘上见过的最大值，
            // 否则“已持久化但版本号更大的段”会被误判成 future ver。
            if (kv.second->ver > vers_) vers_ = kv.second->ver;
        }
        for (auto& m : pend_) if (m.op != M_SEG_DEL && m.ver > vers_) vers_ = m.ver;
        for (auto& m : pend_delta_) if (m.op != M_SEG_DEL && m.ver > vers_) vers_ = m.ver;
        // 段删除必须等 attach_run 之后执行（挂载时段是从 run × 单元重新推导的）
        for (auto& sd : segdels_) {
            auto it = cells_.find(sd.first);
            if (it == cells_.end()) continue;
            Cell* c = it->second;
            auto f = c->segs.find(sd.second);
            if (f == c->segs.end()) continue;
            c->pages -= f->second.p1 - f->second.p0;
            seg_set_live(f->second, 0);
            ref_dec(f->second.rid);
            c->segs.erase(f);
        }
        segdels_.clear();
        for (auto& kv : runs_)
            tr(TR_REPLAY, kv.second->page0, run_block(kv.second), kv.second->ver, (u16)std::min<u32>(kv.second->seq, 0xFFFFu));
#ifdef FCS_TRACE
        for (auto& kv : runs_)
            std::fprintf(stderr, "  REPLAY run rid=%u seq=%u ver=%u vers_=%u npg=%u first=%llu last=%llu nrec=%u nbytes=%u\n",
                kv.second->page0, kv.second->seq, kv.second->ver, vers_, kv.second->npages,
                (unsigned long long)kv.second->first, (unsigned long long)kv.second->last,
                kv.second->nrec, kv.second->nbytes);
        for (auto& kv : cells_)
            std::fprintf(stderr, "  REPLAY cell [%llu,%llu) segs=%zu\n",
                (unsigned long long)kv.second->lo, (unsigned long long)kv.second->hi, kv.second->segs.size());
#endif
#ifdef FCS_TIME_OPEN
        auto _t2 = std::chrono::steady_clock::now();
#endif
        if (lazy_acct_) mark_all_unknown();   // R6-lite：一页不读；账在之后的维护单元里分摊补算
        else recompute_liveness();
        rebuild_free();
#ifdef FCS_TIME_OPEN
        auto _t3 = std::chrono::steady_clock::now();
        auto _ms = [](auto a, auto b) { return std::chrono::duration<double, std::milli>(b - a).count(); };
        std::fprintf(stderr, "[open] replay=%.2fms(pend+%.2f) attach=%.2f liveness=%.2f free=%.2f | "
                             "runs=%zu cells=%zu meta_hits=%llu nman=%u\n",
                     _ms(_r0, _t0), _ms(_t0, _t1), _ms(_t1, _t2), _ms(_t2, _t3),
                     _ms(_t3, std::chrono::steady_clock::now()),
                     runs_.size(), cells_.size(), (unsigned long long)meta_hits_.load(), nman_);
#endif
        return RC::OK;
    }

    // ------------------------------------------------------------ 清单
    // 从最新页沿 prev 链回溯，再按时间顺序应用
    RC replay_manifest() {
        if (man_last_ == NIL || nman_ == 0) return RC::OK;
#ifdef FCS_TIME_OPEN
        auto _r0 = std::chrono::steady_clock::now();
#endif
        std::vector<u32> chain;
        u32 pid = man_last_;
        for (u32 i = 0; i < nman_ && pid != NIL; ++i) {
            const u8* p = page(pid);
            if (!p || rd32(p) != PK_MAN) return RC::CORRUPT;
            if (crc32c(p + MHDR, rd32(p + 8) * MENT) != rd32(p + 12)) return RC::CORRUPT;
            if (rd32(p + 8) > MAN_PER_PG) return RC::CORRUPT;
            chain.push_back(pid);
            pid = rd32(p + 4);
        }
        for (auto it = chain.rbegin(); it != chain.rend(); ++it) {
            const u8* src = page(*it);
            if (!src) return RC::CORRUPT;
            u32 n = rd32(src + 8);
            // 拷贝：apply_man 里的 page() 会把这块缓冲换掉（缓存是直映的）
            std::vector<u8> buf(src + MHDR, src + MHDR + (size_t)n * MENT);
            for (u32 k = 0; k < n; ++k) apply_man(decode_man(buf.data() + (size_t)k * MENT));
        }
        return RC::OK;
    }

    void apply_man(const ManEnt& m) {
        if (m.op == M_RUN_ADD) {
            // 清单项必须自证清白：页区间越界/为空的条目一律丢弃。
            // （旧实现直接按 m.npages 分配，一条坏记录就能把内存撑爆）
            if (m.npages == 0 || m.npages > cap_ || m.page0 < 2 ||
                (u64)m.page0 + m.npages > (u64)cap_) {
                ++bad_man_;
#ifdef FCS_TRACE
                std::fprintf(stderr, "  BAD MAN op=%u rid=%u npg=%u key=%llu\n",
                             (unsigned)m.op, m.page0, m.npages, (unsigned long long)m.key);
#endif
                return;
            }
            RunPtr r = new Run();
            r->page0 = m.page0; r->npages = m.npages;
            r->first = m.key; r->last = m.last;
            r->ver = m.ver; r->nbytes = m.nbytes;
            r->seq = m.seq; r->lvl = std::min<u32>(m.lvl, LVL_MAX);   // 坑 89：老库里可能有 best_lvl+1 写出的 5/6/7 层，挂载时夹回顶层
            // 元数据页紧跟在数据页之后。这里**只记账不读**：
            // 清单链里大量 run 是“加了又删”的（快照之后又合并过），给它们读 meta 是白花钱。
            // 真正活下来的 run 会在 attach_run 时 ensure_meta()，那时才付出读页的代价。
            r->mpage = 0;                 // 0 = 还没查过；第一次真要用时才去瞟一眼 page0+npages
            r->meta_pending.store(1, std::memory_order_relaxed);
            r->fences.resize(m.npages, 0);
            r->pbytes.resize(m.npages, 0);
            r->pcum.assign(m.npages + 1, 0);
            runs_[m.page0] = r;
        } else if (m.op == M_RUN_DEL) {
            auto it = runs_.find(m.page0);
            if (it != runs_.end()) { delete it->second; runs_.erase(it); }
            // 坑 80（g5 seed 36）：run 死了，它之前记的段删除项也随之作废。
            // 合并产物继承源的最大 seq、搬迁保留 seq ⇒ 同一 page0 的下一代 run 可能和上一代 **(seq, page0) 完全相同**
            //（6 → 合并进 58 → 搬回 6），重放时老账的 SEG_DEL 会把新 run 的段摘掉：挂载后整条 run 查不到（352 个键 NOTFOUND）。
            segdels_.erase(std::remove_if(segdels_.begin(), segdels_.end(),
                               [&](const std::pair<u64, u64>& sd) { return (u32)sd.second == m.page0; }),
                           segdels_.end());
        } else if (m.op == M_SPLIT_ADD) {
            auto it = cells_.upper_bound(m.key);
            Cell* c = nullptr;
            if (it != cells_.begin()) { --it; c = it->second; }
            if (!c || m.key <= c->lo || m.key >= c->hi) return;
            Cell* nc = new Cell();
            nc->lo = m.key; nc->hi = c->hi;
            c->hi = m.key;
            cells_[nc->lo] = nc;
        } else if (m.op == M_RANGE) {
            if (m.key < m.last) add_tomb(m.key, m.last, m.ver);
        } else if (m.op == M_SEG_DEL) {
            segdels_.push_back({m.key, seg_key(m.seq, m.page0)});   // 等 attach_run 之后再摘
        } else if (m.op == M_SPLIT_DEL) {
            auto it = cells_.find(m.key);
            if (it == cells_.end() || it == cells_.begin()) return;
            Cell* c = it->second;
            auto nx = std::next(it);
            if (nx == cells_.end()) return;
            Cell* cn = nx->second;
            c->hi = cn->hi;
            for (auto& sg : cn->segs) ref_dec(sg.second.rid);
            cells_.erase(nx);
            delete cn;
        }
    }

    // ------------------------------------------------------------ 空闲空间
    // 清单页的分配（B3）。清单页是 1 页 1 页来的、寿命短（下一次快照/检查点就回收），而 run 块是几十到
    // 几万页的整块 —— 让 1 页的东西去切大洞是最差的组合：以前"最低空闲页先用"会把退休 run 刚腾出的
    // 134 页洞切成 133 页，下一条同样大小的 run 就装不下、只能长尾（bench6 delloop 奇数轮 used +134）；
    // compact_file 期间更会让"洞 = run 块 − 1 页"永远搬不下去（s2 长跑：used 386 vs live 184）。
    // 按**位置**判（"最高 run 块之上的洞"）不行：退休 run 的洞也可能恰在所有活 run 之上（追踪环抓到
    // 1465 号事件把最后一个 134 页洞切成 133）。按**大小**判：
    //   1) 最低的小洞（≤ 8 页，多半是上一代清单页留下的）—— 小东西填小洞；
    //   2) 比当前最大 run 块还小的洞里**最小**的那个（同样大小的 run 本来也装不下它，切一页损失最小）；
    //   3) 贴着尾部的洞（p0+n == tail_）的最低页：等价于"尾部分配但不长文件"，剩下的部分仍贴着尾部，
    //      run 要是装不下，alloc_pages 会把它和尾部增长拼成一块（见下），所以切它没有碎片代价；
    //   4) 长尾一页（有界：清单链最多 MAN_SNAP_AT 页，旧链回收后是 < 最大 run 块的洞，下一代按 2) 回填）；
    //   5) 实在没有（尾部顶到容量）：退回普通分配，宁可切洞也不能让提交失败。
    // compact_file 期间（man_high_）例外：run 已经全部搬到低位、马上就要 shrink，清单页要**尽量低**——
    // 取"最高 run 块之上"的第一个空闲页（上面的洞都是尾部余料，切它没有代价，shrink 会把它整个截掉）。
    // 平时不能这么做：退休 run 的洞也可能恰在所有活 run 之上（追踪环抓到过 1465 号事件把 134 页洞切成 133）。
    // P5：快照期分配的清单页记下来 —— 任何回退点的链都不含它们，被下一次全量清单换掉时可以**立刻**回收，
    // 不必 deferred 到快照释放（否则 compact_file 每轮一次 checkpoint，300 轮把高水位推到 19×：snapmaint 实测）。
    RC alloc_man_page(u32& out) {
        RC rc = alloc_man_page_raw(out);
        if (rc == RC::OK && nsnap_ > 0) man_new_.insert(out);
        return rc;
    }
    RC alloc_man_page_raw(u32& out) {
        auto take1 = [&](std::map<u32, u32>::iterator it, u32 x) {
            const u32 p0 = it->first, n = std::min<u32>(it->second, tail_ - p0);
            free_.erase(it);
            if (x > p0) free_[p0] = x - p0;
            if (x + 1 < p0 + n) free_[x + 1] = p0 + n - x - 1;
            out = x;
            ovc_drop(out, 1);
            tr(TR_ALLOC, out, 1, tail_, 2);
        };
        u32 maxblk = 0, base = 2;
        for (auto& kv : runs_) {
            maxblk = std::max(maxblk, run_block(kv.second));
            base = std::max(base, kv.second->page0 + run_block(kv.second));
        }
        if (man_high_) {
            for (auto it = free_.begin(); it != free_.end(); ++it) {
                const u32 p0 = it->first;
                if (p0 >= tail_) continue;
                const u32 n = std::min<u32>(it->second, tail_ - p0);
                if (p0 + n <= base) continue;
                take1(it, std::max(p0, base));
                return RC::OK;
            }
        }
        auto best = free_.end(), last = free_.end();
        u32 bestn = NIL;
        for (auto it = free_.begin(); it != free_.end(); ++it) {
            if (it->first >= tail_) continue;
            const u32 n = std::min<u32>(it->second, tail_ - it->first);
            if (n <= 8) { take1(it, it->first); return RC::OK; }           // 1)
            if (n < maxblk && n < bestn) { best = it; bestn = n; }         // 2) 候选
            last = it;
        }
        if (best != free_.end()) { take1(best, best->first); return RC::OK; }
        if (last != free_.end() && (u64)last->first + last->second >= tail_) {   // 3)
            take1(last, last->first);
            return RC::OK;
        }
        if (tail_ + 1 <= cap_) {                                           // 4)
            if (tail_ + 1 > dev_pages_ && dev_->truncate((PageId)(tail_ + 1))) dev_pages_ = tail_ + 1;
            if (tail_ + 1 <= dev_pages_) {
                out = tail_++;
                ovc_drop(out, 1);
                tr(TR_ALLOC, out, 1, tail_, 2);
                return RC::OK;
            }
        }
        return alloc_pages(1, out, true);                                  // 5)
    }
    RC alloc_pages(u32 np, u32& out, bool maint = false) {
        if (np == 0) { out = NIL; return RC::OK; }
        // 维护（compact/merge/relocate）要能在“写满”的库上搬数据：它只需临时空间，
        // 搬完立刻把旧页还回来。用户写入则不许碰这块预留，保证 GC 总能推进。
        u32 lim = maint ? cap_ : user_lim();
        auto tailhole = free_.end();                  // 贴着尾部的洞（p0+n >= tail_）
        for (auto it = free_.begin(); it != free_.end(); ++it) {
            u32 p0 = it->first, n = it->second;
            if (p0 >= tail_) continue;
            if (p0 + n >= tail_) { n = tail_ - p0; tailhole = it; }   // 高水位以上不算空闲（能靠增长拿到）
            if (n < np) continue;
            free_.erase(it);
            if (n > np) free_[p0 + np] = n - np;      // 低位先用 ⇒ 尾部天然紧凑
            out = p0;
            ovc_drop(out, np);                        // 这些页要被重写：链缓存里的旧内容作废
            tr(TR_ALLOC, out, np, tail_, maint ? 1 : 0);
            return RC::OK;
        }
        // 没有装得下的洞：贴着尾部的洞可以和尾部增长**拼成一块**（B3）。否则这个洞会被永远跳过，
        // 清单页切过的"块 − 1 页"洞就是这么变成死空间的。
        if (tailhole != free_.end()) {
            const u32 p0 = tailhole->first, have = tail_ - p0, grow = np - have;
            if ((u64)p0 + np <= lim) {
                if ((u64)p0 + np > dev_pages_) {
                    if (!dev_->truncate((PageId)(p0 + np))) return RC::NOSPACE;
                    dev_pages_ = p0 + np;
                }
                free_.erase(tailhole);
                tail_ = p0 + np;
                out = p0;
                ovc_drop(out, np);
                tr(TR_ALLOC, out, np, tail_, maint ? 1 : 0);
                (void)grow;
                return RC::OK;
            }
        }
        if (tail_ + np > lim) {
            tr(TR_NOSPACE, np, tail_, lim, maint ? 1 : 0);
#ifdef FCS_TRACE
            std::fprintf(stderr, "    NOSPACE tail=%u np=%u lim=%u cap=%u maint=%d\n", tail_, np, lim, cap_, (int)maint);
#endif
            return RC::NOSPACE;
        }
        if (tail_ + np > dev_pages_) {                 // shrink 之后要能再长回来
            if (!dev_->truncate((PageId)(tail_ + np))) return RC::NOSPACE;
            dev_pages_ = tail_ + np;
        }
#ifdef FCS_TRACE
        std::fprintf(stderr, "    alloc tail [%u,+%u)\n", tail_, np);
#endif
        out = tail_;
        tail_ += np;
        ovc_drop(out, np);                            // 回退/收缩后高水位以上的页会再被分出来
        tr(TR_ALLOC, out, np, tail_, maint ? 1 : 0);
        return RC::OK;
    }
    // 用户写入的上限：留下 1/8 给维护（压实/合并/清单），保证 GC 总有周转空间
    u32 user_lim() const { return cap_ > cap_ / 8 + 2 ? cap_ - cap_ / 8 - 2 : cap_; }
    // snap_safe: 调用方**证明**了这些页不会被任何快照读到、也不会被任何回退点需要
    //（只有 `ver > snap_max()` 的 run、以及"刚分配就失败"的新页能这么证明）。
    // 不能证明就只能 deferred_ —— 那是"快照存活期间文件只涨不落"的根源。
    void free_pages(u32 p0, u32 np, bool snap_safe = false) {
        if (p0 == NIL || np == 0) return;
        // P3：这些页上可能还有没落地的后台写（刚 put 的大值链被覆盖 / abort）。释放后立刻复用，新写（尤其是同步写的
        // 清单页）会被排在后面的旧写覆盖。等它落地；等不到（设备卡死）宁可漏掉这几页（下次挂载 rebuild_free 会找回来）。
        if (async_ && inflight_.load(std::memory_order_acquire) > 0 && !wait_pages(p0, np)) { tr(TR_FREE, p0, np, tail_, 3); return; }
#ifdef FCS_TRACE
        std::fprintf(stderr, "    free  [%u,+%u) tail=%u nsnap=%u safe=%d\n", p0, np, tail_, nsnap_, (int)snap_safe);
#endif
        inval(p0, np);
        if (nsnap_ > 0 && !snap_safe) { tr(TR_FREE, p0, np, tail_, 1); deferred_.emplace_back(np, p0); def_need_gen_ = sb_gen_ + 1; return; }
        tr(TR_FREE, p0, np, tail_, snap_safe ? 2 : 0);
        pending_free_.emplace_back(np, p0);                            // 等提交点落盘
        pend_need_gen_ = sb_gen_ + 1;                                   // 释放它的 DEL 还没落盘：要等下一个 SB
    }
    // 从空闲表里挖掉一段（重建后把“仍被更早快照引用”的页收回来）
    void carve_free(u32 p0, u32 n) {
        u32 end = p0 + n;
        auto it = free_.upper_bound(p0);
        if (it != free_.begin()) --it;
        std::vector<std::pair<u32, u32>> add;
        for (; it != free_.end() && it->first < end; ) {
            u32 a = it->first, b = it->first + it->second;
            if (b <= p0) { ++it; continue; }
            if (a < p0) add.push_back({a, p0 - a});
            if (b > end) add.push_back({end, b - end});
            it = free_.erase(it);
        }
        for (auto& e : add) free_[e.first] = e.second;
        coalesce();
    }
    void promote_pending() {
        // 提交点已落盘 ⇒ 这些页不会再被上一版状态引用：先擦除（NOR 只能 1→0），
        // 再放回空闲表，避免复用被擦写语义污染。
        // 坑 99（第 12 轮）：以前这里无条件放行，而调用点不全在 SB 之后 —— commit() 的 NOSPACE 重试路径
        // retire_dead_runs 之后直接 promote，DEL（async 时连盖住它们的 ADD）都还没落盘就把页复用；
        // R3-lite 的提交后维护更是常态化地“先释放、下个提交点才入账”。闸：自上次 free 之后必须写过 SB。
        if (sb_gen_ < pend_need_gen_) return;
        for (auto& e : pending_free_) {
            if (e.second >= tail_ || (u64)e.second + e.first > (u64)tail_) continue;  // 越过高水位：本来就可以长回来
            if (dev_) for (u32 i = 0; i < e.first; ++i) dev_->erase((PageId)(e.second + i));
            // R8：局部 TRIM 只打**这里**进入 free_ 的页 —— 它们已经过了提交点、本来就可复用；deferred_ / pending_free_
            // 里的页（快照 / 回退点还可能要读）绝不打。只打 ≥ discard_min_ 页的整段，小段不值一次系统调用。
            if (dev_ && discard_min_ && e.first >= discard_min_) dev_->discard((PageId)e.second, e.first);
            free_[e.second] = e.first;
        }
        pending_free_.clear();
        coalesce();
    }
    void coalesce() {
        for (auto it = free_.begin(); it != free_.end(); ) {
            auto nx = std::next(it);
            if (nx != free_.end() && it->first + it->second == nx->first) {
                it->second += nx->second;
                free_.erase(nx);
                continue;                       // 继续和下一个比（可能连成一片）
            }
            ++it;
        }
    }
    // 挂载时全库精确重算：段级计数清零，然后逐单元归并一次（recount 负责落账）
    void recompute_liveness() {
        for (auto& kv : runs_) ensure_meta(kv.second);
        for (auto& kv : cells_)
            for (auto& sg : kv.second->segs) sg.second.live = 0;
        for (auto& kv : runs_) { kv.second->live_recs = 0; kv.second->live_bytes = 0; }
        for (auto& kv : cells_) {
            Cell* c = kv.second;
            std::vector<Cur> cs;
            for (auto& sg : c->segs) {
                RunPtr r = runs_[sg.second.rid];
                if (!r || sg.second.p0 >= sg.second.p1) continue;
                cs.emplace_back();
                cs.back().r = r;
                cs.back().p0 = sg.second.p0;
                cs.back().p1 = std::min(sg.second.p1, r->npages);
                cs.back().klo = sg.second.klo;
                cs.back().khi = sg.second.khi;
                cs.back().load(this);
            }
            merge_emit(c, cs, [&](u64, u32, const u8*, u16, u32 osz, RunPtr src, const u8*) {
                if (src) src->live_bytes += osz;      // 字节口径：赢家来自哪条 run
                return true;
            }, false);
            recount(c);                                // 记录数：段级精确落账
        }
    }

    // 零写回收：整条 run 的记录都已被更新版本覆盖 ⇒ 直接摘链释放，一个字节都不用重写。
    // 这是热键/覆盖型负载的主要空间回收路径（垃圾天然成整条 run）。
    void retire_dead_runs(std::vector<ManEnt>& delta) {
        // 快照存活时不再整体停摆：只跳过 ver <= **最新**快照的 run。
        // 用最新而不是最老，是因为视图 V 看见的是 ver <= V 的记录：
        // 一条 ver=150 的 run 在"最老快照 100 / 较新快照 200"下仍是 200 那一版的数据。
        const u32 vmax = snap_max();
        const bool has_snap = nsnap_ > 0;
        bool again = true;
        while (again) {
            again = false;
            RunPtr dead = nullptr;
            for (auto& kv : runs_) {
                if (has_snap && kv.second->ver <= vmax) continue;
                if (kv.second->live_recs == 0 && kv.second->nrec > 0) {
                    u32 ex = exact_live_recs(kv.second);     // 保守校准：段级账自 f6 起精确，这里只是退休前最后一道核对（坑 92：只看被引用的段）
                    if (ex) {
                        kv.second->live_recs = ex; continue;
                    }
                    dead = kv.second; break;
                }
            }
            if (!dead) return;
            for (auto& kv : cells_) {
                Cell* c = kv.second;
                auto f = c->segs.begin();
                while (f != c->segs.end() && f->second.rid != dead->page0) ++f;
                if (f == c->segs.end()) continue;
                ManEnt m;
                m.op = M_SEG_DEL;
                m.key = c->lo;
                m.page0 = dead->page0;
                m.seq = dead->seq;            // 段身份 = (单元, run, seq)：页号会被复用
                delta.push_back(m);
                c->pages -= f->second.p1 - f->second.p0;
                seg_set_live(f->second, 0);
                ref_dec(f->second.rid);
                c->segs.erase(f);
                if (c->acct) recount(c);   // 该段记录全部是垃圾 ⇒ dead 立即下降（未知单元留给补算）
            }
#ifdef FCS_TRACE
            std::fprintf(stderr, "  RETIRE run seq=%u rid=%u npg=%u nrec=%u\n", dead->seq, dead->page0, dead->npages, dead->nrec);
            n_retired_++;
#endif
            tr(TR_RETIRE, dead->page0, run_block(dead), dead->seq);
            delta.push_back(run_ent(dead, M_RUN_DEL));
            const bool safe = run_page_safe(dead);      // 走到这里必有 ver > vmax（或没有快照）
            free_ovfl_of(dead, safe);
            free_pages(dead->page0, run_block(dead), safe);
            runs_.erase(dead->page0);
            delete dead;
            again = true;
        }
    }

    void rebuild_free() {
        free_.clear();
        std::vector<std::pair<u32, u32>> used;
        for (auto& kv : runs_) {
            ensure_aux(kv.second);
            used.push_back({kv.second->page0, run_block(kv.second)});
            // 溢出链 / 附件页也是活数据：漏算的话挂载后分配器会把它们当空闲页发出去
            std::vector<std::pair<u32, u32>> ex;
            collect_ovfl(kv.second, ex);
            for (auto& e : ex) used.push_back(e);
            if (kv.second->aux_npg) used.push_back({kv.second->aux_pg, kv.second->aux_npg});
        }
        if (man_last_ != NIL) {
            u32 pid = man_last_;
            for (u32 i = 0; i < nman_ && pid != NIL; ++i) {
                const u8* p = page(pid);
                u32 prev = p ? rd32(p + 4) : (u32)NIL;
                used.push_back({pid, 1});
                pid = prev;
            }
        }
        for_each_mem_chain([&](const OvflDesc& d) { used.push_back({d.pg0, d.npages}); });   // 坑 74
        // 坑 87（P5 放开快照期 shrink 后 g5 seed 1 第 556 步 rollback CORRUPT）：两张"还没归位"的表不是空闲页 ——
        // deferred_ 是回退点还要用的页（快照的清单页 / 老 run），pending_free_ 要等提交点持久。
        // 以前只有 rollback 记得在 rebuild 之后 carve 一遍；shrink / reload 走到这里就把它们当空闲发出去了
        //（trace：SNAP tail=16 man_last=6 → checkpoint FREE [6] deferred → SHRINK → RELOC ALLOC [6] user）。
        for (auto& d : deferred_) used.push_back({d.second, d.first});
        for (auto& d : pending_free_) used.push_back({d.second, d.first});
        std::sort(used.begin(), used.end());
        u32 cur = 2;
        for (auto& u : used) {
            if (u.first > cur) free_[cur] = u.first - cur;
            cur = std::max(cur, u.first + u.second);
        }
        if (cur < tail_) free_[cur] = tail_ - cur;
        coalesce();
    }

    // ------------------------------------------------------------ 段写入
    struct RunWriter {
        // 所有数据页**连续**存放（B4）：一条 run 一次 write_multi 落盘（FileDev 一次 pwrite），
        // 异步模式下整块缓冲直接移交 IO 线程（零拷贝）；以前是 vector<vector<u8>>，每页一次分配 + 一次写调用。
        std::vector<u8> pbuf;
        u32 npages() const { return (u32)(pbuf.size() / PAGE); }
        u8* pg(u32 i) { return pbuf.data() + (size_t)i * PAGE; }
        u8* last_pg() { return pbuf.data() + pbuf.size() - PAGE; }
        void new_page() { pbuf.resize(pbuf.size() + PAGE, 0); }
        void drop_last() { pbuf.resize(pbuf.size() - PAGE); }
        std::vector<u64> fences;
        u32 off = DHDR, prec = 0, ver = 0;
        std::vector<SpEnt> sp;
        std::vector<u64> kidx;
        std::vector<u32> osz;              // 每条记录的页上占用（封页时才知道，与写入顺序一致）
        u32 off_un = DHDR, sum_len = 0;    // 暂存区未压缩偏移 + Σ(len 取偶)
        std::vector<u8> stage;             // 未压缩暂存（压紧的源），封页时才压进 PAGE
        bool want_kidx = false;
        Store* st = nullptr;               // 溢出值要落页，必须能分配
        std::vector<std::pair<u32, u32>> chains;   // 本次写**自有**的溢出链（失败时要还回去）
        std::vector<std::pair<u32, u32>> takes;    // 接管来的链（不复制数据，所有权转移）
        std::vector<std::pair<u32, u32>> loc;      // 每条溢出记录的 (数据页, 描述符偏移)
        bool taking = false;               // add_take() 期间为真
        static constexpr u32 SP = 16;
        // 本页若按 pfx 压缩，占多少字节：n*(10-pfx) + Σ(len 取偶)
        u32 pg_used(u32 n, u32 sl, u8 pfx) const { return DHDR + n * (10u - pfx) + sl; }
        u64 first = 0, last = 0, pfirst = 0, plast = 0;
        u32 nrec = 0, nbytes = 0, novfl = 0;
        Bloom bloom;

        explicit RunWriter(u32 v, u32 nkeys = 256, u64 reserve_bytes = 0) : ver(v) {
            if (reserve_bytes) pbuf.reserve((size_t)std::min<u64>(reserve_bytes + PAGE, (u64)1 << 31));
            new_page();
            stage.assign(6u * PAGE, 0);
            bloom.reset(nkeys ? nkeys : 256);
        }
        // 封页：算本页前缀 → 就地压紧 → 重建稀疏索引（偏移变了，必须在压紧之后）
        void close_page() {
            if (!prec) return;                            // 空页不封
            u8* p = last_pg();
            const u8* sg = stage.data();
            const u32 n = prec;
            u8 pfx = 0;
            if (n > 1) {
                u64 x = pfirst ^ plast;
                pfx = x ? (u8)(__builtin_clzll(x) >> 3) : 7;   // 首末键的公共高位字节数
                if (pfx > 7) pfx = 7;
                // add() 按同一公式精确判满，故这里 pfx 一定装得下；仅防御性下调不可能发生
                u32 base = DHDR + n * 10u + sum_len;               // pfx=0 时的占用
                if (base > PAGE) {                                 // 真放不下才降到最小可行前缀
                    u32 need = (base - PAGE + n - 1) / n;
                    if (need > pfx) pfx = (u8)(need > 7 ? 7 : need);
                }
            }
            u32 src = DHDR, dst = DHDR;
            for (u32 i = 0; i < n; ++i) {
                u16 len;
                std::memcpy(&len, sg + src + 8, 2);
                u32 vn = 2u + (len == OVFL_MARK ? 16u : ((len + 1u) & ~1u));
                std::memcpy(p + dst, sg + src, 8 - pfx);            // 键后缀
                std::memcpy(p + dst + (8 - pfx), sg + src + 8, vn); // len + 值
                src += rec_size(len);
                dst += (8 - pfx) + vn;
            }
            off = dst;
            nbytes -= n * (u32)pfx;
#ifdef FCS_DBG_PFX
            if (dst > PAGE) { std::printf("PFX OVF n=%u sum_len=%u pfx=%u dst=%u\n", n, sum_len, pfx, dst); std::abort(); }
#endif
            put_pg_hdr(p, ver, pfirst, plast, (u16)n, (u16)off, pfx);
            u32 base = nrec - n, o = DHDR;
            size_t lp = 0;                       // loc 里的游标（与 blob 记录同序）
            for (u32 j = 0; j < n; ++j) {
                u64 k = pg_key_at(p, o);
                u16 len;
                std::memcpy(&len, p + o + (8 - pfx), 2);
                u32 rs = pg_rec_size(pfx, len);
                osz.push_back(rs);
                const u32 pi = npages() - 1;
                if (len == OVFL_MARK) {
                    while (lp < loc.size() && loc[lp].second != 0xFFFFFFFFu) ++lp;
                    if (lp < loc.size() && loc[lp].first == pi) loc[lp].second = o;
                    else { loc.push_back({pi, o}); }   // 防御：正常不会走到
                }
                if ((base + j) % SP == 0 && pi < SP_MAX_PAGES) sp.push_back(SpEnt{k, k, sp_pack(pi, o)});
                else if (!sp.empty()) sp.back().last = k;
                o += rs;
            }
        }
        // 接管一条已存在的链：页上照抄 16 B 描述符，不复制链的数据。
        // dsc 来自源 run 的页（调用方保证在 add 期间有效），loc 由 add_impl 记。
        bool add_take(u64 k, u32 v, const u8* dsc) {
            if (!st) return false;
            takes.push_back({rd32(dsc), rd32(dsc + 4)});
            taking = true;
            bool ok = add_impl(k, v, dsc, OVFL_MARK);
            taking = false;
            return ok;
        }
        // 页上已有一份溢出描述符（memtable 里早就落好了链）⇒ 直接照抄
        bool add_desc(u64 k, u32 v, const u8* dsc) {
            if (st) chains.push_back({rd32(dsc), rd32(dsc + 4)});   // 链的所有权转移给本 run
            return add_impl(k, v, dsc, OVFL_MARK);
        }
        // 写失败：把已经分配的链还回去（否则这些页要等到下次挂载 rebuild_free 才回到池子）
        void abandon() {
            if (!st) return;
            for (auto& c : chains) st->free_pages(c.first, c.second, true);
            chains.clear();
        }
        bool add(u64 k, u32 v, const u8* val, u16 len) {
            if (len > INLINE_VAL_MAX) {                      // 大值：落溢出链
                u8 dsc[16];
                OvflDesc d;
                if (!st || st->write_ovfl(val, len, d) != RC::OK) return false;
                chains.push_back({d.pg0, d.npages});
                put_desc(dsc, d);
                return add_impl(k, v, dsc, OVFL_MARK);
            }
            return add_impl(k, v, val, len);
        }
        bool add_impl(u64 k, u32 v, const u8* sv, u16 slen) {
            const u32 rl = (slen == OVFL_MARK) ? 16u : ((slen + 1u) & ~1u);
            if (prec) {
                // 本页若收下这条，前缀是 (首键,新键) 的公共高位；据此算真实占用
                u64 x = pfirst ^ k;
                u32 pfx2 = x ? (u32)(__builtin_clzll(x) >> 3) : 7;
                if (pfx2 > 7) pfx2 = 7;
                if (DHDR + (prec + 1) * 10u + (sum_len + rl) - (prec + 1) * pfx2 > PAGE) {
                    close_page();
                    new_page();
                    off = DHDR; off_un = DHDR; sum_len = 0; prec = 0;
                }
            } else if (DHDR + rec_size(slen) > PAGE) {
                return false;                          // 单条都放不下
            }
            if (want_kidx) kidx.push_back(k);
            if (prec == 0) { pfirst = k; fences.push_back(k); if (nrec == 0) first = k; }
            if (slen == OVFL_MARK) loc.push_back({npages() - 1, 0xFFFFFFFFu});  // 偏移先占位
            u8* q = stage.data() + off_un;
            std::memcpy(q, &k, 8);
            std::memcpy(q + 8, &slen, 2);
            {
                u32 vn = (slen == OVFL_MARK) ? 16u : (u32)slen;
                if (vn) std::memcpy(q + 10, sv, vn);
            }
            off_un += rec_size(slen);
            sum_len += rl;
            {
                u64 x = pfirst ^ k;
                u32 pfx = prec > 1 ? (u32)(__builtin_clzll(x) >> 3) : (prec == 1 ? (u32)(__builtin_clzll(x) >> 3) : 0);
                if (pfx > 7) pfx = 7;
                off = DHDR + (prec + 1) * 10u + sum_len - (prec + 1) * pfx;
            }
            bloom.add(khash(k));
            ++prec; ++nrec; nbytes += rec_size(slen);
            if (slen == OVFL_MARK) ++novfl;
            plast = k; last = k;
            return true;
        }
    };


    // ------------------------------------------------------------ run 元数据页
    // 挂载时原本要把整库每个数据页读一遍，重建 fences / pbytes / sp / bloom
    //（O(总页数)，一个 400 MB 的库光这一段就是几十毫秒）。这些全是 run 的**派生**量、
    // 写完就再也不会变，所以封 run 时顺手存一份，挂载只读它。
    // 位置 = 数据页区间之后的连续 mnpg 页，不需要改清单格式：
    // 旧文件在那儿读到的是别的数据页/空页，magic 对不上就退回逐页扫描。
    //
    // 每页：u32 magic | u32 idx | u32 npg | u32 crc | u32 len | payload[len]
    // 页 0 的 payload 头（56 B）：magic2 page0 npages nrec nbytes nsp nkid bwords bits first last
    // 其后依次：fences[8] pbytes[4] pnrec[2] sp[20] kidx[8] bloom[8]
    static constexpr u32 RM_PHDR = 20, RM_HDR = 56;

    // ------------------------------------------------------------ 溢出值
    // 页格式： u32 magic('OVFL') | u32 next | u32 off | u32 len | data[...]
    // 链是按写入顺序串起来的；读到 magic 不对/长度超界就返回 IO。


    struct OvflDesc { u32 pg0 = 0, npages = 0, total = 0, crc = 0; };
    static OvflDesc desc_of(const u8* v) {
        OvflDesc d;
        std::memcpy(&d, v, 16);
        return d;
    }
    static void put_desc(u8* v, const OvflDesc& d) { std::memcpy(v, &d, 16); }

    // 把一段值写成溢出链。失败时把已占的页退回空闲表。
    // bg：P3（第 9 轮）—— put 路径上的大值链交给 IO 线程写（run 页早就是这么走的），前台只剩分配 + 一次拷贝。
    // 读者靠 hang_ 等它落地（read_ovfl 先 wait_pages）；释放靠 free_pages 先 wait_pages（链被覆盖/abort 时可能还在飞）；
    // 提交点靠 commit_delta 的 wait_io（链不落地 SB 不写）。维护路径（归并物化大值）仍同步写：它们本来就在提交点之前排空。
    RC write_ovfl(const u8* data, u32 total, OvflDesc& d, bool bg = false) {
        u32 np = (total + OV_CAP - 1) / OV_CAP;
        if (np == 0) np = 1;
        u32 p0 = 0;
        if (alloc_pages(np, p0, false) != RC::OK) return RC::NOSPACE;
        d.pg0 = p0; d.npages = np; d.total = total; d.crc = crc32c(data, total);
        if (bg && async_) {
            auto fillp = [&](u8* pg, u32 i) {
                const u32 off = i * OV_CAP, n = std::min<u32>(OV_CAP, total - off);
                wr32(pg, 0x4C46564Fu); wr32(pg + 4, (i + 1 < np) ? p0 + i + 1 : (u32)NIL); wr32(pg + 8, off); wr32(pg + 12, n);
                if (n) std::memcpy(pg + OV_HDR, data + off, n);
                return (OV_HDR + n + 3u) & ~3u;
            };
            std::vector<IoJob> jobs;
            if (np > 1) {                                   // 前 np-1 页满页：一块整写（与同步路径字节数相同）
                IoJob j; j.pid = p0; j.n = np - 1;
                j.buf = std::make_shared<std::vector<u8>>((size_t)(np - 1) * PAGE, 0);
                for (u32 i = 0; i + 1 < np; ++i) wr_flush_ += fillp(j.buf->data() + (size_t)i * PAGE, i);
                jobs.push_back(std::move(j));
            }
            {
                IoJob j; j.pid = p0 + np - 1; j.n = 1;
                u8 pg[PAGE]; std::memset(pg, 0, PAGE);
                const u32 wlen = fillp(pg, np - 1);
                j.img.assign(pg, pg + wlen);
                wr_flush_ += wlen;
                jobs.push_back(std::move(j));
            }
            inval(p0, np);
            enqueue_batch(jobs);
            return RC::OK;
        }
        // B4：前 np-1 页都是满页（各装 OV_CAP 字节）⇒ 拼成一块一次 write_multi；末页只写用到的字节
        //（写放大口径不变）。以前每页一次分配 + 一次写调用，8 KB 值就是 3 次 pwrite。
        auto fail = [&]() {
            for (u32 j = 0; j < np; ++j) dev_->erase((PageId)(p0 + j));
            free_pages(p0, np, true);          // 刚分配、还没被任何清单项引用
            promote_pending();
            return RC::IO;
        };
        auto fill = [&](u8* pg, u32 i) {
            u32 off = i * OV_CAP;
            u32 n = std::min<u32>(OV_CAP, total - off);
            wr32(pg, 0x4C46564Fu);                        // 'OVFL'
            wr32(pg + 4, (i + 1 < np) ? p0 + i + 1 : (u32)NIL);
            wr32(pg + 8, off);
            wr32(pg + 12, n);
            if (n) std::memcpy(pg + OV_HDR, data + off, n);
            return (OV_HDR + n + 3u) & ~3u;
        };
        if (np > 1) {
            // 前 np-1 页都是满页（各 OV_CAP 字节 ⇒ wlen == PAGE），整页写与按用量写字节相同；
            // 偏好整页的设备拼成一块一次写，其他设备逐页写（故障注入按页计）。
            std::vector<u8> blk((size_t)(np - 1) * PAGE, 0);
            for (u32 i = 0; i + 1 < np; ++i) wr_flush_ += fill(blk.data() + (size_t)i * PAGE, i);
            if (dev_->whole_pages()) {
                constexpr u32 CHUNK = 256;
                for (u32 i = 0; i + 1 < np; i += CHUNK) {
                    const u32 n = std::min<u32>(CHUNK, np - 1 - i);
                    if (dev_->write_multi((PageId)(p0 + i), n, blk.data() + (size_t)i * PAGE) != RC::OK) return fail();
                }
            } else {
                for (u32 i = 0; i + 1 < np; ++i)
                    if (dev_->write((PageId)(p0 + i), 0, blk.data() + (size_t)i * PAGE, PAGE) != RC::OK) return fail();
            }
        }
        {
            u8 pg[PAGE];
            std::memset(pg, 0, PAGE);
            const u32 wlen = fill(pg, np - 1);
            if (dev_->write((PageId)(p0 + np - 1), 0, pg, wlen) != RC::OK) return fail();
            wr_flush_ += wlen;
        }
        inval(p0, np);
        return RC::OK;
    }

    // ------------------------------------------------------------ 溢出链小缓存
    // 键 = 整个 16 B 描述符（pg0/npages/total/crc）；页被重新分配时（alloc_pages）按页区间失效，
    // 重载/回退（clear_state）整体清空。链本身不可变，所以命中就是对的。
    // 准入：**第二次**读到同一条链才收（ghost 表记最近一次未命中的 pg0）。
    // 一遍扫过去的大值（select / bigscan）因此根本不进缓存：既不污染、也不付那次 8 KB 拷贝。
    // 淘汰时复用被淘汰条目的缓冲，不反复 malloc。
    // 剩下的坑：工作集略大于缓存的**循环**访问（LRU 的老问题）会全 miss 并照付拷贝，实测 +20% 左右。
    struct OvcEnt { OvflDesc d; u64 tick = 0; std::vector<u8> val; };
    std::vector<OvcEnt> ovc_;
    u64 ovc_bytes_ = 0, ovc_tick_ = 0, ovc_hits_ = 0, ovc_misses_ = 0;
    u32 ovc_max_bytes_ = 256u * 1024u;
    u32 ovc_ghost_[1024] = {};                         // 直接映射：最近 miss 过的 pg0（0 = 空）
    u32 ovc_wn_ = 0, ovc_wh_ = 0;                      // 当前窗口的查找数/命中数
    bool ovc_slow_ = false;                            // 上一窗口命中率 < 1/8 ⇒ 限速准入
    void ovc_clear() { std::lock_guard<std::mutex> g(ovc_mu_); ovc_.clear(); ovc_bytes_ = 0; std::memset(ovc_ghost_, 0, sizeof ovc_ghost_); ovc_wn_ = ovc_wh_ = 0; ovc_slow_ = false; }
    void ovc_window(bool hit) {                        // 每 256 次查找结一次账
        ovc_wn_++; ovc_wh_ += hit;
        if (ovc_wn_ >= 256) { ovc_slow_ = ovc_wh_ * 8 < ovc_wn_; ovc_wn_ = ovc_wh_ = 0; }
    }
    bool ovc_admit(u32 pg0) {                          // 见过一次才准入
        // 抖动保护：上一窗口几乎不命中（循环访问的工作集比缓存大，或纯扫描）时只放行 1/8 的候选。
        // 纯 LRU 在"工作集 = 1.5× 缓存"的循环下命中率是 0 还白付每次 8 KB 拷贝；限速之后
        // 缓存内容换得慢，反而能留住一部分（实测 256 KB 缓存、循环读 48/64 个 8 KB 值：命中 29%/21%，耗时与无缓存持平）。
        if (ovc_slow_ && (++ovc_tick_ & 7u) != 0) return false;
        // 用 khash 而不是乘法散列取高位：链首页号是等差数列（步长 = 一批大值的页数），
        // 乘法散列的高 8 位把它们两两撞到同一槽（实测 377/1131、756/1510 …），准入形同虚设。
        u32& g = ovc_ghost_[khash(pg0) & 1023u];
        if (g == pg0) return true;
        g = pg0;
        return false;
    }
    void ovc_drop(u32 p0, u32 np) {                    // 与 [p0,p0+np) 相交的条目失效
        std::lock_guard<std::mutex> g(ovc_mu_);
        if (ovc_.empty()) return;
        for (size_t i = 0; i < ovc_.size(); ) {
            const OvflDesc& d = ovc_[i].d;
            if (d.pg0 < p0 + np && p0 < d.pg0 + d.npages) {
                ovc_bytes_ -= ovc_[i].val.size();
                ovc_[i] = std::move(ovc_.back()); ovc_.pop_back();
            } else ++i;
        }
    }
    // 命中就在锁内抄给调用方：条目会被别的读者的 ovc_put 搬动/淘汰，指针不能带出锁外
    bool ovc_lookup(const OvflDesc& d, u8* dst, u32 cap) {
        std::lock_guard<std::mutex> g(ovc_mu_);
        for (auto& e : ovc_)
            if (e.d.pg0 == d.pg0 && e.d.npages == d.npages && e.d.total == d.total && e.d.crc == d.crc) {
                e.tick = ++ovc_tick_;
                if (dst && cap) std::memcpy(dst, e.val.data(), std::min<u32>(cap, d.total));
                ++ovc_hits_; ovc_window(true);
                return true;
            }
        ++ovc_misses_; ovc_window(false);
        return false;
    }
    void ovc_put(const OvflDesc& d, const u8* v) {
        std::lock_guard<std::mutex> g(ovc_mu_);
        if (!ovc_max_bytes_ || d.total > ovc_max_bytes_ || !ovc_admit(d.pg0)) return;
        std::vector<u8> buf;                                                // 尽量接手被淘汰者的缓冲
        while (!ovc_.empty() && ovc_bytes_ + d.total > ovc_max_bytes_) {   // 淘汰最久未用
            size_t victim = 0;
            for (size_t i = 1; i < ovc_.size(); ++i) if (ovc_[i].tick < ovc_[victim].tick) victim = i;
            ovc_bytes_ -= ovc_[victim].val.size();
            if (buf.capacity() < d.total) buf.swap(ovc_[victim].val);
            ovc_[victim] = std::move(ovc_.back()); ovc_.pop_back();
        }
        buf.assign(v, v + d.total);
        ovc_.push_back(OvcEnt{d, ++ovc_tick_, std::move(buf)});
        ovc_bytes_ += d.total;
    }

    // 把溢出值读进 dst（最多 cap 字节），olen = 逻辑长度。
    // cacheable=false：scrub/verify 这类要看介质的调用方，绕过缓存。
    // 大值直接读进调用方缓冲（省掉一次 8~64 KB 的中转拷贝）。
    // 调用方缓冲装不下整值时退回"物化再截断"：read_ovfl 只在拿到整值时校验链 CRC，截断读不能绕过校验。
    RC get_ovfl_into(const OvflDesc& d, void* out, u16 cap, u16* olen) {
        if (olen) *olen = (u16)d.total;
        if (!out || !cap) return RC::OK;
        if (cap >= d.total) return read_ovfl(d, (u8*)out, cap, nullptr);
        std::vector<u8> tmp(d.total ? d.total : 1);
        if (read_ovfl(d, tmp.data(), d.total, nullptr) != RC::OK) return RC::CORRUPT;
        std::memcpy(out, tmp.data(), cap);
        return RC::OK;
    }
    RC read_ovfl(const OvflDesc& d, u8* dst, u32 cap, u32* olen, bool cacheable = true) {
        if (olen) *olen = d.total;
        if (d.npages == 0 || d.npages > cap_) return RC::CORRUPT;
        if (cacheable && ovc_max_bytes_ && ovc_lookup(d, dst, cap)) return RC::OK;
        if (!wait_pages(d.pg0, d.npages)) return RC::IO;  // P3：链可能还在 IO 线程手里（裸读不经过 page()）
        std::vector<u8>& ovfl_buf_ = tls().ovfl_buf;      // 每线程一份暂存（并发读者各用各的）
        u32 got = 0, pid = d.pg0;
        // 链是 alloc_pages 给的一段**连续**页（next 恒等于 pid+1）⇒ 可以按 8 页一批 read_multi，
        // 而且**不经过页缓存**（链是写一次就不变的；读进暂存区，别把数据页缓存踢干净）。
        // 实测 2000 个 8 KB 值：逐页 6050 次 pread → 768 次。
        const u32 CH = 8;
        for (u32 i = 0; i < d.npages; ) {
            const u32 k = std::min<u32>(CH, d.npages - i);
            if (ovfl_buf_.size() < (size_t)k * PAGE) ovfl_buf_.resize((size_t)k * PAGE);
            if (dev_->read_multi(pid, k, ovfl_buf_.data()) != RC::OK) return RC::CORRUPT;
            for (u32 j = 0; j < k; ++j) {
                const u8* p = ovfl_buf_.data() + (size_t)j * PAGE;
                if (rd32(p) != 0x4C46564Fu) return RC::CORRUPT;
                const u32 next = rd32(p + 4), off = rd32(p + 8), n = rd32(p + 12);
                if (off != got || n > OV_CAP) return RC::CORRUPT;
                if (i + j + 1 < d.npages && next != pid + j + 1) return RC::CORRUPT;   // 链必须连续
                if (dst && got < cap) std::memcpy(dst + got, p + OV_HDR, std::min(n, cap - got));
                got += n;
            }
            pid += k;
            i += k;
        }
        if (got != d.total) return RC::CORRUPT;
        // 描述符里的 crc 覆盖整条链的**载荷**（写的时候就算好了）：
        // 页头有 CRC 挡不住"载荷里翻了一位"，但这里一比就出来了。
        if (dst && cap >= d.total && crc32c(dst, d.total) != d.crc) return RC::CORRUPT;
        if (cacheable && dst && cap >= d.total) ovc_put(d, dst);      // 只缓存校验过的整值
        return RC::OK;
    }

    static u64 rmeta_size_pre(u32 npg, u64 nsp, u64 nkid, u64 bwords) {
        return (u64)RM_HDR + 14ull * npg + 20ull * nsp + 8ull * nkid + 8ull * bwords;
    }
    static u64 rmeta_size(const Run* r) {
        return (u64)RM_HDR + 14ull * r->npages + 20ull * r->sp.size()
             + 8ull * r->kidx.size() + 8ull * r->bloom.w.size();
    }
    static u32 rmeta_pages(u64 bytes) {
        u64 cap = PAGE - RM_PHDR;
        return (u32)((bytes + cap - 1) / cap);
    }

    static void build_rmeta(const Run* r, std::vector<u8>& b) {
        b.assign((size_t)rmeta_size(r), 0);
        u8* p = b.data();
        wr32(p + 0, 0x31544D52u);                 // 'RMT1'
        wr32(p + 4, r->page0);  wr32(p + 8, r->npages);  wr32(p + 12, r->nrec);
        wr32(p + 16, r->nbytes); wr32(p + 20, (u32)r->sp.size());
        wr32(p + 24, (u32)r->kidx.size()); wr32(p + 28, (u32)r->bloom.w.size());
        wr32(p + 32, r->bloom.bits);        wr32(p + 36, r->mnpg);
        std::memcpy(p + 40, &r->first, 8);
        std::memcpy(p + 48, &r->last, 8);
        u8* q = p + RM_HDR;
        for (u32 i = 0; i < r->npages; ++i) { std::memcpy(q, &r->fences[i], 8); q += 8; }
        for (u32 i = 0; i < r->npages; ++i) { std::memcpy(q, &r->pbytes[i], 4); q += 4; }
        for (u32 i = 0; i < r->npages; ++i) { u16 v = i < r->pnrec.size() ? r->pnrec[i] : 0; std::memcpy(q, &v, 2); q += 2; }
        for (auto& e : r->sp) { std::memcpy(q, &e.first, 8); std::memcpy(q + 8, &e.last, 8); std::memcpy(q + 16, &e.packed, 4); q += 20; }
        for (u64 v : r->kidx) { std::memcpy(q, &v, 8); q += 8; }
        if (!r->bloom.w.empty()) std::memcpy(q, r->bloom.w.data(), r->bloom.w.size() * 8);
    }

    // 把 meta 页写进 [pg0, pg0+mnpg)。只写用到的字节（4 B 对齐），页尾不产生写放大。
    RC write_rmeta(const Run* r, u32 pg0, std::vector<IoJob>* jobs, u64& bytes_out) {
        std::vector<u8> b;
        build_rmeta(r, b);
        const u32 mnp = rmeta_pages(b.size());
        const u32 cap = PAGE - RM_PHDR;
        for (u32 i = 0; i < mnp; ++i) {
            u32 off = i * cap;
            u32 n = (u32)std::min<u64>(cap, (u64)b.size() - off);
            std::vector<u8> pg(PAGE, 0);
            wr32(pg.data() + 0, PK_RMETA);
            wr32(pg.data() + 4, i);
            wr32(pg.data() + 8, mnp);
            wr32(pg.data() + 12, crc32c(b.data() + off, n));
            wr32(pg.data() + 16, n);
            std::memcpy(pg.data() + RM_PHDR, b.data() + off, n);
            u32 wlen = (n + RM_PHDR + 3u) & ~3u;
            if (jobs) {
                IoJob j; j.pid = pg0 + i; j.img.assign(pg.begin(), pg.begin() + wlen);
                jobs->push_back(std::move(j));
            } else if (dev_->write((PageId)(pg0 + i), 0, pg.data(), wlen) != RC::OK) {
                return RC::IO;
            }
            bytes_out += wlen;
        }
        return RC::OK;
    }

    // 从 pg0 处的 meta 页恢复 run 的派生数组。任何一处对不上就返回 false（调用方退回扫描）。
    bool load_rmeta(Run* r, u32 pg0, u32 expect_npg, const ManEnt& m) {
        std::vector<u8> b;
        u32 mnp = 0;
        for (u32 i = 0;; ++i) {
            const u8* p = page(pg0 + i);
            if (!p || rd32(p) != PK_RMETA) return false;
            u32 idx = rd32(p + 4), npg = rd32(p + 8), n = rd32(p + 16);
            if (idx != i || n > PAGE - RM_PHDR) return false;
            // 上界只做“别读疯了”的粗保护：真正的判定靠每页 CRC + 与清单逐字段对账。
            if (i == 0) { mnp = npg; if (mnp == 0 || mnp > 1 + 4 * expect_npg) return false; }
            if (npg != mnp) return false;
            if (crc32c(p + RM_PHDR, n) != rd32(p + 12)) return false;
            b.insert(b.end(), p + RM_PHDR, p + RM_PHDR + n);
            if (i + 1 == mnp) break;
        }
        if (b.size() < RM_HDR) return false;
        const u8* p = b.data();
        if (rd32(p) != 0x31544D52u) return false;
        const u32 page0 = rd32(p + 4), npg = rd32(p + 8), nrec = rd32(p + 12);
        const u32 nbytes = rd32(p + 16), nsp = rd32(p + 20), nkid = rd32(p + 24);
        const u32 bwords = rd32(p + 28), bits = rd32(p + 32), selfpg = rd32(p + 36);
        u64 first = 0, last = 0;
        std::memcpy(&first, p + 40, 8);
        std::memcpy(&last, p + 48, 8);
        // 与清单条目逐字段对账：meta 页被复用/半写都会被这里挡掉
        if (page0 != m.page0 || npg != m.npages || npg != expect_npg) return false;
        if (first != m.key || last != m.last) return false;
        if (nbytes != m.nbytes) return false;
        if (selfpg != mnp) return false;
        if (nsp > 64ull * npg || nkid > 1ull << 24 || bwords > (1ull << 22)) return false;
        if (b.size() != rmeta_size_raw(npg, nsp, nkid, bwords)) return false;
        const u8* q = p + RM_HDR;
        r->fences.resize(npg);
        r->pbytes.resize(npg);
        for (u32 i = 0; i < npg; ++i) { std::memcpy(&r->fences[i], q, 8); q += 8; }
        for (u32 i = 0; i < npg; ++i) { std::memcpy(&r->pbytes[i], q, 4); q += 4; }
        r->pnrec.resize(npg);
        for (u32 i = 0; i < npg; ++i) { std::memcpy(&r->pnrec[i], q, 2); q += 2; }
        r->sp.resize(nsp);
        for (u32 i = 0; i < nsp; ++i) { std::memcpy(&r->sp[i].first, q, 8); std::memcpy(&r->sp[i].last, q + 8, 8); std::memcpy(&r->sp[i].packed, q + 16, 4); q += 20; }
        r->kidx.resize(nkid);
        for (u32 i = 0; i < nkid; ++i) { std::memcpy(&r->kidx[i], q, 8); q += 8; }
        r->bloom.w.resize(bwords);
        if (bwords) std::memcpy(r->bloom.w.data(), q, bwords * 8);
        r->bloom.bits = bits;
        r->bloom.nk = nrec;
        r->nrec = nrec;
        // novfl 没存进 meta（省 4 B/run）。置成哨兵值 0xFFFFFFFF 表示"未知"，
        // 释放/重建空闲表之前会先数一遍（count_ovfl）。
        r->novfl = 0xFFFFFFFFu;
        rebuild_pcum(r);
        return true;
    }
    static u64 rmeta_size_raw(u32 npg, u32 nsp, u32 nkid, u32 bwords) {
        return (u64)RM_HDR + 14ull * npg + 20ull * nsp + 8ull * nkid + 8ull * bwords;
    }

    // 老文件 / meta 校验失败时的兜底：逐页扫描重建派生数组
    void scan_meta(Run* r) {
        r->nrec = 0; r->nrec_idx = 0;
        r->sp.clear();
        if (r->kidx.empty()) {} else r->kidx.clear();
        r->fences.assign(r->npages, 0);
        r->pbytes.assign(r->npages, 0);
        r->pnrec.assign(r->npages, 0);
        for (u32 i = 0; i < r->npages; ++i) {
            const u8* p = page(r->page0 + i);
            if (!p) continue;
            std::memcpy(&r->fences[i], p + 16, 8);
            u16 used = rd16(p + 34);
            r->pbytes[i] = used >= DHDR && used <= PAGE ? (u32)(used - DHDR) : 0;
            r->pnrec[i] = rd16(p + 32);
            r->nrec += rd16(p + 32);
            if (r->bloom.bits == 0) r->bloom.reset(rd16(p + 32) * r->npages);
            if (used >= DHDR && used <= PAGE) {
                u8 pf = pg_pfx(p);
                u32 off2 = DHDR;
                while (off2 + pg_rec_size(pf, 0) <= used) {
                    RecHdr h2;
                    rd_rec(p, off2, h2);
                    u32 rs = pg_rec_size(pf, h2.len);
                    if (off2 + rs > used) break;
                    r->bloom.add(khash(h2.key));
                    if (keyidx_) r->kidx.push_back(h2.key);
                    if (h2.len == OVFL_MARK) ++r->novfl;
                    if (r->nrec_idx % 16 == 0 && i < SP_MAX_PAGES) r->sp.push_back(SpEnt{h2.key, h2.key, sp_pack(i, off2)});
                    else if (!r->sp.empty()) r->sp.back().last = h2.key;
                    ++r->nrec_idx;
                    off2 += rs;
                }
            }
        }
        rebuild_pcum(r);
    }

    // 把一个 run 的派生数组准备好（挂载后的第一次使用 / 老格式回退）
    void ensure_meta(Run* r) {
        if (!r) return;
        u8 st = r->meta_pending.load(std::memory_order_acquire);
        if (st == 0) return;
        if (!xl_.held_by_me()) {                       // 共享模式：只让一个读者装，其余等它装完
            u8 exp = 1;
            if (!r->meta_pending.compare_exchange_strong(exp, 2, std::memory_order_acq_rel)) {
                while (r->meta_pending.load(std::memory_order_acquire) != 0) std::this_thread::yield();
                return;
            }
        } else if (st == 2) return;                    // 不可能（独占时没人在装），保守起见
        struct Done { Run* r; ~Done() { r->meta_pending.store(0, std::memory_order_release); } } done{r};
        if (!r->mpage && (u64)r->page0 + r->npages < (u64)cap_) {
            const u8* mp = page(r->page0 + r->npages);       // meta 就贴在数据页后面
            if (mp && rd32(mp) == PK_RMETA) r->mpage = r->page0 + r->npages;
        }
        if (r->mpage) {
            ManEnt m;
            m.page0 = r->page0; m.npages = r->npages;
            m.key = r->first; m.last = r->last; m.nbytes = r->nbytes;
            if (load_rmeta(r, r->mpage, r->npages, m)) {
                r->mnpg = rmeta_pages(rmeta_size(r));
                meta_hits_.fetch_add(1, std::memory_order_relaxed);
                return;
            }
        }
        r->mnpg = 0;
        scan_meta(r);
    }

    // 枚举一条 run 里所有溢出链的页区间（每条链都是 alloc_pages 给的**连续**区间，
    // 所以只需要记 (pg0, npages) 两元组）。
    // 接管一条链之后，把"所有权"从源 run 摘掉（否则源 run 被释放时会把新 run 还在用的链还给池子）。
    // 只在**新 run 落地成功之后**调用：失败路径上源 run 仍然是链的主人。
    void chain_taken(RunPtr src, const u8* dsc) {
        if (!src || !dsc) return;
        const u32 pg = rd32(dsc);
        for (auto it = src->own_chains.begin(); it != src->own_chains.end(); ++it)
            if (it->first == pg) { src->own_chains.erase(it); break; }
        // 重开之后 own_chains 是空的，所有权只在 ovfl_loc 里 ⇒ 那里也要摘掉，
        // 否则源 run 被释放时（同一次操作里它一定会死）会把新 run 还在用的链还给池子。
        ensure_ovfl_loc(src);
        for (size_t i = 0; i < src->ovfl_loc.size(); ++i) {
            const u8* p = page(src->ovfl_loc[i].first);
            if (!p) continue;
            if (rd32(pg_val_at(p, src->ovfl_loc[i].second)) != pg) continue;
            src->ovfl_loc.erase(src->ovfl_loc.begin() + (long)i);
            break;
        }
    }

    // 这个 key 的记录能不能**原样接管**它的溢出链？
    // 条件：链的所有权是按 run 记的（run 的附件页里那份清单），所以只有
    // "源 run 在这次操作里一定会被销毁"时才能接管。
    // 有快照时也可以：进 take_set_ 的源 run 一定 ver > snap_max（level_pass / compact_cell /
    // consolidate 都把老快照还要读的 run 排除在外），所以它不在任何快照的清单里，
    // 回退到快照时它和它的链一起消失，接管不会让任何快照读到悬空的链。
    // 以前这里有 `nsnap_ > 0 ⇒ 不接管`：那是第 6 轮的保守开关，代价是快照期间每次合并都重写全部大值。
    // take_limit_：链的末页 > 阈值 ⇒ 不接管（物化重写，新链落到低位的洞里）。
    // 只有 compact_file 的第二遍会设它：这是把散在高位的链"搬"下来的**唯一**办法 ——
    // 描述符在不可变的数据页上，不能原地改，只能跟着记录一起重写。
    bool take_ok(RunPtr src, const u8* dsc) const {
        if (!ovfl_take_) return false;
        const u32 np = rd32(dsc + 4);
        if (np == 0) return false;                         // npages 无效
        if (take_limit_ != NIL && (u64)rd32(dsc) + np > take_limit_) return false;
        return src && take_set_.count(src->page0) != 0;
    }

    // 附件页 / 扫描都能重建 ovfl_loc（(数据页, 描述符偏移) 列表）
    void ensure_ovfl_loc(RunPtr r) {
        if (!r || r->novfl == 0 || r->loc_ready) return;
        // 注意判据是 loc_ready 而不是 "ovfl_loc 是否为空"：
        // 摘链（chain_taken）会把表清空，用"空表"当"没建过"就会去扫数据页，
        // 把刚交出去的链**又找回来**，接着当自己的还掉（悬空指针就是这么来的）。
        r->loc_ready = true;
        ensure_aux(r);
        if (r->aux_pg != NIL) {
            std::vector<std::pair<u32, u32>> where;
            if (load_ovfl_aux(r->aux_pg, r->aux_npg, r->page0, where, nullptr)) {
                for (auto& e : where) r->ovfl_loc.push_back(e);
                return;
            }
        }
        // 附件不可用：老老实实扫一遍数据页（慢，但只发生在"老库/附件写失败"时）
        for (u32 i = 0; i < r->npages; ++i) {
            const u8* p = page(r->page0 + i);
            if (!p) continue;
            u16 used = rd16(p + 34);
            if (used < DHDR || used > PAGE) continue;
            u8 pf = pg_pfx(p);
            u32 off = DHDR;
            while (off + pg_rec_size(pf, 0) <= used) {
                RecHdr h;
                rd_rec(p, off, h);
                u32 rs = pg_rec_size(pf, h.len);
                if (off + rs > used) break;
                if (h.len == OVFL_MARK) r->ovfl_loc.push_back({r->page0 + i, off});
                off += rs;
            }
        }
    }

    void collect_ovfl(RunPtr r, std::vector<std::pair<u32, u32>>& out, bool count_only = false) {
        if (!r || r->novfl == 0) return;      // 0xFFFFFFFF = 未知，会走下面的解析
        // 自有的链：直接从页上的描述符读（不读数据页，loc 是 RAM 里的索引）。
        // 接管来的链（ovfl_ref）不是我们的，永远不列入 out。
        ensure_ovfl_loc(r);
        if (r->novfl == 0xFFFFFFFFu) r->novfl = (u32)r->ovfl_loc.size();
        if (count_only) return;
        std::vector<std::pair<u32, u32>> own;          // 读描述符拿到的 (链首页, npages)
        for (auto& e : r->ovfl_loc) {
            const u8* p = page(e.first);
            if (!p) continue;
            OvflDesc d = desc_of(pg_val_at(p, e.second));
            own.push_back({d.pg0, d.npages});
        }
        // 页上描述的链就是本 run 的链：接管的那些所有权也转过来了（见 finish_run）
        for (auto& c : own) out.push_back(c);
    }

    // 溢出链的无损描述（附件页 `'AOVL'`）。为什么需要它：
    // 归并/压实想"原样接管"一条链，就必须知道每条链的 (数据页, 描述符偏移)；
    // 而页上的描述符里只有链自己的 pg0/npages，没有"它在哪个 run 的哪一页"。
    // 4 元组因此是必须的：run 真的被释放时，靠它在不读数据页的前提下精确列出链。
    // 布局：16 B 头（'AOVL' | run page0 | n | crc32(载荷)）+ n × 24 B 项，跨页拼接。
    static size_t ovfl_aux_size(u32 n) { return 16 + (size_t)n * 24; }

    static u32 ovfl_aux_pages(u32 n) { return n ? (u32)((ovfl_aux_size(n) + PAGE - 1) / PAGE) : 0; }
    RC write_ovfl_aux(RunPtr r, const std::vector<std::pair<u32, u32>>& where,
                      std::vector<IoJob>* jobs, u64& bytes_out) {
        const u32 n = (u32)where.size();
        if (!n) return RC::OK;
        const u32 np = ovfl_aux_pages(n);
        std::vector<u8> buf((size_t)np * PAGE, 0);
        wr32(buf.data(), 0x4C564F41u);                 // 'AOVL'
        wr32(buf.data() + 4, r->page0);
        wr32(buf.data() + 8, n);
        for (u32 k = 0; k < n; ++k) {
            u8* q = buf.data() + 16 + (size_t)k * 24;
            wr32(q, where[k].first);                   // 链的首页
            wr32(q + 4, where[k].second);              // 数据页 + 描述符偏移
            wr32(q + 8, 0); wr32(q + 12, 0); wr32(q + 16, 0); wr32(q + 20, 0);
        }
        wr32(buf.data() + 12, crc32c(buf.data() + 16, (size_t)n * 24));
        const u32 p0 = r->aux_pg;                 // 已经在 finish_run 里跟着数据页一起预留
        bool ok = true;
        for (u32 i = 0; i < np; ++i) {
            const u8* src = buf.data() + (size_t)i * PAGE;
            if (jobs) {
                IoJob j; j.pid = p0 + i;
                j.img.assign(src, src + PAGE);
                jobs->push_back(std::move(j));
            } else if (dev_->write((PageId)(p0 + i), 0, src, PAGE) != RC::OK) { ok = false; break; }
        }
        if (!ok) return RC::IO;
        bytes_out += (u64)np * PAGE;
        return RC::OK;
    }

    // 附件紧跟在数据页 + meta 后面 ⇒ 位置可以算出来，不用改清单/元数据的格式。
    // 用 magic + data_pg0 + CRC 三重校验，误认的概率可以忽略。
    void ensure_aux(RunPtr r) {
        if (!r || r->aux_npg || !r->novfl) return;
        const u32 p0 = r->page0 + r->npages + r->mnpg;
        const u8* p = page(p0);
        if (!p || rd32(p) != 0x4C564F41u || rd32(p + 4) != r->page0) return;
        const u32 n = rd32(p + 8);
        const u32 np = ovfl_aux_pages(n);
        if (!np || np > 8) return;
        r->aux_pg = p0; r->aux_npg = np;
    }

    // 读回附件里的"链在哪"清单
    bool load_ovfl_aux(u32 p0, u32 np, u32 data_pg0,
                       std::vector<std::pair<u32, u32>>& out,
                       std::vector<std::pair<u32, u32>>* chains) {
        if (!p0 || !np) return false;
        std::vector<u8> buf((size_t)np * PAGE, 0);
        for (u32 i = 0; i < np; ++i) {
            const u8* p = page(p0 + i);
            if (!p) return false;
            std::memcpy(buf.data() + (size_t)i * PAGE, p, PAGE);
        }
        if (rd32(buf.data()) != 0x4C564F41u) return false;
        if (rd32(buf.data() + 4) != data_pg0) return false;
        const u32 n = rd32(buf.data() + 8);
        if (ovfl_aux_size(n) > (size_t)np * PAGE) return false;
        if (crc32c(buf.data() + 16, (size_t)n * 24) != rd32(buf.data() + 12)) return false;
        out.clear(); out.reserve(n);
        for (u32 k = 0; k < n; ++k) {
            const u8* q = buf.data() + 16 + (size_t)k * 24;
            u32 link = rd32(q), where = rd32(q + 4);
            if (!link) return false;
            out.push_back({link, where});
            if (chains) chains->push_back({link, 0});   // npages 等从描述符补
        }
        return true;
    }

    // 释放一条 run 的溢出链（在 run 被销毁之前调用）
    void free_ovfl_of(RunPtr r, bool snap_safe = false) {
        if (!r) return;
        if (r->novfl) {
            std::vector<std::pair<u32, u32>> ex;
            collect_ovfl(r, ex);
            for (auto& e : ex) free_pages(e.first, e.second, snap_safe);
        }
    }

    RC finish_run(RunWriter& w, RunPtr& out, u64* ctr = nullptr, bool maint = false) {
        out = nullptr;
        if (w.nrec == 0) return RC::OK;
        w.close_page();
        if (w.npages() > 1 && w.last_pg()[34] == 0 && w.last_pg()[35] == 0)
            w.drop_last();                         // 尾页没写满/为空则不占页
        u32 p0 = 0;
        RunPtr r = new Run();
        r->npages = w.npages();
        // 小 run 不写 meta：1 页数据配 1 页 meta 是 100% 的空间开销，小设备上会直接把引擎逼死。
        // 阈值 16 页 ⇒ meta 开销 ≤ 6%（实测 ~2 KB/千条），而 ≤16 页的 run 挂载时直接扫也就 16 页。
        r->mnpg = rmeta_mode_ && w.npages() >= rmeta_min_
                ? rmeta_pages(rmeta_size_pre(w.npages(), w.sp.size(), w.want_kidx ? w.kidx.size() : 0,
                                             w.bloom.w.size()))
                : 0;
        // 溢出链清单页：跟着数据页 + meta 一起**预留**在同一段连续区间里，
        // 这样挂载时位置可以算出来（page0+npages+mnpg），不需要改任何持久格式。
        u32 aux_np = ovfl_aux_pages((u32)w.loc.size());
        bool aux_ok = aux_np > 0;
        RC rc = alloc_pages(w.npages() + r->mnpg + aux_np, p0, maint);
        if (rc != RC::OK && r->mnpg) {                          // 空间紧：放弃 meta，先活下来
            r->mnpg = 0;
            rc = alloc_pages(w.npages() + aux_np, p0, maint);
        }
        if (rc != RC::OK && aux_np) {                           // 再紧：放弃附件（挂载时扫页重建）
            if (r->mnpg) { r->mnpg = 0; rc = alloc_pages(w.npages() + aux_np, p0, maint); }
            if (rc != RC::OK) { rc = alloc_pages(w.npages(), p0, maint); aux_ok = false; }
        }
        if (rc != RC::OK) { w.abandon(); delete r; return rc; }
        r->page0 = p0;
        r->first = w.first; r->last = w.last;
        r->ver = w.ver; r->nbytes = w.nbytes; r->nrec = w.nrec; r->novfl = w.novfl;
        r->own_chains = std::move(w.chains);
        // 接管的链**归本 run 所有**：take_ok() 只在"源 run 这次一定死"时才允许接管，
        // 源 run 的链已经从它的表里摘掉了（chain_taken）。所以本 run 死的时候必须还它们，
        // 否则每条被接管过的链都成了永久泄漏（压实跑 N 次就漏 N 份大值）。
        // ovfl_ref 保留成"从别处接管来的"清单，只用于统计，不再参与"要不要还"的判定。
        r->ovfl_ref = std::move(w.takes);
        for (auto& c : r->ovfl_ref) r->own_chains.push_back(c);
        r->loc_ready = true;
        // 页上每条溢出记录的 (页, 偏移)：先相对，落盘前统一平移到 r->page0
        r->ovfl_loc = std::move(w.loc);
        for (auto& e : r->ovfl_loc) e.first += p0;
        r->live_bytes = w.nbytes;
        r->live_recs = 0;              // 由段级记账填（flush 增量加法 / 压实·归并 recount 重算）
        r->seq = next_seq_++;
        r->fences = w.fences;
        r->sp = w.sp;
        if (w.want_kidx) r->kidx = std::move(w.kidx);
        r->bloom = w.bloom;
        r->pbytes.resize(w.npages());
        r->pnrec.resize(w.npages());
        u64 wbytes = 0;
        std::vector<IoJob> jobs;
        if (async_) jobs.reserve(8 + r->mnpg);
        const u32 ndata = w.npages();
        for (u32 i = 0; i < ndata; ++i) {
            u8* p = w.pg(i);
            wr32(p + 4, (i + 1 < ndata) ? p0 + i + 1 : (u32)NIL);
            u16 used = rd16(p + 34);
            r->pbytes[i] = used - DHDR;
            r->pnrec[i] = rd16(p + 32);
            // 写放大口径仍按"用到的字节"记账（wr_flush_ 等计数器）；设备层按整页写（见下）
            wbytes += (u32)((used + 3u) & ~3u);
        }
        // 数据页落盘（B4）。设备偏好整页（FileDev）：整段连续、整页一次 write_multi（同步按 ≤ 1 MB 一段；
        // 异步把整块缓冲移交 IO 线程、每 64 页一个作业共享同一块缓冲 —— 零拷贝，多个 IO 线程仍能分摊）。
        // 页尾未用字节是 0（缓冲初始化为 0），CRC 只盖 used 字节。
        // 字节可寻址设备（RamDev/NOR 模拟）：保持"只写用到的字节、逐页写"（写放大口径一位不变）。
        auto abort_pages = [&]() {
            // 半成品：把已经占下的页退回空闲表，绝不留下"占着空间没人引用"的泄漏
            for (u32 j = 0; j < ndata + r->mnpg; ++j) dev_->erase((PageId)(p0 + j));
            free_pages(p0, ndata + r->mnpg, true);
            promote_pending();
            delete r;
            return RC::IO;
        };
        if (dev_->whole_pages()) {
            if (!async_) {
                constexpr u32 CHUNK = 256;
                for (u32 i = 0; i < ndata; i += CHUNK) {
                    const u32 n = std::min<u32>(CHUNK, ndata - i);
                    if (dev_->write_multi((PageId)(p0 + i), n, w.pg(i)) != RC::OK) return abort_pages();
                }
            } else {
                auto shared = std::make_shared<std::vector<u8>>(std::move(w.pbuf));
                constexpr u32 CHUNK = 64;
                for (u32 i = 0; i < ndata; i += CHUNK) {
                    IoJob j; j.pid = p0 + i; j.n = std::min<u32>(CHUNK, ndata - i);
                    j.buf = shared; j.off = (size_t)i * PAGE;
                    jobs.push_back(std::move(j));
                }
            }
        } else {
            for (u32 i = 0; i < ndata; ++i) {
                const u8* p = w.pg(i);
                const u32 wlen = (u32)((rd16(p + 34) + 3u) & ~3u);
                if (wlen > PAGE) return abort_pages();
                if (!async_) {
                    if (dev_->write((PageId)(p0 + i), 0, p, wlen) != RC::OK) return abort_pages();
                } else {
                    IoJob j; j.pid = p0 + i; j.img.assign(p, p + wlen);
                    jobs.push_back(std::move(j));
                }
            }
        }
        rebuild_pcum(r);
        // 溢出链清单（可选但重要）：run 又大又有溢出值时写一份，挂载后
        // 才不需要"读完全部数据页"就知道每条链在哪（归并零读接管、释放不读页都靠它）。
        // 没有它也不算错：`ovfl_loc` 可以从数据页重建，只是慢。
        if (aux_ok && !r->ovfl_loc.empty()) {
            r->aux_pg = p0 + r->npages + r->mnpg;
            r->aux_npg = aux_np;
            std::vector<std::pair<u32, u32>> where(r->ovfl_loc.begin(), r->ovfl_loc.end());
            u64 ab = 0;
            std::vector<IoJob> aj;
            if (write_ovfl_aux(r, where, async_ ? &aj : nullptr, ab) == RC::OK) {
                if (async_) { for (auto& j : aj) jobs.push_back(std::move(j)); }
                wbytes += ab;
            } else {                                  // 附件写失败：位置就别认了，挂载时扫页
                r->aux_pg = NIL; r->aux_npg = 0;
            }
        }
        // 元数据页：和数据页同批排队（同一个 IoJob 批次 ⇒ 同一个等待点），
        // 保证“清单提交之前 meta 一定已经落盘”。
        if (r->mnpg) {
            u64 mb = 0;
            RC mrc = write_rmeta(r, p0 + r->npages, async_ ? &jobs : nullptr, mb);
            if (mrc != RC::OK) {
                for (u32 j = 0; j < w.npages() + r->mnpg; ++j) dev_->erase((PageId)(p0 + j));
                free_pages(p0, w.npages() + r->mnpg, true);
                promote_pending();
                delete r;
                return mrc;
            }
            wbytes += mb;
        }
        if (async_) enqueue_batch(jobs);
        inval(p0, run_block(r));               // 页被重写 ⇒ 缓存副本失效
        if (ctr) *ctr += wbytes;
        out = r;
        return RC::OK;
    }

    ManEnt run_ent(RunPtr r, u8 op) {
        ManEnt m;
        m.op = op;
        m.key = r->first; m.last = r->last;
        m.page0 = r->page0; m.npages = r->npages;
        m.ver = r->ver; m.nbytes = r->nbytes; m.seq = r->seq; m.lvl = (u8)r->lvl;
        return m;
    }

    // ------------------------------------------------------------ 提交：mem → 1 段
    RC flush_mem(std::vector<ManEnt>& delta, u32 ver) {
        // 先把这批记录写成一条 run（写页）。**写成功之后**才动存活账：
        // 失败路径（NOSPACE/IO）因此不会留下半套账 —— 这正是"不漂移"的前提。
        RunWriter w(ver, (u32)mem_.size(), mem_bytes_);     // 预留 ≈ 内存表大小的页缓冲，避免反复扩容拷贝
        w.want_kidx = keyidx_;
        w.st = this;
        std::vector<u32> mord;                 // 键序（内存表是哈希，这里排一次）
        mem_.sorted(mord);
        for (u32 mi : mord) {
            const MemTable::Ent& r = mem_.at(mi);
            bool ok = r.ovfl ? w.add_desc(r.key, r.ver, mem_.val(r))
                             : w.add(r.key, r.ver, mem_.val(r), r.len);
            if (!ok) {
#ifdef FCS_TRACE
                std::fprintf(stderr, "    NOSPACE in RunWriter::add (nrec=%u)\n", w.nrec);
#endif
                w.abandon();
                return RC::NOSPACE;
            }
        }
        // 空间紧张时判断这一批是不是“不增长”的（全是覆盖/删除）：
        // 不增长就允许动预留区，保证“删得掉”，NOSPACE 永远有出路。
        bool tight = tail_ + w.npages() > user_lim();
        bool non_growing = false;
        if (tight) {
            u64 ns = 0, os = 0;
            bool all_old = true;
            for (u32 mi : mord) {
                const MemTable::Ent& r = mem_.at(mi);
                u16 ol = 0; u32 osz = 0; RunPtr own = nullptr;
                ns += rec_size(r.len);
                if (!probe_prev(r.key, ver, ol, &own, &osz)) { all_old = false; break; }
                os += osz;
            }
            non_growing = all_old && ns <= os;
        }
        RunPtr run = nullptr;
        RC rc = finish_run(w, run, &wr_flush_, non_growing);
        if (rc != RC::OK) return rc;
        if (!run) return RC::OK;
        std::vector<Cell*> ord;
        ord.reserve(mem_.size());
        for (u32 mi : mord) {
            const u64 mkey = mem_.at(mi).key;
            Cell* c = find_cell(mkey);
            if (!c) continue;
            ord.push_back(c);
            u16 old = 0; u32 osz = 0;
            RunPtr owner = nullptr;
            if (probe_prev(mkey, ver, old, &owner, &osz)) {
                dead_added_ += osz;
                // 旧副本变成垃圾 ⇒ 它所在 run 的存活字节少 osz（run 级账只靠这里增量维护，没有别的地方会重算：
                // 第 12 轮 M2 第一版对账未知的单元跳过整个 probe_prev，结果 L0 run 的 live_bytes 永远偏大、层合并的
                // 脏度门槛打不到 ⇒ 要等 lvl_t×4 的积压兜底才合并（wprof 100k×500B 结束时 L0 27 条 vs 9 条）。
                if (owner && owner->live_bytes >= osz) owner->live_bytes -= osz;
                if (!c->acct) continue;        // R6-lite：单元级 / 段级账未知 ⇒ 这两级留给补算（lb_acc 里也还没有它的贡献）
                c->live = c->live > osz ? c->live - osz : 0;
                c->dead += osz;
                if (owner) {   // 它在**这个单元**的段少一条存活记录
                    if (owner->lb_unknown && owner->lb_acc >= osz) owner->lb_acc -= osz;   // 本单元已知 ⇒ 它的贡献已在 lb_acc 里
                    auto oit = c->segs.find(seg_key(owner->seq, owner->page0));
                    if (oit != c->segs.end()) { if (!oit->second.unk) seg_set_live(oit->second, oit->second.live ? oit->second.live - 1 : 0); }
                    else if (owner->live_recs) --owner->live_recs;
                }
            }
        }
        // 页内前缀让每条记录的磁盘占用要到封页后才知道 ⇒ 用 w.osz 补记 live
        for (size_t i = 0; i < ord.size() && i < w.osz.size(); ++i) if (ord[i]->acct) ord[i]->live += w.osz[i];
        if (std::getenv("FCS_VERIFY_DBG")) {
            size_t j = 0;
            for (u32 mi : mord) {
                const MemTable::Ent& e = mem_.at(mi);
                if (j < w.osz.size()) std::fprintf(stderr, "  FLUSH ver=%u key=%llu len=%u osz=%u\n", ver, (unsigned long long)e.key, e.len, w.osz[j]);
                ++j;
            }
        }
        runs_[run->page0] = run;
        attach_run(run);
        for (Cell* c : ord) {           // 新记录在各自单元里都是赢家 ⇒ 新 run 的段 +1
            auto it = c->segs.find(seg_key(run->seq, run->page0));
            if (it != c->segs.end()) seg_set_live(it->second, it->second.live + 1);
            else ++run->live_recs;
        }
#ifdef FCS_TRACE
        if (run->first <= 1280 && run->last >= 1280)
            std::fprintf(stderr, "  FA seq=%u rid=%u npg=%u [%llu,%llu]\n",
                run->seq, run->page0, run->npages,
                (unsigned long long)run->first, (unsigned long long)run->last);
#endif
        delta.push_back(run_ent(run, M_RUN_ADD));
        return RC::OK;
    }

#ifdef FCS_TRACE
    void check_liveness(const char* tag) {
        recount_all_unknown();
        for (auto& kv : cells_) {
            Cell* c = kv.second;
            std::vector<Cur> cs;
            for (auto& sg : c->segs) {
                RunPtr r = runs_[sg.second.rid];
                if (!r || sg.second.p0 >= sg.second.p1) continue;
                cs.emplace_back();
                cs.back().r = r;
                cs.back().p0 = sg.second.p0;
                cs.back().p1 = std::min(sg.second.p1, r->npages);
                cs.back().load(this);
            }
            u64 live = 0;
            merge_emit(c, cs, [&](u64, u32, const u8*, u16, u32 osz, RunPtr, const u8*) { live += osz; return true; }, false);
            u64 total = total_rec_bytes(c);
            if (live != c->live || total != c->live + c->dead) {
                struct V3 { u32 seq, ver, len; };
                std::map<u64, std::vector<V3>> km;
                for (auto& sgx : c->segs) {
                    RunPtr r = runs_[sgx.second.rid];
                    u32 sq = r->seq;
                    for (u32 i = sgx.second.p0; i < std::min(sgx.second.p1, r->npages); ++i) {
                        const u8* p = page(r->page0 + i);
                        u16 used = rd16(p + 34); u32 off = DHDR;
                        u8 pf = pg_pfx(p);
                        while (off + pg_rec_size(pf, 0) <= used) {
                            RecHdr h; rd_rec(p, off, h);
                            u32 rs = pg_rec_size(pf, h.len);
                            if (off + rs > used) break;
                            if (h.key >= c->lo && h.key < c->hi) km[h.key].push_back(V3{sq, r->ver, h.len});
                            off += rs;
                        }
                    }
                }
                u64 sum_ver = 0, sum_seq = 0; u32 shown = 0;
                for (auto& e : km) {
                    const V3 *bv = &e.second[0], *bs = &e.second[0];
                    for (auto& q : e.second) { if (q.ver > bv->ver) bv = &q; if (q.seq > bs->seq) bs = &q; }
                    sum_ver += rec_size((u16)bv->len); sum_seq += rec_size((u16)bs->len);
                    if (bv != bs && shown < 3) {
                        std::fprintf(stderr, "     ALL key=%llu:", (unsigned long long)e.first);
                        for (auto& q : e.second) std::fprintf(stderr, " (seq=%u ver=%u len=%u)", q.seq, q.ver, q.len);
                        std::fprintf(stderr, "\n");
                    }
                    if (bv != bs && shown < 6) {
                        ++shown;
                        std::fprintf(stderr, "     KEYDIFF key=%llu byver(seq=%u ver=%u len=%u) byseq(seq=%u ver=%u len=%u) n=%zu\n",
                            (unsigned long long)e.first, bv->seq, bv->ver, bv->len, bs->seq, bs->ver, bs->len, e.second.size());
                    }
                }
                std::fprintf(stderr, "     sum_by_ver=%llu sum_by_seq=%llu\n", (unsigned long long)sum_ver, (unsigned long long)sum_seq);
                std::fprintf(stderr, "  [%s] LIVE MISMATCH cell[%llu,%llu) tracked live=%llu dead=%llu | exact live=%llu total=%llu segs=%zu\n",
                    tag, (unsigned long long)c->lo, (unsigned long long)c->hi,
                    (unsigned long long)c->live, (unsigned long long)c->dead,
                    (unsigned long long)live, (unsigned long long)total, c->segs.size());
                return;
            }
        }
    }
#endif

    // ------------------------------------------------------------ 平衡
    RC rebalance(std::vector<ManEnt>& delta) {
        ++rebal_calls_;
        split_pass(delta);
#ifdef FCS_TRACE
        check_liveness("after split");
#endif
        // 单元只细分、不回并：段的页区间天然覆盖邻居的记录，一旦把键域放宽，
        // 邻居的记录就会重新进入视野，与压实段形成重复副本（读/统计都会错）。
        // 需要“合并”时用整流压实代替（键域不变，只是重写）。
#ifdef FCS_TRACE
        check_liveness("after merge");
#endif
        RC rc = compact_pass(delta);
#ifdef FCS_TRACE
        check_liveness("after compact");
#endif
        return rc;
    }

    // B1：bytes > BMAX ⇒ 在该单元最长大段的中间页边界切分（零数据重写）
    // R9（第 10 轮）：以前每切一刀都从头扫一遍 cells_ 找下一个超限单元（O(单元数 × 刀数)，5500 单元时每次提交
    // 固定 3~4 ms）。现在一次扫描收齐候选，切完的两半若仍超限就回到工作队列；切不动的单元跳过而不是中止整轮。
    void split_pass(std::vector<ManEnt>& delta) {
        std::vector<Cell*> work;
        for (auto& kv : cells_) if (cell_bytes(kv.second) > BMAX) work.push_back(kv.second);
        for (int guard = 0; guard < 128 && !work.empty(); ++guard) {
            Cell* victim = work.back(); work.pop_back();
            if (cell_bytes(victim) <= BMAX) continue;
            u32 best_rid = 0, best_len = 0;
            for (auto& sg : victim->segs) {
                u32 len = sg.second.p1 - sg.second.p0;
                if (len > best_len) { best_len = len; best_rid = sg.second.rid; }
            }
            if (!best_rid) continue;
            RunPtr r = runs_[best_rid];
            if (!r) continue;
            u64 mid = 0;
            if (best_len >= 2) {
                u32 pi = 0;
                for (auto& sg : victim->segs) if (sg.second.rid == best_rid) pi = (sg.second.p0 + sg.second.p1) / 2;
                if (pi < (u32)r->fences.size()) mid = r->fences[pi];
                if (mid <= victim->lo || mid >= victim->hi) {
                    mid = 0;
                    for (u32 d = 1; d < best_len && !mid; ++d) {
                        if (pi + d < (u32)r->fences.size() && r->fences[pi + d] > victim->lo && r->fences[pi + d] < victim->hi)
                            mid = r->fences[pi + d];
                    }
                }
            }
            if (!mid) {
                // 退化情形：没有跨页的大段（全是单页小段）⇒ 直接读最长段的那一页，
                // 取区间内“中位记录”的键作为切分点（一次页读，切分很少发生）。
                std::vector<u64> ks;
                for (auto& sg : victim->segs) {
                    if (sg.second.rid != best_rid) continue;
                    for (u32 i = sg.second.p0; i < sg.second.p1; ++i) {
                        const u8* p = page(r->page0 + i);
                        u16 used = rd16(p + 34);
                        u8 pf = pg_pfx(p);
                        u32 off = DHDR;
                        while (off + pg_rec_size(pf, 0) <= used) {
                            RecHdr h;
                            rd_rec(p, off, h);
                            u32 rs = pg_rec_size(pf, h.len);
                            if (off + rs > used) break;
                            if (h.key >= victim->lo && h.key < victim->hi) ks.push_back(h.key);
                            off += rs;
                        }
                    }
                }
                if (ks.size() < 2) continue;
                mid = ks[ks.size() / 2];
            }
            if (mid <= victim->lo || mid >= victim->hi) continue;
            u64 hi_old = victim->hi;
            Cell* nc = new Cell();
            nc->lo = mid; nc->hi = hi_old;
            SegMap left, right;
            for (auto& sg : victim->segs) {
                RunPtr r = runs_[sg.second.rid];
                if (!r) continue;
                Seg s0 = sg.second;
                // 切分只收窄键域、不动页区间：共享的页可以同时被父子两侧引用，
                // 由键域保证各自只看到自己那一截 ⇒ 切分零数据搬移。
                u64 kl = std::max(s0.klo, victim->lo), kr = std::min(s0.khi, mid);
                if (kl < kr) left[seg_key(r->seq, s0.rid)] = Seg{s0.rid, s0.p0, s0.p1, kl, kr};
                kl = std::max(s0.klo, mid); kr = std::min(s0.khi, hi_old);
                if (kl < kr) right[seg_key(r->seq, s0.rid)] = Seg{s0.rid, s0.p0, s0.p1, kl, kr};
            }
            victim->hi = mid;
            // 段被拆成左右两份前，先把落在原段上的存活计数退回 run
            // （swap 会丢掉原来的 Seg 对象；不退回就会和 recount 重复计一次）
            for (auto& sg : victim->segs) seg_set_live(sg.second, 0);
            victim->segs.swap(left);
            nc->segs.swap(right);
            // 一段被切成父子两份 ⇒ 这条 run 多了一个引用；只落在一侧的引用数不变
            for (auto& sg : nc->segs) if (victim->segs.count(sg.first)) ref_inc(sg.second.rid);
            retighten(victim);          // 键域收窄 ⇒ 页区间同步收紧
            retighten(nc);
            cells_[nc->lo] = nc;
            // 两半的账：父单元已知 ⇒ 立刻 recount（只读这两半的页）；父单元未知（挂载后还没扫到）⇒ 两半也未知，交给补算。
            // C3（第 12 轮）曾把"已知父单元的两半"也推迟到补算：实测否决——同一维护单元里紧跟着的 compact_pass 会跳过
            // 账未知的单元，垃圾留到下次提交 ⇒ 物理字节更早超 BMAX ⇒ 更多拆分（g10 负载：85→96 单元、20→25 条 run、
            // compact_file_step 收尾高水位 139→151 页）。拆分前 recount 的 CPU（wprof 16%）是精确账的代价，不是浪费。
            const bool parent_known = victim->acct;
            nc->acct = true; nc->lb_added = victim->lb_added;
            if (parent_known) { recount(victim); recount(nc); }
            else { mark_unknown(victim); mark_unknown(nc); }
            ManEnt m;
            m.op = M_SPLIT_ADD;
            m.key = mid;
            delta.push_back(m);
            if (cell_bytes(victim) > BMAX) work.push_back(victim);   // 两半仍超限 ⇒ 继续切
            if (cell_bytes(nc) > BMAX) work.push_back(nc);
        }
        // 坑 100（第 12 轮）：每轮最多 128 刀，批量加载（一次提交 50k 条）时切不完也不吭声 ⇒ 关库时一堆单元 > BMAX，
        // 重开后第一次维护才继续切。现在记下"还有没切完的"，maint_unit 据此报 MORE 并在下一个单元继续 rebalance。
        split_pending_ = !work.empty();
    }

    // 精确重算单元 live/dead（读页，但只读该单元的页）
    // 单元记账的唯一算术入口：live/dead/pages 都由“段集合”直接算出来。
    // 任何结构性变化（挂 run、摘 run、升层、压缩、分裂）之后调一次，别再手工加减。
    // 把某段的存活计数设成 v，并把差值记到它所属的 run 上（唯一改 run->live_recs 的地方）
    void seg_set_live(Seg& sg, u32 v) {
        auto it = runs_.find(sg.rid);
        if (it != runs_.end()) {
            RunPtr r = it->second;
            if (v >= sg.live) r->live_recs += v - sg.live;
            else r->live_recs = (r->live_recs >= sg.live - v) ? r->live_recs - (sg.live - v) : 0;
        }
        sg.live = v;
        sg.unk = 0;
    }
    // ---- R6-lite：惰性存活账 ----
    void seg_set_unknown(Seg& sg) { seg_set_live(sg, 1); sg.unk = 1; }     // 占位 1 条
    void mark_unknown(Cell* c) {
        if (c->acct) { c->acct = false; ++unk_cells_; }
        c->live = 0; c->dead = 0;
        for (auto& sg : c->segs) seg_set_unknown(sg.second);
    }
    void set_known(Cell* c) { if (!c->acct) { c->acct = true; if (unk_cells_) --unk_cells_; } }
    u64 cell_bytes(Cell* c) { return c->acct ? c->bytes() : total_rec_bytes(c); }   // 拆分判据：未知单元用物理字节
    void mark_all_unknown() {                       // 挂载：一页都不读
        unk_cells_ = 0; sweep_lo_ = 0;
        for (auto& kv : runs_) { kv.second->live_recs = 0; kv.second->live_bytes = kv.second->nbytes; kv.second->lb_unknown = true; kv.second->lb_acc = 0; }
        for (auto& kv : cells_) { kv.second->acct = true; kv.second->lb_added = false; for (auto& sg : kv.second->segs) sg.second.live = 0; mark_unknown(kv.second); }
    }
    void lb_settle_if_done() {                      // 全部单元补算完：挂载前的 run 换成精确存活字节
        if (unk_cells_) return;
        for (auto& kv : runs_) {
            RunPtr r = kv.second;
            if (!r->lb_unknown) continue;
            r->lb_unknown = false;
            r->live_bytes = r->lb_acc > r->nbytes ? r->nbytes : r->lb_acc;
        }
    }
    // 补算最多 n 个未知单元（从 sweep_lo_ 起按键序，绕一圈）。返回是否还有未知单元。
    bool recount_sweep(u32 n) {
        if (!unk_cells_) { lb_settle_if_done(); return false; }
        auto it = cells_.lower_bound(sweep_lo_);
        size_t seen = 0;
        while (n && seen < cells_.size()) {
            if (it == cells_.end()) it = cells_.begin();
            Cell* c = it->second;
            if (!c->acct) { recount(c); --n; }
            ++it; ++seen;
        }
        sweep_lo_ = it == cells_.end() ? 0 : it->first;
        if (!unk_cells_) lb_settle_if_done();
        return unk_cells_ > 0;
    }
    void recount_all_unknown() {
        if (!unk_cells_) return;
        for (auto& kv : cells_) if (!kv.second->acct) recount(kv.second);
        lb_settle_if_done();
    }

    // 这个单元里有没有可能有记录被范围墓碑盖住？（有就不能走"全活"快路径）
    bool cell_may_be_hidden(Cell* c) const {
        if (ranges_.empty()) return false;
        ensure_maxhi();
        auto it = ranges_.upper_bound({c->hi, ~0u});   // 第一个 lo > hi
        while (it != ranges_.begin()) {
            --it;
            const RangeTomb& r = it->second;
            if (r.maxhi <= c->lo) return false;        // 更早的都不覆盖
            if (r.hi > c->lo && r.lo < c->hi) return true;
        }
        return false;
    }

    void recount(Cell* c) {
        // R6-lite：未知 → 已知的那一次，把本单元赢家字节累进"挂载前 run"的 lb_acc（见 lb_settle_if_done）
        const bool add_lb = !c->acct && !c->lb_added;
        set_known(c);
        if (add_lb) c->lb_added = true;
        // 单选段单元：单元里没有第二份副本，所有记录都活着 ⇒ 字节/条数全是前缀和，一页都不用解码。
        // 挂载时这种单元占 92%，原来每个都要跑一遍 k 路归并（400k 记录 ≈ 15 ms）。
        // **例外**：范围墓碑让"全活"不成立，必须真归并一遍。
        if (c->segs.size() == 1 && !cell_may_be_hidden(c)) {
            Seg& sg = c->segs.begin()->second;
            RunPtr r0 = runs_[sg.rid];
            if (r0) {
                if (r0->meta_pending) ensure_meta(r0);
                u64 bytes = 0; u32 recs = 0;
                seg_totals(r0, sg, c->lo, c->hi, bytes, recs);
                seg_set_live(sg, recs);
                c->live = bytes; c->dead = 0;
                c->pages = sg.p1 - sg.p0;
                if (add_lb && r0->lb_unknown) r0->lb_acc += bytes;
                return;
            }
        }
        u64 live = 0;
        std::vector<Cur> cs;
        cs.reserve(c->segs.size());            // Cur 内嵌 4 KB 页缓冲：逐个 emplace 的扩容搬运占过写路径 CPU 的 10%
        for (auto& sg : c->segs) {
            RunPtr r = runs_[sg.second.rid];
            if (!r || sg.second.p0 >= sg.second.p1) continue;
            cs.emplace_back();
            cs.back().r = r;
            cs.back().p0 = sg.second.p0;
            cs.back().p1 = std::min(sg.second.p1, r->npages);
            cs.back().klo = sg.second.klo;     // 边界页可能含邻居单元的键
            cs.back().khi = sg.second.khi;
            cs.back().load(this);
        }
        for (auto& sg : c->segs) seg_set_live(sg.second, 0);      // 本单元口径整体重算
        merge_emit(c, cs, [&](u64, u32, const u8*, u16, u32 osz, RunPtr src, const u8*) {
            live += osz;
            if (src) {                                              // 赢家 → 它的段记一条
                auto it = c->segs.find(seg_key(src->seq, src->page0));
                if (it != c->segs.end()) seg_set_live(it->second, it->second.live + 1);
                else ++src->live_recs;
                if (add_lb && src->lb_unknown) src->lb_acc += osz;
            }
            return true;
        });
        u64 total = total_rec_bytes(c);
        c->live = live;
        c->dead = total > live ? total - live : 0;
        c->pages = 0;
        for (auto& sg : c->segs) c->pages += sg.second.p1 - sg.second.p0;
    }

    // B2/B3：段数超限 ⇒ 合并最旧的若干段（tiered）；垃圾过多 ⇒ DP 在预算内择优
    // 这个单元里有没有"老快照还要读的版本"（ver <= vmin）
    bool cell_has_old(Cell* c, u32 vmin) const {
        if (!vmin) return false;
        for (auto& sg : c->segs) {
            auto it = runs_.find(sg.second.rid);
            if (it != runs_.end() && it->second->ver <= vmin) return true;
        }
        return false;
    }

    RC compact_pass(std::vector<ManEnt>& delta) {
        // 快照存活时不再整体停摆：只跳过"含老版本"的单元。
        // 压实只保留每个键的最新版，而快照要读 ver <= 自己那一版 —— 判据是 **snap_max**
        //（用 snap_min 会压掉"较新快照"还看得见的版本）。
        const u32 vmin = snap_max();
        // 重写预算（页）：随本提交产生的垃圾自适应；4..64 页
        u32 budget = 2 * (u32)(dead_added_ / PAGE) + 4;
        if (budget > 64) budget = 64;

        // 1) 安全阀：段数逼近 SMAX 的单元必须收拢（否则读放大随提交数线性增长）。
        //    每提交最多收拢一个，且只收拢垃圾占优的单元；全活的单元宁可多留段。
        {
            Cell* victim = nullptr;
            size_t most = SMAX;
            for (auto& kv : cells_) {
                Cell* c = kv.second;
                if (c->segs.size() <= most) continue;
                if (cell_has_old(c, vmin)) continue;
                most = c->segs.size();
                victim = c;
            }
            if (victim) {
                RC rc = compact_cell(victim, delta);
                if (rc == RC::NOSPACE) return RC::OK;   // 空间不够：本轮不压实
                if (rc != RC::OK) return rc;
                ++cmp_valve_;
            }
        }

        // 2) 回收：只有“回收的垃圾 > 重写的存活字节”才值得做（净收益 > 0）。
        //    成本 = 输出页数 ≈ live/PAGE+1；收益 = dead - live。
        struct Item { u32 cost; u64 gain; u64 lo; };
        std::vector<Item> items;
        for (auto& kv : cells_) {
            Cell* c = kv.second;
            if (c->segs.size() < 2) continue;
            if (!c->acct) continue;                  // R6-lite：账未知 ⇒ 不压实（等补算）
            if (cell_has_old(c, vmin)) continue;
            if (c->dead < 4096) continue;
            // 收益/成本 = dead/live：只有“回收量 ≥ 重写量的 FCS_GC_RATIO 倍”才动手，
            // 这样每一字节的压实写都能换回成倍的可用空间。
            if (c->dead < c->live * (u64)FCS_GC_RATIO) continue;
            // 收益 = 这次压实能回收的垃圾（dead），不是 dead - live：
            // 用后者会让“存活占多数”的单元永远排不上号，垃圾于是无限堆积。
            u32 cost = (u32)(c->live / PAGE) + 1;
            if (cost > budget) continue;
            if (c->dead == 0) continue;
            items.push_back({cost, c->dead, c->lo});
        }
#ifdef FCS_TRACE
        std::fprintf(stderr, "  DP cells=%zu items=%zu budget=%u\n", cells_.size(), items.size(), budget);
        for (auto& it : items) std::fprintf(stderr, "     item lo=%llu cost=%u gain=%llu\n", (unsigned long long)it.lo, it.cost, (unsigned long long)it.gain);
#endif
        if (items.empty()) return RC::OK;
        size_t n = items.size();
        std::vector<std::vector<u64>> dp(n + 1, std::vector<u64>(budget + 1, 0));
        for (size_t i = 1; i <= n; ++i)
            for (u32 b = 0; b <= budget; ++b) {
                dp[i][b] = dp[i - 1][b];
                const Item& it = items[i - 1];
                if (it.cost <= b && it.cost > 0) {
                    u64 v = dp[i - 1][b - it.cost] + it.gain;
                    if (v > dp[i][b]) dp[i][b] = v;
                }
            }
        u32 b = budget;
        for (size_t i = n; i > 0; --i) {
            if (dp[i][b] == dp[i - 1][b]) continue;
            auto it = cells_.find(items[i - 1].lo);
            if (it != cells_.end()) {
                RC rc = compact_cell(it->second, delta);
                if (rc == RC::NOSPACE) return RC::OK;   // 预算内的机会性压实，放不下就收手
                if (rc != RC::OK) return rc;
                ++cmp_gc_;
            }
            if (b >= items[i - 1].cost) b -= items[i - 1].cost;
        }
        return RC::OK;
    }

    // 整流压实（reclaim 的唯一手段）：把整个单元的所有段合成一条新 run。
    //   · 只有“全单元”合并才能让同一键的旧副本与新副本相遇 ⇒ 旧副本可被丢弃
    //   · 输出只含存活记录 ⇒ 写放大 ≈ live，空间回收 ≈ dead
    //   · 新 run 取“栈底”seq（向下递减），保证新→旧顺序不变，且不会被反复重写
    // ------------------------------------------------------------ 分层合并
    // 读放大的真正来源不是“页”而是“run 数”：一次区间扫描要为每条 run 各读一页。
    // 于是给 run 分层：同层攒够 LVL_T 条就把最旧的一组整体合成一条（升一层）。
    // 合并只写“合并后还活着的记录”：被更新的副本覆盖掉的旧记录直接消失，
    // 所以热点更新下的分层合并几乎不增加写放大，却把 run 数与空间一起降下来。
    static constexpr u32 LVL_MAX = 4;      // 层数上限（常量：层 id 进了清单字节）
#ifndef FCS_MAINT_MODE_DEFAULT
#define FCS_MAINT_MODE_DEFAULT 1           // R3-lite：默认提交后维护（编译期可改；运行期 set_maint_mode）
#endif
#ifndef FCS_MERGE_BUDGET_DEFAULT
#define FCS_MERGE_BUDGET_DEFAULT 256       // R2b：默认每片 256 源页（编译期可改；运行期 set_merge_budget_pages）
#endif
    u32 lvl_t_ = 8;                        // 每层 run 数上限：运行时旋钮（读/写两档）
    u32 lvl_merges_ = 0;                   // R2：每次提交的层合并预算（0 = 不限；见 set_level_merges 的实测）
    // R3-lite（第 12 轮，L1）：维护（split / compact / 层合并）挪出提交关键路径。
    //   maint_mode_ 0 = 老行为：维护在 commit() 持锁期间、提交点之前做（维护产物与本次数据同一个提交点入账）；
    //   maint_mode_ 1 = 提交点先落盘、放锁；然后按“维护单元”循环 {拿锁 → 一个单元 → 放锁}，
    //     产物（ADD/SEG_DEL/RUN_DEL）追加进 pend_delta_，**下一次**提交点入账；源页进 pending_free_，
    //     必须等到下一次 SB 之后才可复用（sb_gen_/pend_need_gen_ 闸，见 promote_pending）。
    //     读者在两个单元之间就能进来：最长排队时间 = 一个单元，而不是一整次提交的维护总量。
    // R2b（第 12 轮，L2）：组总页数 > merge_budget_ 的层合并开成 MergeJob（job_），按键区间一片 ≈ merge_budget_ 页地做
    //   （0 = 一次合完）。一组**一个产物**（RunWriter 跨片常驻），源 run 全程挂着、读照旧可见，finish 才摘段 + RUN_DEL +
    //   产物 RUN_ADD；每片开头按 (page0, seq) 验源身份，有源被快照钉住（ver <= snap_max）即 abandon_job。
    //   第一版"每片独立产物、同 seq"已否决（片与片之间老副本可见 ⇒ 复活）。mode 0（提交点之前）不开作业（坑 101）。
    int maint_mode_ = FCS_MAINT_MODE_DEFAULT;
    u32 merge_budget_ = FCS_MERGE_BUDGET_DEFAULT;   // 每片源页预算（页）；0 = 不切片
    u32 maint_units_max_ = 256;            // 一次 commit() 之后最多跑多少个维护单元（兜底，防无限循环）
    bool split_pending_ = false;           // 坑 100：上一轮 split_pass 到了 128 刀上限还有单元 > BMAX
    u64 sb_gen_ = 0;                       // 本进程成功写过的 SB 次数（单调）
    u64 pend_need_gen_ = 0;                // pending_free_ 里的页至少要等到 sb_gen_ ≥ 此值才能复用
    u64 def_need_gen_ = 0;                 // deferred_ 同上（快照释放时若还没到 ⇒ 转进 pending_free_）
    const std::vector<RunPtr>* merge_src_ = nullptr;   // 正在合并的源 run（newer_has 跳过：分片时源 run 仍活着）
    u64 maint_units_ = 0, maint_slices_ = 0, maint_errs_ = 0;   // 观测
    u64 cmp_valve_ = 0, cmp_gc_ = 0, rebal_calls_ = 0;          // 观测：安全阀压实 / 回收压实 / rebalance 次数
    // R6-lite（第 12 轮，M2）：挂载不算存活账（以前 recompute_liveness 占 1M 条库 open 的 63%）。
    //   单元 acct=false（live/dead 无意义、不参与压实候选、flush 的 probe_prev 只做 run 级 live_bytes 扣减）、
    //   段 live=占位 1（run 不会被当成全死）、run live_bytes=nbytes（保守，补算完 lb_settle_if_done 换成 lb_acc）。
    //   补算：维护单元每次 recount_sweep(sweep_cells_) 个单元（mode 1/2），mode 0 在提交内 rebalance 前一次性补齐；
    //   所有显式维护入口（maint_commit）/ verify / check_liveness 前强制补齐。分步作业收尾也用它：touched 单元 mark_unknown。
    bool lazy_acct_ = true;
    u32 unk_cells_ = 0;
    u64 sweep_lo_ = 0;
    u32 sweep_cells_ = 64;
    u32 range_auto_ = 0;                   // R7：范围墓碑自动归一阈值（0 = 关）
    u32 discard_min_ = 0;                  // R8：局部 TRIM 的最小整段页数（0 = 关）

    // “更新”= 段键 (seq, rid) 更大，与读路径/归并的赢家判定同一个全序。
    // 只比 seq 不够：第 10 轮之前压实产物沿用最新源的 seq，可能和还活着的源 run 同 seq，谁赢要看 rid；
    // 现在新建的 run 两两 seq 不同（坑 90），这条全序只为老库里遗留的同 seq 对保留。
    bool newer_may_contain(u64 k, u32 seq, u32 rid) const {
        const u64 hk = khash(k);          // 必须是 64 位：Bloom::add 用的是完整哈希
        const u64 me = seg_key(seq, rid);
        for (auto& kv : runs_)
            if (seg_key(kv.second->seq, kv.second->page0) > me && !is_merge_src(kv.second) && kv.second->bloom.may(hk)) return true;
        return false;
    }
    bool is_merge_src(const Run* r) const {
        if (!merge_src_) return false;
        for (RunPtr x : *merge_src_) if (x == r) return true;
        return false;
    }
    // 精确版：布隆说"可能有"的（约 2% 的候选）再用 fences + 页读确认。
    // 存活账必须是精确的 —— 它是"整条 run 全死 ⇒ 直接回收"和空间收敛的依据。
    bool newer_has(u64 k, u32 seq, u32 rid) {
        const u64 hk = khash(k);
        const u64 me = seg_key(seq, rid);
        for (auto& kv : runs_) {
            RunPtr r = kv.second;
            if (seg_key(r->seq, r->page0) <= me || is_merge_src(r) || !r->bloom.may(hk)) continue;
            const u8* v = nullptr; u16 len = 0;
            if (probe(r, 0, r->npages, k, ~0u, v, len) == RC::OK) return true;
        }
        return false;
    }

    // 坑 94（第 11 轮）：全序在 `me` 之前的 run 里，是否可能还有键 k 的**物理**副本。
    // 点墓碑只有在"它下面还有更老的版本"时才有意义；"下面"必须按物理存在算，不能只看本单元的段：
    // 被单元压实摘了段的 run 本体还在（别的单元还引用它），里面那份老值是"悬空"的 —— 它日后会随层合并
    // 进入某个产物、重新挂到本单元；要是墓碑这时已经没了，老值就复活（第一版按"单元里有没有更老的段"判，
    // g9 t94c 第 30 次提交 get(75) 复活）。run 级键域 + 布隆（无假阴性；小 run 没布隆 ⇒ 一律"可能有"）。
    bool older_may_contain(u64 k, u64 me) const {
        const u64 hk = khash(k);
        for (auto& kv : runs_) {
            RunPtr r = kv.second;
            if (!r->npages || seg_key(r->seq, r->page0) >= me) continue;
            if (k < r->first || k > r->last) continue;
            if (r->bloom.may(hk)) return true;
        }
        return false;
    }

    // 把一组 run 整体合并成一条新 run（全键域 k 路归并）
    RC merge_run_set(std::vector<RunPtr>& src, std::vector<ManEnt>& delta, u32 newlvl, bool force = false) {
        std::vector<Cur> cs;
        cs.reserve(src.size());
        u32 exp = 0, out_ver = 0, maxseq = 0;
        u64 kmin = ~0ull, kmax = 0, minkey = ~0ull;    // minkey：组内最老 run 的 seg_key（坑 94 的"更老"分界）
        for (RunPtr r : src) {
            if (!r || r->npages == 0) continue;
            exp += r->nrec;
            out_ver = std::max(out_ver, r->ver);
            maxseq = std::max(maxseq, r->seq);
            minkey = std::min(minkey, seg_key(r->seq, r->page0));
            kmin = std::min(kmin, r->first);
            kmax = std::max(kmax, r->last);
            cs.emplace_back();
            Cur& c = cs.back();
            c.r = r; c.p0 = 0; c.p1 = r->npages; c.klo = 0; c.khi = ~0ull;
            c.load(this);
        }
        if (cs.size() < 2 && !force) return RC::OK;      // force ⇒ 单条 run 也重写（搬家）
        static Cell whole;        // 全键域伪单元：只用来喂 merge_emit 的边界
        whole.lo = 0; whole.hi = ~0ull;
        RunWriter w(out_ver, exp);
        w.st = this;
        w.want_kidx = keyidx_;
        bool ok = true;
        u64 moved = 0;
        // 存活账必须**在合并时**算：合并后的 run 只有一个 seq，事后再扫就丢掉了
        // “每条记录原本来自哪条 run（seq 多少）”，用 nr->seq 代替会把它算新生
        // （实测 2000 键覆盖负载：一条 run 记 118 条活，真值只有 40 ⇒ 永不回收）。
        // 判据 = “有没有 seq 更大的 run 也含这个键”。Bloom 只用来快速排除（无假阴性）；
        // 少数命中的候选留到归并结束后再精确确认 —— 那时游标不再前进，页缓冲随便被 probe 覆盖。
        // 判定要等新 run 落地之后再做：那时才知道它的段身份 (seq, page0)，
        // 而“谁是赢家”正是按这个全序比的（压实产物可能和源 run 同 seq）。
        //
        // R1（第 11 轮）：单元级存活账也在这里顺手算，不再对每个触及单元 recount（k 路归并该单元**全部**段：
        // 100k×500B 负载 18 次合并 ⇒ 82k 次 recount ≈ 写路径 CPU 的一半）。合并前后，单元 c 里只有两件事变了：
        //   (1) 源 run 的段没了 —— 它们里面的**赢家**（对读可见的记录）搬进了新 run；别的 run 的段、赢家都不变；
        //   (2) 被范围墓碑盖住的记录、同键旧副本物理消失 —— 它们本来就不在 live 里，只让 total（dead）变小。
        // 归并流键序递增 ⇒ 单元指针单调前进，每条 emit 的记录知道：所属单元、来源 run、页上字节 osz、
        // 来源 run 在该单元有没有段（没有 ⇒ 它以前对读不可见、不在 c->live 里：单元压实摘段后留在页里的记录）、
        // 是否可能被更新的 run 盖住（布隆；盖住 ⇒ 以前就不是赢家、现在也不是）。于是：
        //   新 run 在 c 的段 live = emit 到 c 的条数 − 被更新 run 盖住的条数；
        //   c->live = c->live − 以前可见的源赢家字节（旧页上的大小）+（新 run 在 c 的全部字节 − 被盖住记录的新大小）；
        //   c->dead = total_rec_bytes(c) − c->live（前缀和，只解码边界页）。
        // 新 run 在 c 的全部字节用 seg_totals（前缀和）一步拿到，被盖住的少数记录用 probe 取新大小 —— 一页都不用整页解码。
        // 口径与 recount/verify 完全一致（同一套赢家全序 + 同一个 range_hidden）；FCS_TRACE 下逐单元和 recount 对账。
        struct CellAcc { Cell* c; u64 smask; u32 em; u32 sup; u64 vis_old; u64 sup_new; };
        std::vector<CellAcc> acc;                   // 覆盖 [kmin, kmax] 的连续单元
        const bool fast = src.size() <= 64;         // 源 run 索引用 64 位掩码；更多就退回 recount（不会发生：lvl_t_*4）
        {
            auto cit = cells_.upper_bound(kmin);
            if (cit != cells_.begin()) --cit;
            for (; cit != cells_.end() && cit->second->lo <= kmax; ++cit) {
                Cell* c = cit->second;
                CellAcc a{c, 0, 0, 0, 0, 0};
                for (size_t i = 0; i < src.size() && fast; ++i)
                    if (src[i] && c->segs.count(seg_key(src[i]->seq, src[i]->page0))) a.smask |= 1ull << i;
                acc.push_back(a);
            }
        }
        // 坑 94（第 11 轮）：点墓碑只有在"它下面还有更老的版本"时才有意义。组是全库 seq 连续的一段、源 run 合并后
        // **整条**销毁 ⇒ 组内的旧副本随归并消失，剩下可能更老的只有全序在组之前的 run（older_may_contain：物理口径，
        // 悬空副本也算）。没有 ⇒ 墓碑不写进产物。快照不受影响：level_pass / consolidate 只合并 ver > snap_max 的 run，
        // 快照看不见这些墓碑，也看不见它们盖住的东西（要么同样 ver > snap_max，要么还在更老的 run 里 ⇒ 墓碑保留）。
        // 以前墓碑永远留在底层：put 5000 / del 5000 / consolidate 跑 5 轮，记录 5000 → 25000、页 36 → 180。
        u64 dropped_tombs = 0;
        auto src_index = [&](RunPtr r) -> size_t { for (size_t i = 0; i < src.size(); ++i) if (src[i] == r) return i; return 64; };
        struct Pend { u64 k; u32 osz; u32 ci; bool vis; bool dropped; };
        std::vector<Pend> chk;
        u64 lb = 0;
        size_t ci = 0;
        take_set_.clear();
        for (RunPtr r : src) take_set_.insert(r->page0);   // 归并会把源 run 全部摘掉
        merge_src_ = &src;                                 // newer_* 跳过源 run（它们在归并期间还活着）
        struct SrcGuard { Store* s; ~SrcGuard() { s->merge_src_ = nullptr; } } src_guard{this};
        std::vector<std::pair<RunPtr, std::array<u8, 16>>> took;
        merge_emit(&whole, cs, [&](u64 k, u32 v, const u8* p, u16 l, u32 osz, RunPtr sr, const u8* dsc) {
            while (ci + 1 < acc.size() && acc[ci].c->hi <= k) ++ci;
            CellAcc* a = fast && ci < acc.size() ? &acc[ci] : nullptr;
            // 第 12 轮：这个单元里没有任何源 run 的段 ⇒ 这里的记录全是悬空副本（单元压实摘段后留在页里的，赢家已在
            // 更新的压实产物里）。以前照搬进产物再挂回去（无害但白写）；现在不搬 —— 分步作业更**必须**不搬：
            // 作业跨提交点，期间被压实摘掉段的单元里，赢家在 seq 更新的产物里，搬了也只是多写。
            if (a && a->smask == 0) return true;
            bool vis = false;
            if (a) { size_t si = sr ? src_index(sr) : 64; vis = si < 64 && ((a->smask >> si) & 1ull); }
            if (l == 0 && !dsc && !older_may_contain(k, minkey)) {   // 坑 94：下面没有更老的副本 ⇒ 墓碑不再往下带
                if (a && vis) {
                    a->vis_old += osz;                       // 以前对读可见（算在 c->live 里），现在物理消失……
                    if (newer_may_contain(k, maxseq, 0)) chk.push_back(Pend{k, osz, (u32)ci, true, true});   // ……除非它本来就被更新的 run 盖着
                }
                ++dropped_tombs;
                return true;
            }
            // 溢出值：原样接管链（0 字节数据读 + 0 字节数据写）。
            bool added = dsc ? w.add_take(k, v, dsc) : w.add(k, v, p, l);
            if (!added) { ok = false; return false; }
            if (dsc && sr) { std::array<u8, 16> c{}; std::memcpy(c.data(), dsc, 16); took.push_back({sr, c}); }
            moved += osz;                      // 页上真实占用（溢出值只有 16 B）
            if (a) { ++a->em; if (vis) a->vis_old += osz; }
            if (newer_may_contain(k, maxseq, 0)) chk.push_back(Pend{k, osz, (u32)ci, vis, false});
            else lb += osz;
            return true;
        });
        if (!ok) { w.abandon(); take_set_.clear(); return RC::NOSPACE; }
        RunPtr nr = nullptr;
        RC rc = finish_run(w, nr, &wr_merge_);
        if (rc != RC::OK) { take_set_.clear(); return rc; }
        // nr == nullptr ⇒ 一条记录都没产出：组内每条记录要么被范围墓碑盖住、要么是可丢的墓碑（坑 94）。
        // 源 run 照样摘掉（以前这里直接 return，源 run 原地不动 ⇒ level_pass 每次提交都把同一组白合并一遍）。
        for (auto& t : took) chain_taken(t.first, t.second.data());
        take_set_.clear();
        if (nr) {
            nr->lvl = newlvl;
            nr->seq = maxseq;      // 保持与“未参与合并的 run”的相对新旧关系
        }
        // 摘掉源 run 在所有单元里的段
        std::vector<u32> rids;
        for (RunPtr r : src) rids.push_back(r->page0);
        std::vector<Cell*> touched;                 // 只有这些单元的账会变
        for (auto& kv : cells_) {
            Cell* c = kv.second;
            bool hit = nr && (c->hi > nr->first && c->lo <= nr->last);   // attach_run 可能落段
            for (auto& sg : c->segs)
                if (!hit && std::find(rids.begin(), rids.end(), sg.second.rid) != rids.end()) hit = true;
            if (hit) touched.push_back(c);
            for (auto it = c->segs.begin(); it != c->segs.end(); ) {
                if (std::find(rids.begin(), rids.end(), it->second.rid) == rids.end()) { ++it; continue; }
                ManEnt m;
                m.op = M_SEG_DEL; m.key = c->lo; m.page0 = it->second.rid;
                RunPtr rr = runs_[it->second.rid];
                m.seq = rr ? rr->seq : 0;
                delta.push_back(m);
                seg_set_live(it->second, 0);
                if (rr && rr->refs) --rr->refs;
                it = c->segs.erase(it);
            }
        }
        for (RunPtr r : src) {
            if (!r) continue;
            delta.push_back(run_ent(r, M_RUN_DEL));
            const bool safe = run_page_safe(r);
            free_ovfl_of(r, safe);
            free_pages(r->page0, run_block(r), safe);
            runs_.erase(r->page0);
            delete r;
        }
        if (nr) {
            runs_[nr->page0] = nr;
            attach_run(nr);
            delta.push_back(run_ent(nr, M_RUN_ADD));
        }
        // 存活字节：候选逐条精确确认（此时源 run 已摘链，新 run 已在 runs_ 里）
        for (const Pend& e : chk) {
            // "比组更新"的 run：有产物时 = 全序在产物之后；没产物时 = seq 严格大于组内最大 seq
            const bool newer = nr ? newer_has(e.k, nr->seq, nr->page0) : newer_has(e.k, maxseq, 0xFFFFFFFFu);
            if (!newer) { if (!e.dropped) lb += e.osz; continue; }
            if (!fast || e.ci >= acc.size()) continue;
            CellAcc& a = acc[e.ci];
            if (e.vis) a.vis_old = a.vis_old >= e.osz ? a.vis_old - e.osz : 0;   // 以前就被盖住：不曾在 c->live 里
            if (e.dropped || !nr) continue;
            ++a.sup;
            const u8* v = nullptr; u16 len = 0; u32 osz_new = 0;
            if (probe(nr, 0, nr->npages, e.k, ~0u, v, len, &osz_new) == RC::OK) a.sup_new += osz_new;
        }
        if (nr) nr->live_bytes = lb > nr->nbytes ? nr->nbytes : lb;
        if (!fast) {
            for (Cell* c : touched) recount(c);
        } else {
            if (nr && nr->meta_pending) ensure_meta(nr);
            const u64 nk = nr ? seg_key(nr->seq, nr->page0) : 0;
            for (CellAcc& a : acc) {
                Cell* c = a.c;
                auto it = nr ? c->segs.find(nk) : c->segs.end();
                u64 nb = 0; u32 nrc = 0;
                if (!c->acct) {                      // R6-lite：账未知的单元保持未知（新段也占位），只更新页数
                    if (it != c->segs.end()) seg_set_unknown(it->second);
                    c->pages = 0;
                    for (auto& sg : c->segs) c->pages += sg.second.p1 - sg.second.p0;
                    continue;
                }
                if (it != c->segs.end()) {
                    seg_totals(nr, it->second, c->lo, c->hi, nb, nrc);
                    seg_set_live(it->second, a.em >= a.sup ? a.em - a.sup : 0);
                }
                u64 live = c->live >= a.vis_old ? c->live - a.vis_old : 0;
                live += nb >= a.sup_new ? nb - a.sup_new : 0;
                c->live = live;
                u64 total = total_rec_bytes(c);
                c->dead = total > live ? total - live : 0;
                c->pages = 0;
                for (auto& sg : c->segs) c->pages += sg.second.p1 - sg.second.p0;
#ifdef FCS_TRACE
                {   // 对账：增量结果必须和全量 recount 完全一致
                    const u64 l0 = c->live, d0 = c->dead; const u32 nl = it != c->segs.end() ? it->second.live : 0;
                    if (nrc != a.em) std::fprintf(stderr, "  R1 CHECK cell=%llu seg_totals recs=%u emitted=%u\n", (unsigned long long)c->lo, nrc, a.em);
                    recount(c);
                    const u32 nl2 = it != c->segs.end() ? it->second.live : 0;
                    if (l0 != c->live || d0 != c->dead || nl != nl2)
                        std::fprintf(stderr, "  R1 MISMATCH cell=[%llu,%llu) live %llu vs %llu dead %llu vs %llu newseg.live %u vs %u (em=%u sup=%u vis_old=%llu nb=%llu sup_new=%llu)\n",
                                     (unsigned long long)c->lo, (unsigned long long)c->hi, (unsigned long long)l0, (unsigned long long)c->live,
                                     (unsigned long long)d0, (unsigned long long)c->dead, nl, nl2, a.em, a.sup, (unsigned long long)a.vis_old,
                                     (unsigned long long)nb, (unsigned long long)a.sup_new);
                }
#endif
            }
            // acc 之外的触及单元（理论上没有：源段只能落在 [kmin,kmax] 内）保守重算
            for (Cell* c : touched)
                if (c->lo > kmax || c->hi <= kmin) recount(c);
        }
#ifdef FCS_TRACE
        std::fprintf(stderr, "  LEVEL merge %zu runs -> seq=%u lvl=%u pg=%u nrec=%u live=%u moved=%llu tombs_dropped=%llu\n",
                     src.size(), nr ? nr->seq : 0, newlvl, nr ? nr->npages : 0, nr ? nr->nrec : 0, nr ? nr->live_recs : 0,
                     (unsigned long long)moved, (unsigned long long)dropped_tombs);
#endif
        return RC::OK;
    }

    // R2b：开一个分步合并作业（组 = set，升到 newlvl）。
    void start_job(const std::vector<RunPtr>& set, u32 newlvl) {
        abandon_job();
        job_.reset(new MergeJob());
        MergeJob& j = *job_;
        u32 exp = 0;
        for (RunPtr r : set) {
            if (!r || !r->npages) continue;
            j.src.push_back({r->page0, r->seq});
            exp += r->nrec;
            j.out_ver = std::max(j.out_ver, r->ver);
            j.maxseq = std::max(j.maxseq, r->seq);
            j.minkey = std::min(j.minkey, seg_key(r->seq, r->page0));
            j.kmin = std::min(j.kmin, r->first);
            j.kmax = std::max(j.kmax, r->last);
        }
        j.newlvl = newlvl;
        j.next_lo = j.kmin;
        j.w.reset(new RunWriter(j.out_ver, exp));
        j.w->st = this;
        j.w->want_kidx = keyidx_;
    }
    // 作业推进一片；合完最后一片就落地。返回 MORE = 还有片；OK = 作业结束（落地或作废）；其它 = 错误。
    RC merge_job_step(std::vector<ManEnt>& delta) {
        if (!job_) return RC::OK;
        MergeJob& j = *job_;
        // ---- 1. 验身份：源 run 都还在、没被快照钉住 ----
        std::vector<RunPtr> src;
        const u32 vmin = snap_max();
        for (auto& e : j.src) {
            auto it = runs_.find(e.first);
            if (it == runs_.end() || it->second->seq != e.second || !it->second->npages || (vmin && it->second->ver <= vmin)) {
                abandon_job();
                return RC::OK;
            }
            src.push_back(it->second);
        }
        if (!j.done) {
            // ---- 2. 定片：从 next_lo 所在单元起，按键序累计源段页数到 ≥ 预算 ----
            u64 lo_s = 0, hi_s = ~0ull;
            bool started = false, reached_end = true;
            u64 acc_pg = 0;
            auto cit = cells_.upper_bound(j.next_lo);
            if (cit != cells_.begin()) --cit;
            for (; cit != cells_.end() && cit->second->lo <= j.kmax; ++cit) {
                Cell* c = cit->second;
                if (c->hi <= j.next_lo) continue;
                u32 pg = 0;
                for (auto& sg : c->segs)
                    for (RunPtr r : src) if (sg.second.rid == r->page0) { pg += sg.second.p1 - sg.second.p0; break; }
                if (!started) { if (!pg) continue; started = true; lo_s = c->lo; }
                acc_pg += pg;
                hi_s = c->hi;
                if (merge_budget_ && acc_pg >= merge_budget_) {
                    auto nx = std::next(cit);
                    reached_end = !(nx != cells_.end() && nx->second->lo <= j.kmax);
                    break;
                }
            }
            if (!started) { j.done = true; }          // 剩下的单元里源 run 都没段了
            else {
                if (reached_end) hi_s = ~0ull;        // 最后一片：扫到键域尽头（run 级 last 之后不会再有记录）
                // ---- 3. 归并这一片 ----
                std::vector<Cur> cs;
                cs.reserve(src.size());
                for (RunPtr r : src) {
                    cs.emplace_back();
                    Cur& c = cs.back();
                    c.r = r; c.klo = lo_s; c.khi = hi_s;
                    page_range(r, lo_s, hi_s, c.p0, c.p1);
                    c.load(this, lo_s);
                }
                struct CA { Cell* c; u64 smask; };
                std::vector<CA> acc;                  // 片内单元：源 run 在该单元有没有段（没有 ⇒ 记录全是悬空副本，不搬）
                {
                    auto it2 = cells_.upper_bound(lo_s);
                    if (it2 != cells_.begin()) --it2;
                    for (; it2 != cells_.end() && it2->second->lo < hi_s; ++it2) {
                        if (it2->second->hi <= lo_s) continue;
                        CA a{it2->second, 0};
                        for (size_t i = 0; i < src.size() && i < 64; ++i)
                            if (a.c->segs.count(seg_key(src[i]->seq, src[i]->page0))) a.smask |= 1ull << i;
                        acc.push_back(a);
                    }
                }
                take_set_.clear();
                for (RunPtr r : src) take_set_.insert(r->page0);   // 产物落地时源 run 整条销毁 ⇒ 链可以接管
                merge_src_ = &src;
                struct SrcGuard { Store* s; ~SrcGuard() { s->merge_src_ = nullptr; } } src_guard{this};
                static Cell slice;
                slice.lo = lo_s; slice.hi = hi_s;
                RunWriter& w = *j.w;
                bool ok = true;
                size_t ci = 0;
                const u32 maxseq = j.maxseq;
                const u64 minkey = j.minkey;
                merge_emit(&slice, cs, [&](u64 k, u32 v, const u8* p, u16 l, u32 osz, RunPtr sr, const u8* dsc) {
                    while (ci + 1 < acc.size() && acc[ci].c->hi <= k) ++ci;
                    if (ci < acc.size() && acc[ci].smask == 0) return true;   // 悬空副本：不搬（见 merge_run_set 同款说明）
                    if (l == 0 && !dsc && !older_may_contain(k, minkey)) { ++j.dropped_tombs; return true; }   // 坑 94
                    bool added = dsc ? w.add_take(k, v, dsc) : w.add(k, v, p, l);
                    if (!added) { ok = false; return false; }
                    if (dsc && sr) { std::array<u8, 16> c{}; std::memcpy(c.data(), dsc, 16); j.took.push_back({sr->page0, c}); }
                    j.moved += osz;
                    if (newer_may_contain(k, maxseq, 0)) j.chk.push_back(MergeJob::Cand{k, osz});
                    else j.lb += osz;
                    return true;
                });
                take_set_.clear();
                if (!ok) { abandon_job(); return RC::OK; }      // 空间不够：尽力而为（与 merge_run_set 的 NOSPACE 同义）
                ++j.slices;
                ++maint_slices_;
                j.next_lo = hi_s;
                if (reached_end || hi_s == ~0ull) j.done = true;
                if (!j.done) return RC::MORE;
            }
        }
        // ---- 4. 落地：与 merge_run_set 的尾段一致（摘段、退休源 run、挂产物），账目整段重算 ----
        RunPtr nr = nullptr;
        take_set_.clear();
        for (RunPtr r : src) take_set_.insert(r->page0);
        RC rc = finish_run(*j.w, nr, &wr_merge_);
        if (rc != RC::OK) { abandon_job(); return rc == RC::NOSPACE ? RC::OK : rc; }
        for (auto& t : j.took) { auto it = runs_.find(t.first); if (it != runs_.end()) chain_taken(it->second, t.second.data()); }
        take_set_.clear();
        if (nr) { nr->lvl = j.newlvl; nr->seq = j.maxseq; }
        std::vector<u32> rids;
        for (RunPtr r : src) rids.push_back(r->page0);
        std::vector<Cell*> touched;
        for (auto& kv : cells_) {
            Cell* c = kv.second;
            bool hit = nr && (c->hi > nr->first && c->lo <= nr->last);
            for (auto it = c->segs.begin(); it != c->segs.end(); ) {
                if (std::find(rids.begin(), rids.end(), it->second.rid) == rids.end()) { ++it; continue; }
                hit = true;
                ManEnt m;
                m.op = M_SEG_DEL; m.key = c->lo; m.page0 = it->second.rid;
                RunPtr rr = runs_[it->second.rid];
                m.seq = rr ? rr->seq : 0;
                delta.push_back(m);
                seg_set_live(it->second, 0);
                if (rr && rr->refs) --rr->refs;
                it = c->segs.erase(it);
            }
            if (hit) touched.push_back(c);
        }
        for (RunPtr r : src) {
            delta.push_back(run_ent(r, M_RUN_DEL));
            const bool safe = run_page_safe(r);
            free_ovfl_of(r, safe);
            free_pages(r->page0, run_block(r), safe);
            runs_.erase(r->page0);
            delete r;
        }
        src.clear();
        if (nr) {
            runs_[nr->page0] = nr;
            attach_run(nr);
            delta.push_back(run_ent(nr, M_RUN_ADD));
            u64 lb = j.lb;
            for (const MergeJob::Cand& e : j.chk) if (!newer_has(e.k, nr->seq, nr->page0)) lb += e.osz;
            nr->live_bytes = lb > nr->nbytes ? nr->nbytes : lb;
        }
        // 片与片之间可能有刷出 / 压实 / 拆分改过这些单元的账 ⇒ 增量公式不再成立。整段 recount 会让落地单元很长
        //（实测 stall 负载最长读者卡顿 63 → 95 ms），所以标成"账未知"交给补算扫描按批做（lazy 关掉时才就地重算）。
        for (Cell* c : touched) { if (lazy_acct_) mark_unknown(c); else recount(c); }
#ifdef FCS_TRACE
        std::fprintf(stderr, "  JOB merge %zu runs -> seq=%u lvl=%u pg=%u nrec=%u slices=%u moved=%llu tombs_dropped=%llu\n",
                     j.src.size(), nr ? nr->seq : 0, j.newlvl, nr ? nr->npages : 0, nr ? nr->nrec : 0, j.slices,
                     (unsigned long long)j.moved, (unsigned long long)j.dropped_tombs);
#endif
        job_.reset();
        maint_sync_pending_ = true;
        return RC::OK;
    }

    // 每层最多 LVL_T 条 run；超了就把最旧的一组升层
    //   one = true（R3-lite 的维护单元）：做完**一次**合并动作（一片或整组）就返回 MORE；没事可做返回 OK。
    RC level_pass(std::vector<ManEnt>& delta, bool one = false) {
        const u32 vmin = snap_max();          // 见 retire_dead_runs 的说明
        // 坑 91：合并组必须在**全库** seq 顺序上连续（组内任意两个相邻 seq 之间不能夹着组外 run）。
        // 合并产物取组内最大 seq；若组外有一条 run R 的 seq 落在组内区间里，R 持有的版本比组内老成员的新、
        // 比产物的 seq 老 —— 产物会以老版本压过 R，读到过期值。老代码靠"每层按 seq 取最老 n"隐含保证，
        // 但快照会把一层最老的 run 钉住（ver ≤ snap_max 不参加合并），组从它后面开始；快照释放后它再和
        // 更新的 run 组队，就跨过了已经并到下一层的中间 run。这里显式检查：组在第一个"夹缝"处截断；
        // 若最老那条自己就被隔开，直接把它**提升**到下一层（只改内存层号，层号只是分组提示，不入清单），
        // 下次它和下一层的老 run 组队 —— 那些 run 的 seq 都比它小或连续。
        std::vector<u32> all_seq;
        auto gap_between = [&](u32 a, u32 b) {      // 是否存在 seq ∈ (a, b)
            auto it = std::upper_bound(all_seq.begin(), all_seq.end(), a);
            return it != all_seq.end() && *it < b;
        };
        u32 merges = 0;                               // R2：本次提交已做的合并数
        for (u32 guard = 0; guard < 16; ++guard) {
            if (job_) {                               // R2b：先推进手头的分步作业
                RC r = merge_job_step(delta);
                // 坑 101（第 12 轮 M2 验收时发现）：mode 0（提交点之前、同一把锁里做维护）下分片毫无意义，但老代码
                // 每轮 guard 只推进一片 ⇒ 一次提交最多 16 片，40 片的大合并要拖 3 次提交，期间新 run 堆积
                //（wprof 100k×500B：结束时 1201 条 run、avg 64 ms）。非 one 模式把手头作业一口气推完，不占 guard 配额。
                while (!one && r == RC::MORE) r = merge_job_step(delta);
                if (r == RC::MORE) return RC::MORE;
                if (r != RC::OK) return r;
                ++merges;
                if (one) return RC::MORE;
                continue;                             // 作业结束：重新选组
            }
            bool did = false;
            all_seq.clear();                          // 每轮重算：上一轮的合并会增删 run
            for (auto& kv : runs_) if (kv.second->npages) all_seq.push_back(kv.second->seq);
            std::sort(all_seq.begin(), all_seq.end());
            for (u32 lvl = 0; lvl < LVL_MAX && !did; ++lvl) {
                std::vector<RunPtr> set;
                for (auto& kv : runs_)
                    if (kv.second->lvl == lvl && kv.second->npages && (!vmin || kv.second->ver > vmin) && !job_has(kv.second->page0))
                        set.push_back(kv.second);
                std::sort(set.begin(), set.end(), [](RunPtr a, RunPtr b) { return a->seq < b->seq; });
                // T1（第 12 轮）实验过"按负载覆盖比在 lvl_t 与 lvl_t/2 之间自适应"的三个版本，都没有普适收益
                //（覆盖型大值负载 lvl_t=4 全面更好，小记录负载 lvl_t=8 更好，覆盖比预测不了哪个对），不进引擎；
                // 数据与结论见 docs/DISCUSS12.md §6 T1。需要的部署直接 set_lvl_t(4)。
                const size_t t = lvl_t_;
                if (set.size() < t) continue;
                // R2（第 11 轮）：预算用完就留给下次提交 —— 除非这一层已经积压到 lvl_t×4（读放大兜底）。
                // 以前一次提交最多级联 16 轮 × 4 层，大合并全砸在同一次提交里（100k×500B：max 530 ~ 600 ms）。
                if (lvl_merges_ && merges >= lvl_merges_ && set.size() < t * 4) continue;
                // 只有"合并能换回东西"才付合并的写代价：
                //  (a) 这一层垃圾占比 ≥ FCS_LVL_DIRTY_PCT（默认 30%）⇒ 合并立刻回收空间；
                //     门槛太低（曾用 20%）会让"刚写就被覆盖"的层级反复重写：实测 20%→30%
                //     写放大 3.14x→2.57x、耗时减半，段数上限 23→7。
                //  (b) 或者 run 数已经很多 ⇒ 为了区间扫描的读放大，批量合并一次。
                size_t n = std::min<size_t>(set.size(), t);
                u64 tot = 0, live = 0;
                for (size_t i = 0; i < n; ++i) { tot += set[i]->nbytes; live += set[i]->live_bytes; }
                bool reclaim = tot && (tot - live) * 100 >= tot * (u64)FCS_LVL_DIRTY_PCT;
                if (!reclaim) {
                    if (set.size() < t * 4) continue;
                    n = std::min<size_t>(set.size(), t * 4);
                }
                size_t m = 1;                        // 连续前缀长度
                while (m < n && !gap_between(set[m - 1]->seq, set[m]->seq)) ++m;
                if (m < 2) {                         // 最老那条被组外 run 隔开：提升到下一层，重来
                    set[0]->lvl = lvl + 1;
                    did = true;
                    continue;
                }
                set.resize(m);
                u64 gp = 0;
                for (RunPtr r : set) gp += r->npages;
                if (one && merge_budget_ && gp > merge_budget_) {   // R2b：组太大 ⇒ 开作业分片做（坑 101：只在按单元维护时）
                    start_job(set, lvl + 1);
                    RC r = merge_job_step(delta);
                    if (r != RC::OK && r != RC::MORE) return r;
                    did = true;
                    ++merges;
                    if (one) return RC::MORE;
                    continue;                        // 下一轮 guard 继续推进作业
                }
                RC rc = merge_run_set(set, delta, lvl + 1);
                if (rc == RC::NOSPACE) return RC::OK;   // 尽力而为：空间不够就不合并
                if (rc != RC::OK) return rc;
                did = true;
                ++merges;
                maint_sync_pending_ = true;
                if (one) return RC::MORE;
            }
            if (!did) return RC::OK;
        }
        return RC::OK;
    }

    RC compact_cell(Cell* c, std::vector<ManEnt>& delta) {
#ifdef FCS_TRACE
        u64 dead_before = c->dead, live_before = c->live;
        u32 segs_before = (u32)c->segs.size();
#endif
        std::vector<Cur> cs;
        std::vector<u32> rids;
        for (auto& sg : c->segs) {
            RunPtr r = runs_[sg.second.rid];
            if (!r || sg.second.p0 >= sg.second.p1) continue;
            rids.push_back(sg.second.rid);
            cs.emplace_back();
            cs.back().r = r;
            cs.back().p0 = sg.second.p0;
            cs.back().p1 = std::min(sg.second.p1, r->npages);
            cs.back().load(this);
        }
        if (rids.size() < 2) return RC::OK;
        // 这次压实只摘掉**本单元**的段：只有"除本单元外没人引用"的 run 才会被销毁。
        // 其它 run 压完还活着，它们的链不能接管（见 take_ok）。
        take_set_.clear();
        for (u32 rid : rids) { auto f = runs_.find(rid); if (f != runs_.end() && f->second->refs <= 1) take_set_.insert(rid); }
        u32 exp_keys = 0, out_ver = 0;
        for (u32 rid : rids) {
            auto it2 = runs_.find(rid);
            if (it2 == runs_.end()) continue;
            exp_keys += it2->second->nrec;
            out_ver = std::max(out_ver, it2->second->ver);   // 压实产物取源版本的最大值
        }
        RunWriter w(out_ver, exp_keys);
        w.st = this;
        w.want_kidx = keyidx_;
        bool ok = true;
        struct Dec { RunPtr r; u64 bytes; u64 key; };
        std::vector<Dec> dec;                    // 先攒着：新 run 写成功后才扣
        std::vector<std::pair<RunPtr, std::array<u8, 16>>> took;   // 接管成功后才转移所有权
        u64 dropped_tombs = 0;
        merge_emit(c, cs, [&](u64 k, u32 v, const u8* p, u16 l, u32 osz, RunPtr src, const u8* dsc) {
            // 坑 94（第 11 轮）：压实只摘段、源 run 本体多半还活着（别的单元在引用）⇒ 组内比墓碑老的副本**物理上还在**，
            // 日后会随层合并重新挂回本单元。所以这里的"更老"按墓碑自己的 run 算（含组内 run）：全序更早的 run 都不可能
            // 含这个键，墓碑才能丢。实际多数墓碑在层合并里被丢（那里源 run 整条销毁，条件宽得多）。
            // 调用方的 cell_has_old 门禁保证没有快照还要读这个单元。
            if (l == 0 && !dsc && src && !older_may_contain(k, seg_key(src->seq, src->page0))) {
                dec.push_back({src, osz, k}); ++dropped_tombs; return true;
            }
            bool added = dsc ? w.add_take(k, v, dsc) : w.add(k, v, p, l);
            if (!added) { ok = false; return false; }
            if (dsc && src) { std::array<u8, 16> c{}; std::memcpy(c.data(), dsc, 16); took.push_back({src, c}); }
            if (src) dec.push_back({src, osz, k});
            return true;
        });
        (void)dropped_tombs;
        if (!ok) { w.abandon(); take_set_.clear(); return RC::NOSPACE; }
        RunPtr nr = nullptr;
        RC rc = finish_run(w, nr, &wr_compact_, true);   // 维护可以动用预留页
        if (rc != RC::OK) { take_set_.clear(); return rc; }
        for (auto& t : took) chain_taken(t.first, t.second.data());   // 链现在归新 run
        take_set_.clear();
        for (auto& d : dec) {                    // 记录搬进新 run ⇒ 来源 run 的存活字节减少
            if (d.r->live_bytes >= d.bytes) d.r->live_bytes -= d.bytes; else d.r->live_bytes = 0;
            if (d.r->lb_unknown) d.r->lb_acc = d.r->lb_acc >= d.bytes ? d.r->lb_acc - d.bytes : 0;   // 压实只碰已知单元
        }
        for (u32 rid : rids) {               // 摘掉旧段
            auto f = c->segs.begin();
            while (f != c->segs.end() && f->second.rid != rid) ++f;
            if (f == c->segs.end()) continue;
            c->pages -= f->second.p1 - f->second.p0;
            seg_set_live(f->second, 0);
            ref_dec(rid);
            c->segs.erase(f);
            ManEnt m;
            m.op = M_SEG_DEL;
            m.key = c->lo;
            m.page0 = rid;
            RunPtr rr = runs_[rid];
            m.seq = rr ? rr->seq : 0;
            delta.push_back(m);
        }
        // 产物的身份：**seq 用 finish_run 刚分配的新鲜号（全局最大），层号 = 0**。
        // 正确性：单元的段集合覆盖了本单元所有键的全部已提交版本（任何含本单元键的 run 都被 attach_run 挂到本单元，
        // 直到被某次压实消费），所以产物里的每个版本都是该键此刻最新的已提交版本 —— 把它标成"最新的 run"名副其实；
        // 之后新刷盘的 run seq 更大、自然压过它。
        // 坑 89：以前层号 = best_lvl + 1，LVL_MAX 之上的层 level_pass 永远不看，压实两代之后产物再没有任何合并路径接手；
        //        每个单元产一条私有 run，run 数趋向单元数（20k 键 × 500 B 实测 685 条，605 条在 lvl 5）。
        // 坑 90（更严重，老代码同样有）：以前 seq = 最新源的 seq（best_seq）。最新源 F 通常还活着（别的单元还引用它），
        //        产物 O 和 F 同 seq；O 进入某次层合并后，合并产物 M 的 seq = 组内最大 = F.seq，而 F 不在组内 ——
        //        M 的 rid 若比 F 大，对 F 仍最新的键 M 会以更老的版本（来自组内老 run）胜出，读到过期值。
        //        复现：bench6 ovw 5000 500 200 200 → 老引擎回读 bad=1127（22% 的键）。新鲜 seq 后不存在同 seq 的两条 run，
        //        "同 seq 看 rid"只剩历史兼容意义。
        for (u32 rid : rids) {               // 无任何单元再引用 ⇒ 整条 run 释放
            RunPtr r = runs_[rid];
            if (r && r->refs == 0) {
                delta.push_back(run_ent(r, M_RUN_DEL));
                const bool safe = run_page_safe(r);
                free_ovfl_of(r, safe);
                free_pages(r->page0, run_block(r), safe);
                runs_.erase(rid);
                delete r;
            }
        }
        if (nr) {
            nr->lvl = 0;                     // seq 已由 finish_run 分配（next_seq_++），不再覆盖
            runs_[nr->page0] = nr;
            c->segs[seg_key(nr->seq, nr->page0)] = Seg{nr->page0, 0, nr->npages,
                                                      std::max(c->lo, nr->first), std::min(c->hi, nr->last + 1)};
            nr->refs = 1;
            c->pages += nr->npages;
            delta.push_back(run_ent(nr, M_RUN_ADD));
        }
        recount(c);
#ifdef FCS_TRACE
        std::fprintf(stderr, "  compact cell[%llu,%llu): segs %u->%zu | live %llu->%llu dead %llu->%llu | out=%u pg tombs_dropped=%llu\n",
                     (unsigned long long)c->lo, (unsigned long long)c->hi, segs_before, c->segs.size(),
                     (unsigned long long)live_before, (unsigned long long)c->live,
                     (unsigned long long)dead_before, (unsigned long long)c->dead, nr ? nr->npages : 0, (unsigned long long)dropped_tombs);
#endif
        return RC::OK;
    }

    // ------------------------------------------------------------ 清单提交
    // 清单提交：小增量内联进超级块页（提交点本来就要写）；攒够一批再落一页清单。
    static bool man_ok(const ManEnt& m) {
        if (m.op < 1 || m.op > 6) return false;
        if (m.op == M_RANGE) return m.key < m.last && m.last <= IDX_BASE;
        if (m.op == M_RUN_ADD)
            return m.npages >= 1 && m.page0 >= 2 && (u64)m.page0 + m.npages <= 0xFFFFFFFFull && m.seq != 0;
        if (m.op == M_RUN_DEL) return m.page0 >= 2;
        if (m.op == M_SEG_DEL) return m.page0 >= 2 && m.seq != 0;
        return true;
    }
    // 范围墓碑落账：跟着这次提交一起落清单，版本 = 这次提交的版本。
    // 同一提交里"先 del_range 再 put"的键也会被盖住（同版本算作"墓碑更晚"），
    // 这条规则写在这里，免得以后自己猜。
    // commit() 在 rebalance/retire 之前调用它：被盖住的整条 run 在**本次**提交就能退休，
    // 否则要等下一次提交才发现（期间新 run 只能落在高水位之上，长删循环每轮白涨一条 run 的页）。
    // 提交：待落清单的范围墓碑写进增量（账先结清）
    void apply_ranges(std::vector<ManEnt>& delta) {
        if (pend_ranges_.empty()) return;
        settle_ranges();
        for (auto& pr : pend_ranges_) {
            ManEnt m;
            m.op = M_RANGE; m.key = pr.lo; m.last = pr.hi; m.ver = pr.ver;   // 版本 = 发出时刻（坑 75），不是提交时刻
            delta.push_back(m);
            add_tomb(pr.lo, pr.hi, pr.ver);         // del_range 时已登记过：这里是幂等的
        }
        pend_ranges_.clear();
    }
    // 结算范围墓碑的存活账。墓碑在 del_range 时就已生效（坑 76），但存活账**攒到**提交 / verify 时一起结：
    // 一条条结是 O(墓碑 × 单元) 的重算（5000 条实测 66 → 496 ms），攒着结每个单元只算一次。
    // 在这之前 c->live 对这些单元偏大 —— 只影响压缩的脏度判断，不影响可见性。
    void settle_ranges() {
        std::map<Cell*, u32> affected_cells;        // 被范围墓碑盖住的单元（每个只重算一次）→ 整个盖住它的墓碑的最大版本（0 = 没被整个盖住）
        for (auto& pr : pend_ranges_) {
            if (pr.acct) continue;
            pr.acct = true;
            const std::pair<u64, u64> r{pr.lo, pr.hi};
            const u32 rv = pr.ver;
            // 范围墓碑会让一批记录"变成不可见"，但一个字节都没重写 ⇒ 存活账必须重算，
            // 否则 c->live 与 verify 的口径立刻分家（`live mismatch`），
            // 而且这些单元永远不会被认为有垃圾。
            // 注意先收集再重算：5000 个墓碑 × 几十个单元逐个 recount 会变成 O(n²)
            //（实测 66 ms → 496 ms），而每个单元重算一次就够。
            auto cit = cells_.upper_bound(r.first);
            if (cit != cells_.begin()) --cit;
            for (; cit != cells_.end() && cit->second->lo < r.second; ++cit) {
                Cell* c = cit->second;
                if (c->hi <= r.first) continue;
                const u32 full = (r.first <= c->lo && c->hi <= r.second) ? rv : 0;
                auto ins = affected_cells.emplace(c, full);
                if (!ins.second) ins.first->second = std::max(ins.first->second, full);
            }
        }
        // 被单条墓碑**整个**盖住、且单元里每条 run 的版本都 < 墓碑版本的单元：
        // 全部被盖 ⇒ live=0、dead=全部字节，O(段数) 落账，一页都不读。
        // 只有被墓碑边界切开的（每条墓碑最多两个）才真归并一遍。
        // 没有这条快路径时，删半库 = 把半库的页全部读一遍（100k 条实测 3.8 ms；400 MB 的库就是几百 ms）。
        for (auto& ac : affected_cells) {
            Cell* c = ac.first;
            bool fast = ac.second != 0;
            // 坑 75 之后墓碑版本可能 <= 本次 flush 的 run 版本（del_range 之后同批的写），
            // 这种段里还有活记录 ⇒ 不能走“全死”快路径。
            if (fast) for (auto& sg : c->segs) {
                RunPtr r = runs_[sg.second.rid];
                if (r && r->ver >= ac.second) { fast = false; break; }
            }
            if (!fast) { if (c->acct) recount(c); continue; }   // 未知单元留给补算（补算时墓碑已生效）
            set_known(c);
            for (auto& sg : c->segs) seg_set_live(sg.second, 0);
            c->live = 0;
            c->dead = total_rec_bytes(c);
            c->pages = 0;
            for (auto& sg : c->segs) c->pages += sg.second.p1 - sg.second.p0;
        }
    }
    RC commit_delta(const std::vector<ManEnt>& delta0, bool with_ranges = true) {
        // 坑 68：commit(false) 异步刷出的 run 只在内存里挂着，它的 M_RUN_ADD 暂存在 pend_delta_。
        // 以前只有 durable commit() 会把 pend_delta_ 并入清单；consolidate / relocate / checkpoint /
        // 层合并直接走这里，会先把那条 run **合并掉（DEL 入账）**，下一次 commit() 才把过期的 ADD
        // 追加进去 ⇒ 重放时复活一条指向已释放页的僵尸 run（s2 长跑：回退 CORRUPT、库被清空）。
        // 规则：任何提交点都必须先把"已落页、未入账"的 run 入账，再记引用它们的后续项。
        std::vector<ManEnt> delta;
        delta.reserve(pend_delta_.size() + delta0.size());
        delta.insert(delta.end(), pend_delta_.begin(), pend_delta_.end());
        delta.insert(delta.end(), delta0.begin(), delta0.end());
        pend_delta_.clear();                        // 进了 pend_ 就只剩一份账
        if (with_ranges) apply_ranges(delta);       // consolidate/relocate 直接进来时也得落账（commit() 里已是空操作）
        for (auto& m : delta) {
#ifdef FCS_TRACE
            if (!man_ok(m))
                std::fprintf(stderr, "  BAD DELTA op=%u rid=%u npg=%u\n", (unsigned)m.op, m.page0, m.npages);
#endif
            tr(TR_MAN, m.page0, m.npages, m.ver, m.op);
            pend_.push_back(m);
        }
#ifdef FCS_TRACE
        std::fprintf(stderr, "  CD delta=%zu pend=%zu nman=%u\n", delta.size(), pend_.size(), nman_);
#endif
        // P5：快照期也写全量清单（以前 nsnap_ == 0 才写 ⇒ 长快照期间链无限长，回退/重开的重放随之变慢）。
        // 老链页走 free_pages ⇒ deferred_，回退点自己的链原样留着。
        if (nman_ + 1 > MAN_SNAP_AT && pend_.size() > INLINE_MAX) {
            RC rc = write_man_snapshot();        // 全量快照已包含 pend_ 的效果
            if (rc != RC::OK) return rc;
            pend_.clear();
            vers_ = open_vers();
            return write_sb();
        }
        while (pend_.size() > INLINE_MAX) {
            std::vector<ManEnt> batch(pend_.begin(), pend_.begin() + INLINE_MAX);
            RC rc = write_man_page(batch);
            if (rc != RC::OK) return rc;
            pend_.erase(pend_.begin(), pend_.begin() + INLINE_MAX);
        }
        vers_ = open_vers();
        return write_sb();
    }

    RC write_man_page(const std::vector<ManEnt>& ents) {
        u32 pid = 0;
        RC rc = alloc_man_page(pid);
        if (rc != RC::OK) return rc;
        std::vector<u8> buf(PAGE, 0);
        u32 n = (u32)std::min<size_t>(MAN_PER_PG, ents.size());
        wr32(buf.data(), PK_MAN);
        for (u32 i = 0; i < n; ++i) encode_man(buf.data() + MHDR + (size_t)i * MENT, ents[i]);
        wr32(buf.data() + 4, man_last_);              // prev：页写一次，永不回改
        wr32(buf.data() + 8, n);
        wr32(buf.data() + 12, crc32c(buf.data() + MHDR, n * MENT));
        u32 used = MHDR + n * MENT;
        if (dev_->write((PageId)pid, 0, buf.data(), used) != RC::OK) return RC::IO;
        inval(pid, 1); wr_man_ += used;
        if (man_first_ == NIL) man_first_ = pid;
        man_last_ = pid;
        ++nman_;
        return RC::OK;
    }


    RC write_man_snapshot() {
        std::vector<ManEnt> all;
        for (auto& kv : cells_) {
            if (kv.second->lo == 0) continue;
            ManEnt m;
            m.op = M_SPLIT_ADD;
            m.key = kv.second->lo;
            all.push_back(m);
        }
        for (auto& kv : runs_) {
            all.push_back(run_ent(kv.second, M_RUN_ADD));
        }
        for (auto& kv : ranges_) {
            ManEnt m;
            m.op = M_RANGE; m.key = kv.second.lo; m.last = kv.second.hi; m.ver = kv.second.ver;
            all.push_back(m);
        }
        std::vector<u32> old;
        if (man_last_ != NIL) {
            u32 pid = man_last_;
            for (u32 i = 0; i < nman_ && pid != NIL; ++i) {
                const u8* p = page(pid);
                u32 prev = p ? rd32(p + 4) : (u32)NIL;
                old.push_back(pid);
                pid = prev;
            }
        }
        nman_ = 0;
        size_t idx = 0;
        u32 head = NIL;
        do {
            u32 pid = 0;
            RC rc = alloc_man_page(pid);
            if (rc != RC::OK) return rc;
            u8 buf[PAGE];
            std::memset(buf, 0, PAGE);
            wr32(buf, PK_MAN);
            u32 n = (u32)std::min<size_t>(MAN_PER_PG, all.size() - idx);
            for (u32 i = 0; i < n; ++i) encode_man(buf + MHDR + i * MENT, all[idx + i]);
            wr32(buf + 4, idx == 0 ? (u32)NIL : head);
            wr32(buf + 8, n);
            wr32(buf + 12, crc32c(buf + MHDR, n * MENT));
            u32 used = MHDR + n * MENT;
            if (dev_->write((PageId)pid, 0, buf, used) != RC::OK) return RC::IO;
            inval(pid, 1); wr_man_ += used;
            head = pid;
            idx += n;
            ++nman_;
        } while (idx < all.size());
        if (nman_ == 0) nman_ = 1;
        man_first_ = head;
        man_last_ = head;
        for (u32 p : old) {                      // 新链已落盘，旧链可回收；快照期分配的那些不必 deferred
            const bool safe = man_new_.erase(p) > 0;
            free_pages(p, 1, safe);
        }
        // 全量快照已经包含了 pend_ 的全部效果。这里必须清掉再写 SB：
        // SB 里的内联增量是在清单链**之后**被应用的，留着会被重放一次
        //（M_RUN_ADD 重放无害，但 M_RANGE 会"复活"已经清掉的墓碑）。
        pend_.clear();
        pend_delta_.clear();                      // 全量快照来自内存 runs_，后台刷出的 run 已在其中
        vers_ = open_vers();
        return write_sb();
    }

    // ------------------------------------------------------------ 读路径完整性
    // 页 CRC 平时只在 verify() 里算（读路径每页加一次 CRC 比点查本身还贵，见 §13.4）。
    // scrub() 把这件事搬到"空闲时"：顺序扫所有活页，逐页校验，把静默位翻转找出来。
    //
    // 它**不修**任何东西：单副本没有冗余可修。它的价值是"在错误传播之前发现"——
    // 位翻转会让页内解码跑飞（键乱序/长度离谱），越晚发现越难定位。
    // 返回值：RC::OK = 全干净；RC::CORRUPT = 找到坏页（bad 里是坏页数，first 是第一页页号）。
    RC scrub_impl(u32* bad, u32* first, u64 budget_bytes) {
        if (RC r = ensure_ready(); r != RC::OK) return r;
        if (!wait_io()) return RC::TIMEOUT;       // 裸读设备：在飞的异步页必须先落地，否则把半页/旧页当坏页
        u32 nbad = 0, nfirst = NIL;
        u64 seen = 0;
        // 直接读设备、**绕过页缓存**：scrub 要验的是介质上的字节，
        // 走缓存等于检查自己的副本（缓存里的页本来就是刚写进去的）。
        std::vector<u8> buf(PAGE);
        auto check_data = [&](u32 pid) {
            if (budget_bytes && seen >= budget_bytes) return;
            seen += PAGE;
            if (dev_->read((PageId)pid, 0, buf.data(), PAGE) != RC::OK) { if (!nbad++) nfirst = pid; return; }
            const u8* p = buf.data();
            if (rd32(p) != PK_DATA) { if (!nbad++) nfirst = pid; return; }
            u16 used = rd16(p + 34);
            if (used < DHDR || used > PAGE) { if (!nbad++) nfirst = pid; return; }
            if (crc32c(p + 12, (size_t)(used - 12)) != rd32(p + 8)) { if (!nbad++) nfirst = pid; }
        };
        auto check_meta = [&](u32 pid) {
            if (budget_bytes && seen >= budget_bytes) return;
            seen += PAGE;
            if (dev_->read((PageId)pid, 0, buf.data(), PAGE) != RC::OK) return;
            const u8* p = buf.data();
            if (rd32(p) != PK_RMETA) return;                 // 这页本来就不是 meta：不算坏
            u32 n = rd32(p + 16);
            if (n > PAGE - RM_PHDR || crc32c(p + RM_PHDR, n) != rd32(p + 12)) { if (!nbad++) nfirst = pid; }
        };
        for (auto& kv : runs_) {
            RunPtr r = kv.second;
            for (u32 i = 0; i < r->npages; ++i) check_data(r->page0 + i);
            for (u32 i = 0; i < r->mnpg; ++i) check_meta(r->page0 + r->npages + i);
            // 溢出链：链页的页头有结构校验，载荷靠描述符里的 crc（见 read_ovfl）
            if (r->novfl) {
                ensure_ovfl_loc(r);
                for (auto& e : r->ovfl_loc) {
                    const u8* p = page(e.first);       // 描述符在数据页上（数据页已经查过 CRC）
                    if (!p) continue;
                    OvflDesc d = desc_of(pg_val_at(p, e.second));
                    if (budget_bytes && seen >= budget_bytes) break;
                    seen += (u64)d.npages * PAGE;
                    std::vector<u8> tmp(d.total ? d.total : 1);
                    if (read_ovfl(d, tmp.data(), (u32)tmp.size(), nullptr, false) != RC::OK) {   // scrub 必须读介质
                        if (!nbad++) nfirst = d.pg0;
                    }
                }
            }
        }
        if (bad) *bad = nbad;
        if (first) *first = nfirst;
        return nbad ? RC::CORRUPT : RC::OK;
    }

    void verr(Report& r, const char* msg, u64 key = 0) {
        if (r.errors++ == 0) { r.first_err = msg; r.first_key = key; }
    }

    // ------------------------------------------------------------ 状态
    BlockDev* dev_ = nullptr;
    u32 cap_ = 0;                 // 逻辑容量（= 设备上限，缩过也能长回来）
    u32 dev_pages_ = 0;           // 设备当前物理长度（页）
    u32 sb_slot_ = 1;             // 上一次 SB 落在哪个槽（0/1）；下一次写另一个（坑 83）
    std::unique_ptr<CacheEnt[]> cache_;   // 2 路 × cache_n_/2 组
    std::unique_ptr<CSet[]> sets_;
    u32 cache_n_ = 0;
    u64 wr_flush_ = 0, wr_compact_ = 0, wr_man_ = 0, wr_merge_ = 0;
    u32 next_seq_ = 0x40000000u;  // 新写入段：向上
    u32 low_seq_ = 0x3FFFFFFFu;
#ifdef FCS_TRACE
    u64 n_retired_ = 0;
#endif   // 压实产物：向下 ⇒ 永远排在栈底，且全局唯一
    u32 dead_added_ = 0;       // 本提交新产生的垃圾字节

    std::map<u64, Cell*> cells_;
    std::map<u32, RunPtr> runs_;
    MemTable mem_;
    // 内存表的键序视图（游标归并用）：按 mem_ 的代号缓存 —— 没有写入就不重排；
    // 写/查交错的负载每次 select 要重排一遍（n log n），这是“内存表不维护键序”换来的代价（见 §10.15）。
    // 增量维护：条目数组只会追加（覆盖写/墓碑化只改值，键和下标都不动；clear 之后长度归零 ⇒ 全量重排），
    // 所以"上次排好的前缀"永远有效，只需把新追加的一段排好再 inplace_merge 进去 —— O(n + d log d)。
    // 实测 100k 条内存表、写/查交错：全量重排 6.1 ms/次 → 增量 0.3 ms/次。
    std::vector<std::pair<u64, u32>> mem_sorted_;
    u64 mem_sorted_gen_ = 0, mem_sorted_epoch_ = 0;
    size_t mem_sorted_n_ = 0;      // 排好序的那一段覆盖到 ents_ 的哪个下标
    const std::vector<std::pair<u64, u32>>& mem_sorted() {
        // 共享模式下多个读者可能同时发现视图过期：建视图串行化；建好的视图直到写者下一次改 mem_（独占）之前不变，
        // 返回的引用在锁外读是安全的。
        std::lock_guard<std::mutex> g(msort_mu_);
        if (mem_sorted_gen_ == mem_.gen()) return mem_sorted_;
        const auto& es = mem_.entries();
        if (mem_sorted_epoch_ == mem_.epoch() && es.size() >= mem_sorted_n_ && mem_sorted_.size() == mem_sorted_n_) {
            const size_t old = mem_sorted_.size();
            for (u32 i = (u32)mem_sorted_n_; i < es.size(); ++i) mem_sorted_.emplace_back(es[i].key, i);
            std::sort(mem_sorted_.begin() + (std::ptrdiff_t)old, mem_sorted_.end());
            std::inplace_merge(mem_sorted_.begin(), mem_sorted_.begin() + (std::ptrdiff_t)old, mem_sorted_.end());
        } else {
            mem_sorted_.clear();
            mem_sorted_.reserve(es.size());
            for (u32 i = 0; i < es.size(); ++i) mem_sorted_.emplace_back(es[i].key, i);
            std::sort(mem_sorted_.begin(), mem_sorted_.end());
        }
        mem_sorted_n_ = es.size();
        mem_sorted_gen_ = mem_.gen();
        mem_sorted_epoch_ = mem_.epoch();
        return mem_sorted_;
    }

    // 坑 102（第 12 轮全量评估时发现）：这里以前是 xdb::Vers = uint16_t，每次逻辑提交 ++ 而没有任何回绕处理；
    //   第 65536 次 commit(false)/commit() 之后 vers_ 回到 0。盘上（SB.vers / 清单 ver / 页头 ver）一直是 32 位，
    //   只有内存里的时钟是 16 位 ⇒ 跨回绕持有的快照看见"未来"的写（视图隔离破）、verify 报 "future ver"、
    //   快照钉住所有新 run（8 → 29 条）。修法：引擎内版本一律 u32（API 的 view 参数同步放宽，不改格式；bench/probe/verswrap.cpp、g12）。
    u32 vers_ = 0;
    u32 tail_ = 2;
    u32 man_first_ = NIL, man_last_ = NIL, nman_ = 0;
    struct Snap {
        u32 vers = 0; u32 tail = 0, man_last = 0, nman = 0, man_first = 0;
        std::vector<ManEnt> pend;      // 快照时刻超级块里的联增量（按内容还原，不用下标）
        // 回收账也要一起回到快照点：这两个表里装的是“还没归位”的页，
        // 不还原就会在回退后被 promote 到空闲表 —— 那些页属于被回退掉的分支，
        // 于是同一页会被分配两次（随机坏清单项/数据错乱的第二个来源）。
        std::vector<std::pair<u32, u32>> pending_free, deferred;
    };
    Snap snaps_[MAX_SNAP];
    u32 nsnap_ = 0;
    u32 gpend_ = 0;
    Cursor scr_;                 // 扫描游标池（复用缓冲）
    bool async_ = false;
    u32 async_min_ = 65536;              // 非持久提交：攒够这么多条…
    u32 async_bytes_min_ = 4u << 20;     // …或这么多字节，才后台落一段（4 MB 写缓冲）
    mutable u64 mem_hw_ = 0;
    u64 mem_bytes_ = 0;
    u64 io_seen_ = 0;
    u32 io_timeout_ms_ = 0;      // 有界等待（0 = 不限；默认不限，测试/真机按需打开）
    u64 io_timeout_ = 0;         // 超时次数（可观测）
    std::atomic<bool> dirty_{false};   // 上一次提交失败：内存账待按盘重建（读入口在锁外先看一眼，故原子）
    bool io_stalled_ = false;    // 有等待超时过：队列排空之前，等待一律快失败
    u32 bad_man_ = 0;            // 挂载时丢弃的坏清单项（0 = 健康）
    std::vector<std::thread> io_;
    u32 io_threads_ = 1;
    std::mutex io_mu_;
    std::condition_variable io_cv_;
    std::deque<IoJob> q_;
    std::set<u32> hang_;         // 正在被后台写的页
    std::atomic<u32> inflight_{0};   // 读侧 wait_page 的快速路径在 io_mu_ 之外看它：原子 + acquire，与 worker 的递减配对
    bool stop_io_ = false;
    u64 io_done_ = 0, io_err_ = 0;
    std::atomic<bool> scr_busy_{false};
    std::atomic<u64> meta_hits_{0};   // 挂载时凭 meta 页免扫的 run 数（统计/基准用；共享模式下两个读者可能同时各装一条 run）
    // ---- 多写者（同一进程内）
    // 以前所有公开入口都假定"单线程独占"：put/commit 会改 mem_、runs_、cells_、free_，
    // 两个线程同时进来就是无声的数据竞争。这里用一把递归锁把**公开入口**串起来。
    // 读也上锁：读路径会改页缓存（tick/hits）并可能触发 ensure_ready()→reload()。
    // 代价（实测 set_io_timeout_ms 那段基准）：点查 296 → 310 ns（+5%）。
    XLock xl_;                       // P1：写独占（可重入）/ 读共享
    bool shared_reads_ = false;      // set_shared_reads()
    std::unique_ptr<Tls[]> tls_;     // MAX_TLS 个线程槽 + 1 个公共槽
    struct RangeTomb { u64 lo = 0, hi = 0, maxhi = 0; u32 ver = 0; };   // maxhi = 前缀最大 hi
    // 键 = (lo, ver)。**不能**只用 lo：同一 lo 的第二条（更窄的）墓碑会把第一条顶掉，
    // 被第一条盖住、第二条没盖到的记录就复活了（坑 62：del_range(10,90) 再 del_range(10,20)
    // ⇒ 20..89 重新可见，重开也一样，因为清单重放走的是同一段代码）。
    mutable std::map<std::pair<u64, u32>, RangeTomb> ranges_;   // (lo, ver) -> 墓碑；顺序 = lo 升序
    std::set<u32> man_new_;          // 快照期分配、尚未进入任何回退点链的清单页（P5）
    mutable std::atomic<bool> maxhi_dirty_{false};   // 前缀最大 hi 待重算（批量插入只算一次）
    mutable std::mutex maxhi_mu_;
    std::mutex msort_mu_;            // mem_sorted() 建视图
    std::mutex ovc_mu_;              // 溢出值缓存（读者会改它：LRU/准入/插入）
    struct PendRange { u64 lo = 0, hi = 0; u32 ver = 0; bool acct = false; };   // acct：存活账已结
    std::vector<PendRange> pend_ranges_;              // 本次提交待落清单的范围删除（已登记进 ranges_，版本 = 发出时刻）
    std::set<u32> take_set_;                          // 本次合并里"一定会被销毁"的 run（可以放心接管链）
    // R2b（第 12 轮）：分步层合并作业。一组 run 的归并拆成若干片（每片 ≤ merge_budget_ 源页），片与片之间放锁；
    // **产物只有一条**（RunWriter 跨片存活、页缓冲在内存里），源 run 在产物落地前一直挂着 ⇒ 读者始终看到
    // 一致的旧状态，不存在"同 seq 的片产物与半截源 run 并存"的问题（那条路试过：产物 run 数按片数膨胀、
    // 悬空副本以同 seq 复活）。作业跨提交点存在；任何让源 run 失效的事（退休 / 被别的维护合掉 / 快照钉住 /
    // 回退 / 重建）都让作业作废（丢掉的只是内存里的半成品）。
    struct MergeJob {
        std::vector<std::pair<u32, u32>> src;         // (page0, seq)：按 page0 查、用 seq 验身份（页号会复用）
        u32 newlvl = 0, maxseq = 0;
        u32 out_ver = 0;
        u64 kmin = ~0ull, kmax = 0, minkey = ~0ull;
        u64 next_lo = 0;                              // 下一片从这个键开始
        bool done = false;
        std::unique_ptr<RunWriter> w;
        std::vector<std::pair<u32, std::array<u8, 16>>> took;   // (源 page0, 描述符)：产物落地后才转移链的所有权
        struct Cand { u64 k; u32 osz; };
        std::vector<Cand> chk;                        // 可能被更新 run 盖住的记录：落地后精确确认（run 级存活字节）
        u64 lb = 0, moved = 0, dropped_tombs = 0;
        u32 slices = 0;
    };
    std::unique_ptr<MergeJob> job_;
    bool maint_sync_pending_ = false;                 // 提交后维护写了 run：放锁后由维护线程自己 wait_io + sync
    bool job_has(u32 rid) const {
        if (!job_) return false;
        for (auto& e : job_->src) if (e.first == rid) return true;
        return false;
    }
    void abandon_job() {
        if (!job_) return;
        if (job_->w) job_->w->abandon();              // 自有的溢出链还回去；接管的链所有权从未转移
        take_set_.clear();
        job_.reset();
    }
    u32 take_limit_ = NIL;                            // 链末页 > 此值 ⇒ 不接管而物化（只在 compact_file 第二遍设）
    bool man_high_ = false;                           // compact_file 期间：清单页取最高 run 块之上的第一个空闲页（见 alloc_man_page）
    std::vector<TraceEv> tr_;                         // 追踪环（A4），首次使用时分配 4096 条
    u64 tr_seq_ = 0;
    void tr(u16 kind, u32 a = 0, u32 b = 0, u32 c = 0, u16 aux = 0) {
        if (tr_.empty()) tr_.resize(4096);
        TraceEv& e = tr_[tr_seq_ % tr_.size()];
        e.kind = kind; e.aux = aux; e.a = a; e.b = b; e.c = c; e.seq = tr_seq_++;
    }
    u64 wr_gen_ = 0;             // 每次 put/del 递增：哪些写已经"进过 mem_"
    u64 durable_gen_ = 0;        // 上一个成功提交点覆盖到的 wr_gen_
    u64 commits_merged_ = 0;     // 因为别人的提交已经覆盖了我的写而直接返回的次数
    u32 rmeta_mode_ = 1;         // 见 set_rmeta_mode()
    bool ovfl_ok_ = true;        // 允许 > INLINE_VAL_MAX 的值走溢出页
    bool ovfl_take_ = true;      // 归并时接管溢出链（见 set_ovfl_take）
    bool pf_ok_ = true;          // 扫描预取开关（见 set_prefetch）
    u32 rmeta_min_ = FCS_RMETA_MIN_PAGES;
    bool keyidx_ = false;        // 是否维护精确键索引（RAM 换读放大）
    std::map<u32, u32> free_;      // 起始页 → 页数（按地址有序：低地址优先分配）
    std::vector<std::pair<u32, u32>> deferred_;
    std::vector<std::pair<u32, u32>> pending_free_;
    std::vector<ManEnt> pend_;                      // 尚未落清单页的增量（内联于 SB）
    std::vector<ManEnt> pend_delta_;                // 异步：已写页、未落提交点的 run
    std::vector<std::pair<u64, u64>> segdels_;      // 重放期的段删除 (单元 lo, seg_key)
    Report last_rep_;
};

} // namespace fcs
